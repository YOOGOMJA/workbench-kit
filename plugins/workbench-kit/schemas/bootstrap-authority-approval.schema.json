{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YOOGOMJA/workbench-kit/schemas/workbench-bootstrap-authority-approval-v1",
  "title": "Workbench bootstrap authority approval v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "approval_id",
    "proposed_descriptor",
    "default_revision",
    "protection",
    "actor",
    "approved_at",
    "source_ref"
  ],
  "properties": {
    "contract_version": { "const": "workbench-bootstrap-authority-approval/v1" },
    "approval_id": { "$ref": "#/$defs/printableAscii" },
    "proposed_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "authority_identity",
        "origin_url",
        "default_ref",
        "workspace_home",
        "hosting_adapter",
        "hosting_ref"
      ],
      "properties": {
        "contract_version": { "const": "workbench-workspace-authority/v1" },
        "authority_identity": { "$ref": "#/$defs/printableAscii" },
        "origin_url": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.git$" },
        "default_ref": { "type": "string", "pattern": "^(?!.*//)(?!.*(?:^|/)\\.\\.(?:/|$))refs/heads/[A-Za-z0-9._/-]+$" },
        "workspace_home": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "not": { "pattern": "^[0-9]+$" }
        },
        "hosting_adapter": { "$ref": "#/$defs/printableAscii" },
        "hosting_ref": { "$ref": "#/$defs/printableAscii" }
      }
    },
    "default_revision": { "$ref": "#/$defs/oid" },
    "protection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "revision",
        "direct_task_actor_writes",
        "verified_at",
        "evidence_ref"
      ],
      "properties": {
        "ref": { "type": "string", "pattern": "^refs/heads/[A-Za-z0-9._/-]+$" },
        "revision": { "$ref": "#/$defs/oid" },
        "direct_task_actor_writes": { "const": "blocked" },
        "verified_at": { "$ref": "#/$defs/timestamp" },
        "evidence_ref": { "$ref": "#/$defs/printableAscii" }
      }
    },
    "actor": { "$ref": "#/$defs/printableAscii" },
    "approved_at": { "$ref": "#/$defs/timestamp" },
    "source_ref": { "$ref": "#/$defs/printableAscii" }
  },
  "$defs": {
    "oid": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "printableAscii": { "type": "string", "pattern": "^[\\u0020-\\u007E]+$" },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    }
  }
}
