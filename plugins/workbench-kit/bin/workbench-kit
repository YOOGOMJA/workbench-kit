#!/usr/bin/env bash
set -euo pipefail

ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
PYTHON="${WORKBENCH_KIT_PYTHON:-python3}"

if ! command -v "$PYTHON" >/dev/null 2>&1; then
  echo "workbench-kit: Python 3.9 or newer is required (command not found: $PYTHON)" >&2
  exit 1
fi
if ! "$PYTHON" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 9) else 1)'; then
  echo "workbench-kit: Python 3.9 or newer is required" >&2
  exit 1
fi

export WORKBENCH_KIT_PLUGIN_ROOT="$ROOT"
export PYTHONPATH="$ROOT/lib${PYTHONPATH:+:$PYTHONPATH}"
exec "$PYTHON" -B -c \
  'from workbench_kit_cli import main; raise SystemExit(main())' "$@"
