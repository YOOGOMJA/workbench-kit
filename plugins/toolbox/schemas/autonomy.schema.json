{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YOOGOMJA/workbench-kit/schemas/toolbox/autonomy-v1",
  "title": "Toolbox autonomy policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "default", "actions"],
  "properties": {
    "schema": { "const": "toolbox-autonomy/v1" },
    "default": { "enum": ["allow", "ask", "deny"] },
    "actions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
      },
      "additionalProperties": { "enum": ["allow", "ask", "deny"] }
    }
  }
}
