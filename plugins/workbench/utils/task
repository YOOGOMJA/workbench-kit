compute_writer_verification() {
  local root origin ledger file parsed operation_id claim_id owner stage remote row_file writer_row worktree satisfied
  local state_output effect_event effect_device effect_clone effect_state repo_rows valid incomplete bijection blocker
  local repo_name repo_branch repo_role
  local -a bijection_args
  WRITER_VERIFY_COUNT=0; WRITER_VERIFY_OPERATION_IDS=(); WRITER_VERIFY_CLAIM_IDS=()
  WRITER_VERIFY_OWNERS=(); WRITER_VERIFY_STAGES=(); WRITER_VERIFY_REMOTE=()
  WRITER_VERIFY_ROWS=(); WRITER_VERIFY_WORKTREES=(); WRITER_VERIFY_SATISFIED=()
  root="$CURRENT_ROOT"; origin="$(canonical_workspace_origin_url "$root")" || {
    add_blocker writer-claim-unreconciled "$CURRENT_CLAIM_ID"; return 1
  }
  ledger="$(mktemp "${TMPDIR:-/tmp}/workbench-writer-ledger.XXXXXX")"
  if ! writer_load_remote_ledger "$root" "$origin" "$ledger"; then
    rm -f "$ledger"; add_blocker writer-claim-unreconciled "$CURRENT_CLAIM_ID"; return 1
  fi
  bijection_args=(task-bijection --ledger-file "$ledger" --task-claim-id "$CURRENT_CLAIM_ID")
  for file in "$(writer_operation_dir)"/*.json; do
    [ -f "$file" ] && bijection_args+=(--operation-file "$file")
  done
  for file in "$(writer_row_dir)"/*.record; do
    [ -f "$file" ] && bijection_args+=(--writer-row-file "$file")
  done
  while IFS='|' read -r repo_name repo_branch repo_role; do
    repo_name="$(printf '%s' "$repo_name" | sed -E 's/^- *| *$//g')"
    repo_role="$(printf '%s' "$repo_role" | sed -E 's/^ +| +$//g')"
    [ "$repo_role" = work ] && [ -n "$repo_name" ] && bijection_args+=(--repo-owner "$repo_name")
  done <<< "$(repos_block)"
  if bijection="$(python3 "$(writer_helper)" "${bijection_args[@]}")"; then
    while IFS= read -r blocker; do
      [ -n "$blocker" ] && add_blocker writer-claim-unreconciled "$blocker"
    done <<< "$(printf '%s\n' "$bijection" | sed -n 's/^blocker=//p')"
  else
    add_blocker writer-claim-unreconciled "$CURRENT_CLAIM_ID"
  fi
  for file in "$(writer_operation_dir)"/*.json; do
    [ -f "$file" ] || continue
    parsed="$(python3 "$(writer_helper)" operation "$file" --format shell)" || {
      add_blocker writer-claim-unreconciled "$file"; continue
    }
    operation_id="$(printf '%s\n' "$parsed" | sed -n 's/^operation_id=//p')"
    claim_id="$(printf '%s\n' "$parsed" | sed -n 's/^claim_id=//p')"
    owner="$(printf '%s\n' "$parsed" | sed -n 's/^owner=//p')"
    stage="$(printf '%s\n' "$parsed" | sed -n 's/^stage=//p')"
    if state_output="$(python3 "$(writer_helper)" ledger-state "$ledger" \
      --operation-id "$operation_id" --claim-id "$claim_id" \
      --operation-file "$file" --format shell)"; then
      remote="$(printf '%s\n' "$state_output" | sed -n 's/^claim_state=//p')"
      effect_event="$(printf '%s\n' "$state_output" | sed -n 's/^effect_owner_event_id=//p')"
      effect_device="$(printf '%s\n' "$state_output" | sed -n 's/^effect_owner_device_id=//p')"
      effect_clone="$(printf '%s\n' "$state_output" | sed -n 's/^effect_owner_clone_id=//p')"
      effect_state="$(printf '%s\n' "$state_output" | sed -n 's/^effect_owner_state=//p')"
    else
      remote=invalid; effect_event=""; effect_device=""; effect_clone=""; effect_state=invalid
    fi
    writer_load_operation_final "$file" || {
      add_blocker writer-claim-unreconciled "$operation_id"; continue
    }
    WRITER_CLONE="$root/.codebases/$owner"
    WRITER_WORKTREE="$TASK_DIR/$WRITER_OPERATION_EXPECTED_PATH"
    row_file="$(writer_row_dir)/$owner.record"; writer_row=missing
    if writer_row_matches_final "$row_file"; then writer_row=matched
    elif [ -f "$row_file" ]; then writer_row=mismatched; fi
    worktree=missing
    if writer_worktree_matches_final; then worktree=matched
    elif [ -e "$WRITER_WORKTREE" ]; then worktree=mismatched; fi
    repo_rows="$(repos_block | grep -Fxc -- "- $owner | $WRITER_CODEBASE_BRANCH | work" || true)"
    satisfied=false; valid=true; incomplete=false
    [ "$WRITER_OPERATION_TASK_CLAIM_ID" = "$CURRENT_CLAIM_ID" ] \
      && [ "$WRITER_CODEBASE_BRANCH" = "$CURRENT_BRANCH" ] || valid=false
    case "$stage" in
      consumed)
        [ "$remote" = active ] && [ "$effect_state" = acquired ] \
          && [ -n "$effect_event" ] \
          && [ "$effect_device" = "$WRITER_DEVICE_ID" ] \
          && [ "$effect_clone" = "$WRITER_CLONE_ID" ] \
          && [ "$WRITER_OPERATION_EFFECT_OWNER_STATE" = acquired ] \
          && [ "$writer_row" = matched ] && [ "$worktree" = matched ] \
          && [ "$repo_rows" = 1 ] || valid=false
        ;;
      handoff-ready)
        [ "$remote" = active ] && [ "$effect_state" = released ] \
          && [ "$WRITER_OPERATION_EFFECT_OWNER_STATE" = released ] \
          && [ "$writer_row" = missing ] && [ "$worktree" = missing ] \
          && [ "$repo_rows" = 0 ] || valid=false
        ;;
      released)
        [ "$remote" = released ] && [ "$effect_state" != acquired ] \
          && [ "$writer_row" = missing ] && [ "$worktree" = missing ] \
          && [ "$repo_rows" = 0 ] || valid=false
        ;;
      cancelled)
        [ "$remote" = absent ] && [ -z "$effect_event" ] \
          && [ "$writer_row" = missing ] && [ "$worktree" = missing ] \
          && [ "$repo_rows" = 0 ] || valid=false
        ;;
      prepared|authorization-pending|remote-claimed|effect-owner-acquired|worktree-create-pending|worktree-ready|record-create-pending|record-ready|compensation-pending|release-pending)
        add_blocker writer-operation-incomplete "$operation_id"; valid=false; incomplete=true
        ;;
      *) valid=false ;;
    esac
    if [ "$valid" = true ]; then satisfied=true
    elif [ "$incomplete" = false ]; then
      add_blocker writer-claim-unreconciled "$operation_id"
    fi
    WRITER_VERIFY_OPERATION_IDS[$WRITER_VERIFY_COUNT]="$operation_id"
    WRITER_VERIFY_CLAIM_IDS[$WRITER_VERIFY_COUNT]="$claim_id"
    WRITER_VERIFY_OWNERS[$WRITER_VERIFY_COUNT]="$owner"
    WRITER_VERIFY_STAGES[$WRITER_VERIFY_COUNT]="$stage"
    WRITER_VERIFY_REMOTE[$WRITER_VERIFY_COUNT]="$remote"
    WRITER_VERIFY_ROWS[$WRITER_VERIFY_COUNT]="$writer_row"
    WRITER_VERIFY_WORKTREES[$WRITER_VERIFY_COUNT]="$worktree"
    WRITER_VERIFY_SATISFIED[$WRITER_VERIFY_COUNT]="$satisfied"
    WRITER_VERIFY_COUNT=$((WRITER_VERIFY_COUNT + 1))
  done
  rm -f "$ledger"
}

compute_verification() {
  local file required state id revision acceptance_ref acceptance_id acceptance_file evidence_file result stale
  VERIFY_BLOCKER_COUNT=0; VERIFY_CHECK_COUNT=0
  VERIFY_BLOCKER_CODES=(); VERIFY_BLOCKER_REFS=()
  WRITER_VERIFY_COUNT=0; WRITER_VERIFY_OPERATION_IDS=(); WRITER_VERIFY_CLAIM_IDS=()
  WRITER_VERIFY_OWNERS=(); WRITER_VERIFY_STAGES=(); WRITER_VERIFY_REMOTE=()
  WRITER_VERIFY_ROWS=(); WRITER_VERIFY_WORKTREES=(); WRITER_VERIFY_SATISFIED=()
  VERIFY_CHECK_IDS=(); VERIFY_CHECK_OWNERS=(); VERIFY_CHECK_DELIVERABLES=()
  VERIFY_CHECK_SUBJECT_REFS=(); VERIFY_CHECK_SUBJECT_REVISIONS=()
  VERIFY_CHECK_EVIDENCE=(); VERIFY_CHECK_RESULTS=(); VERIFY_CHECK_STALE=()
  if ! validate_tracked_v2_records; then
    add_blocker action-effect-unreconciled "$CURRENT_CLAIM_ID"
    VERIFY_REVISION=""
    return 0
  fi
  compute_writer_verification || true
  for file in "$(deliverable_dir)"/*.record; do
    [ -f "$file" ] || continue; [ "$(record_get "$file" required)" = true ] || continue
    id="$(record_get "$file" deliverable_id)"; revision="$(record_get "$file" revision)"; state="$(record_get "$file" state)"
    [ -n "$revision" ] || add_blocker missing-deliverable-revision "$id"
    case "$state" in
      accepted)
        acceptance_ref="$(record_get "$file" acceptance_ref)"
        if [ -z "$acceptance_ref" ]; then add_blocker missing-acceptance-receipt "$id"
        else
          acceptance_id="${acceptance_ref#workbench:acceptance/}"
          acceptance_file="$(acceptance_dir)/$acceptance_id.record"
          if ! acceptance_receipt_matches "$file" "$acceptance_file"; then
            add_blocker acceptance-authority-mismatch "$id"
          elif [ "$(record_get "$acceptance_file" authority_type)" = kernel-probe ] \
            && ! probe_kernel_deliverable "$file"; then
            add_blocker external-not-accepted "$id"
          fi
        fi
        ;;
      waived) [ -n "$(record_get "$file" authorization_ref)" ] || add_blocker unaccepted-deliverable "$id" ;;
      *) add_blocker unaccepted-deliverable "$id" ;;
    esac
  done
  for file in "$(required_check_dir)"/*.record; do
    [ -f "$file" ] || continue
    VERIFY_CHECK_IDS[$VERIFY_CHECK_COUNT]="$(record_get "$file" check_id)"
    VERIFY_CHECK_OWNERS[$VERIFY_CHECK_COUNT]="$(record_get "$file" owner)"
    VERIFY_CHECK_DELIVERABLES[$VERIFY_CHECK_COUNT]="$(record_get "$file" deliverable_id)"
    VERIFY_CHECK_SUBJECT_REFS[$VERIFY_CHECK_COUNT]="$(record_get "$file" subject_ref)"
    VERIFY_CHECK_SUBJECT_REVISIONS[$VERIFY_CHECK_COUNT]="$(current_subject_revision "${VERIFY_CHECK_SUBJECT_REFS[$VERIFY_CHECK_COUNT]}" || true)"
    state="$(record_get "$file" state)"; evidence_file="$(latest_evidence_for_check "$file")"
    if [ -n "$evidence_file" ]; then
      VERIFY_CHECK_EVIDENCE[$VERIFY_CHECK_COUNT]="$(record_get "$evidence_file" evidence_id)"
      result="$(record_get "$evidence_file" result)"; VERIFY_CHECK_RESULTS[$VERIFY_CHECK_COUNT]="$result"
      evidence_is_stale "$evidence_file" && stale=true || stale=false; VERIFY_CHECK_STALE[$VERIFY_CHECK_COUNT]="$stale"
    else
      VERIFY_CHECK_EVIDENCE[$VERIFY_CHECK_COUNT]=""; VERIFY_CHECK_RESULTS[$VERIFY_CHECK_COUNT]=""; VERIFY_CHECK_STALE[$VERIFY_CHECK_COUNT]=false
    fi
    if [ "$state" = required ]; then
      if [ -z "$evidence_file" ]; then add_blocker missing-evidence "${VERIFY_CHECK_IDS[$VERIFY_CHECK_COUNT]}"
      elif [ "$stale" = true ]; then add_blocker stale-evidence "${VERIFY_CHECK_IDS[$VERIFY_CHECK_COUNT]}"
      elif [ "$result" = failed ]; then add_blocker failed-evidence "${VERIFY_CHECK_IDS[$VERIFY_CHECK_COUNT]}"
      fi
    fi
    VERIFY_CHECK_COUNT=$((VERIFY_CHECK_COUNT + 1))
  done
  if printf '%s\n' "${VERIFY_BLOCKER_CODES[*]:-}" | grep -Eq 'writer-(operation-incomplete|claim-unreconciled)'; then
    VERIFY_REVISION=""
  else VERIFY_REVISION="$(task_revision_digest)"; fi
}

add_harvest_blockers() {
  local file
  harvest_is_sealed || add_blocker harvest-unsealed harvest
  for file in "$(harvest_dir)/candidates"/*.record; do
    [ -f "$file" ] || continue
    [ "$(record_get "$file" state)" = disposed ] \
      || add_blocker harvest-undisposed "$(record_get "$file" candidate_id)"
  done
}

print_verification_json() {
  local verified="$1" i
  printf '{"contract_version":"workbench-verification/v1","task_contract":"workbench-task/v2","revision":'
  json_nullable "$VERIFY_REVISION"; printf ',"verified":%s,"writer_operations":[' "$verified"
  for ((i=0; i<WRITER_VERIFY_COUNT; i++)); do
    [ "$i" -eq 0 ] || printf ','
    printf '{"operation_id":"%s","claim_id":"%s","owner":"%s","stage":"%s","remote_claim":"%s","writer_row":"%s","worktree":"%s","satisfied":%s}' \
      "${WRITER_VERIFY_OPERATION_IDS[$i]}" "${WRITER_VERIFY_CLAIM_IDS[$i]}" \
      "$(json_escape "${WRITER_VERIFY_OWNERS[$i]}")" "${WRITER_VERIFY_STAGES[$i]}" \
      "${WRITER_VERIFY_REMOTE[$i]}" "${WRITER_VERIFY_ROWS[$i]}" \
      "${WRITER_VERIFY_WORKTREES[$i]}" "${WRITER_VERIFY_SATISFIED[$i]}"
  done
  printf '],"required_checks":['
  for ((i=0; i<VERIFY_CHECK_COUNT; i++)); do
    [ "$i" -eq 0 ] || printf ','
    printf '{"check_id":"%s","owner":"%s","deliverable_id":' "$(json_escape "${VERIFY_CHECK_IDS[$i]}")" "$(json_escape "${VERIFY_CHECK_OWNERS[$i]}")"
    json_nullable "${VERIFY_CHECK_DELIVERABLES[$i]}"
    printf ',"subject_ref":"%s","subject_revision":' "$(json_escape "${VERIFY_CHECK_SUBJECT_REFS[$i]}")"
    json_nullable "${VERIFY_CHECK_SUBJECT_REVISIONS[$i]}"; printf ',"evidence_id":'; json_nullable "${VERIFY_CHECK_EVIDENCE[$i]}"
    printf ',"result":'; json_nullable "${VERIFY_CHECK_RESULTS[$i]}"; printf ',"stale":%s}' "${VERIFY_CHECK_STALE[$i]}"
  done
  printf '],"blockers":['
  for ((i=0; i<VERIFY_BLOCKER_COUNT; i++)); do
    [ "$i" -eq 0 ] || printf ','
    printf '{"code":"%s","ref":"%s"}' "${VERIFY_BLOCKER_CODES[$i]}" "$(json_escape "${VERIFY_BLOCKER_REFS[$i]}")"
  done
  printf ']}\n'
}

cmd_verify() {
  local format="" terminal=false outcome
  while [ $# -gt 0 ]; do case "$1" in --format) format="$2"; shift 2 ;; *) die "unknown option: $1" ;; esac; done
  [ "$format" = json ] || die "unsupported format: ${format:-none}"
  require_v2_task; current_task_identity
  if outcome="$(task_terminal_outcome "$CURRENT_ROOT" "$CURRENT_HOME" "$CURRENT_ISSUE" "$CURRENT_BRANCH" "$TASK_DIR")"; then
    terminal=true
  fi
  compute_verification
  if [ "$VERIFY_BLOCKER_COUNT" -gt 0 ]; then print_verification_json false; return 1; fi
  if [ "$terminal" = false ]; then
    lifecycle_emit "$CURRENT_ROOT" "$CURRENT_HOME" "$CURRENT_ISSUE" task-verified \
      "$CURRENT_CLAIM_ID" "$CURRENT_BRANCH" - "$VERIFY_REVISION"
  fi
  print_verification_json true
}

write_terminal_outcome() {
  local outcome="$1" action_instance_id="$2" intent_digest="$3" policy_manifest_digest="$4"
  local authorization_ref="$5" revision="$6" removal_plan_digest="${7:-}"
  local reason_code="${8:-}" reason_ref="${9:-}" dir file tmp
  dir="$(task_state_dir)"; mkdir -p "$dir"; file="$dir/terminal"; tmp="$file.tmp.$$"
  {
    printf 'outcome=%s\n' "$outcome"
    printf 'action_instance_id=%s\n' "$action_instance_id"
    printf 'intent_digest=%s\n' "$intent_digest"
    printf 'policy_manifest_digest=%s\n' "$policy_manifest_digest"
    printf 'authorization_ref=%s\n' "$authorization_ref"
    printf 'revision=%s\n' "$revision"
    printf 'removal_plan_digest=%s\n' "$removal_plan_digest"
    printf 'at=%s\n' "$(utc_now)"
    printf 'reason_code=%s\n' "$reason_code"
    printf 'reason_ref=%s\n' "$reason_ref"
  } > "$tmp" && mv "$tmp" "$file"
}

json_string_field() {
  local json="$1" key="$2"
  printf '%s\n' "$json" | sed -n "s/.*\"$key\":\"\([^\"]*\)\".*/\1/p" | head -1
}

task_target_ref() {
  local work_ref
  work_ref="$(index_get work_ref)"
  [ -n "$work_ref" ] && printf '%s\n' "$work_ref" || printf 'workbench:task/%s\n' "$CURRENT_CLAIM_ID"
}

print_outcome_json() {
  local outcome="$1" changed="$2" action_instance_id="$3" intent_digest="$4"
  local policy_manifest_digest="$5" authorization_ref="$6" revision="$7"
  local removal_plan_digest="$8" reason_code="$9" reason_ref="${10}" i
  printf '{"contract_version":"workbench-task-outcome/v1","task_contract":"workbench-task/v2","outcome":'
  json_nullable "$outcome"; printf ',"changed":%s,"action_instance_id":' "$changed"; json_nullable "$action_instance_id"
  printf ',"intent_digest":'; json_nullable "$intent_digest"
  printf ',"policy_manifest_digest":'; json_nullable "$policy_manifest_digest"
  printf ',"authorization_ref":'; json_nullable "$authorization_ref"
  printf ',"revision":'; json_nullable "$revision"
  printf ',"removal_plan_digest":'; json_nullable "$removal_plan_digest"
  printf ',"reason_code":'; json_nullable "$reason_code"
  printf ',"reason_ref":'; json_nullable "$reason_ref"; printf ',"blockers":['
  for ((i=0; i<VERIFY_BLOCKER_COUNT; i++)); do
    [ "$i" -eq 0 ] || printf ','
    printf '{"code":"%s","ref":"%s"}' "${VERIFY_BLOCKER_CODES[$i]}" "$(json_escape "${VERIFY_BLOCKER_REFS[$i]}")"
  done
  printf ']}\n'
}

resolve_governed_action() {
  local action_id="$1" target_ref="$2" revision="$3" instance_id="$4" authorization_file="$5"
  local payload_contract="${6:-}" payload_file="${7:-}" policy_util output rc request_file="" intent_digest=""
  policy_util="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/policy"
  [ -x "$policy_util" ] || die "policy resolver not installed: $policy_util"
  local args=(resolve --format json)
  if [ -n "$payload_contract" ]; then
    [ -f "$payload_file" ] || die "intent payload file not found: $payload_file"
    request_file="$(mktemp "${TMPDIR:-/tmp}/workbench-action-request.XXXXXX")"
    python3 "$(intent_helper)" build-request --action-id "$action_id" \
      --task-claim-id "$CURRENT_CLAIM_ID" --target-ref "$target_ref" --revision "$revision" \
      --payload-contract "$payload_contract" --payload-file "$payload_file" > "$request_file" \
      || { rm -f "$request_file"; die "invalid governed action intent"; }
    intent_digest="$(python3 "$(intent_helper)" request "$request_file" --format shell \
      | sed -n 's/^intent_digest=//p')"
    args+=(--request-file "$request_file" --intent-digest "$intent_digest")
  else
    args+=(--action-id "$action_id" --task-claim-id "$CURRENT_CLAIM_ID" \
      --target-ref "$target_ref" --revision "$revision")
  fi
  [ -z "$instance_id" ] || args+=(--action-instance-id "$instance_id")
  [ -z "$authorization_file" ] || args+=(--authorization-file "$authorization_file")
  if output="$(cd "$TASK_DIR" && \
    WORKBENCH_REQUIRE_EXPLICIT_AUTHORIZATION="${GOVERNED_REQUIRE_EXPLICIT_AUTHORIZATION:-0}" \
    WORKBENCH_ALLOW_ACTION_REPLACEMENT="${GOVERNED_ALLOW_ACTION_REPLACEMENT:-0}" \
    WORKBENCH_CONCURRENT_CONTEXTS_FILE="${WRITER_CONTEXT_UNION_FILE:-}" \
    "$policy_util" "${args[@]}")"; then rc=0; else rc=$?; fi
  rm -f "$request_file"
  GOVERNED_POLICY_OUTPUT="$output"; GOVERNED_POLICY_RC="$rc"
  GOVERNED_ACTION_INSTANCE_ID="$(json_string_field "$output" id)"
  GOVERNED_INTENT_DIGEST="$intent_digest"
}

consume_governed_action() {
  local action_id="$1" target_ref="$2" revision="$3" instance_id="$4"
  local intent_digest="${5:-}" primary_provenance_digest="${6:-}" policy_util
  policy_util="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/policy"
  local args=(consume --action-instance-id "$instance_id" --action-id "$action_id" \
    --task-claim-id "$CURRENT_CLAIM_ID" --target-ref "$target_ref" --revision "$revision")
  [ -z "$intent_digest" ] || args+=(--intent-digest "$intent_digest")
  [ -z "$primary_provenance_digest" ] \
    || args+=(--primary-provenance-digest "$primary_provenance_digest")
  (cd "$TASK_DIR" && WORKBENCH_INTERNAL=1 "$policy_util" "${args[@]}")
}

terminal_outcome_report() {
  local requested="$1" terminal_file existing revision action_id intent manifest authorization_ref
  local removal_plan reason_code reason_ref
  terminal_file="$(task_state_dir)/terminal"
  [ -f "$terminal_file" ] || return 1
  existing="$(record_get "$terminal_file" outcome)"; revision="$(record_get "$terminal_file" revision)"
  action_id="$(record_get "$terminal_file" action_instance_id)"; reason_code="$(record_get "$terminal_file" reason_code)"
  intent="$(record_get "$terminal_file" intent_digest)"; manifest="$(record_get "$terminal_file" policy_manifest_digest)"
  authorization_ref="$(record_get "$terminal_file" authorization_ref)"
  removal_plan="$(record_get "$terminal_file" removal_plan_digest)"
  reason_ref="$(record_get "$terminal_file" reason_ref)"
  VERIFY_BLOCKER_COUNT=0; VERIFY_BLOCKER_CODES=(); VERIFY_BLOCKER_REFS=()
  if ! terminal_lifecycle_matches; then
    add_blocker action-effect-unreconciled "${action_id:-$CURRENT_CLAIM_ID}"
    print_outcome_json "" false "" "" "" "" "$revision" "" "" ""
    return 2
  fi
  if [ "$existing" = "$requested" ]; then
    print_outcome_json "$existing" false "$action_id" "$intent" "$manifest" "$authorization_ref" \
      "$revision" "$removal_plan" "$reason_code" "$reason_ref"; return 0
  fi
  add_blocker terminal-outcome-conflict "$existing"
  print_outcome_json "" false "" "" "" "" "$revision" "" "" ""; return 2
}

cmd_complete() {
  local instance_id="" authorization_file="" format="" target revision terminal_rc terminal_pr="-"
  while [ $# -gt 0 ]; do
    case "$1" in --action-instance-id) instance_id="$2"; shift 2 ;; --authorization-file) authorization_file="$2"; shift 2 ;;
      --format) format="$2"; shift 2 ;; *) die "unknown option: $1" ;; esac
  done
  [ "$format" = json ] || die "unsupported format: ${format:-none}"
  require_v2_task; current_task_identity
  local recovery_rc
  if recover_terminal_effect completed "$instance_id"; then return 0
  else recovery_rc=$?; fi
  [ "$recovery_rc" = 10 ] || return "$recovery_rc"
  if terminal_outcome_report completed; then return 0; else terminal_rc=$?; [ "$terminal_rc" != 2 ] || return 1; fi
  if [ ! -f "$(task_state_dir)/policy-context/state.record" ]; then
    [ -z "$(index_get context_ref)" ] || {
      VERIFY_BLOCKER_COUNT=0; VERIFY_BLOCKER_CODES=(); VERIFY_BLOCKER_REFS=()
      add_blocker policy-context-unsealed "workbench:task/$CURRENT_CLAIM_ID"
      print_outcome_json "" false "" "" "" "" "" "" "" ""; return 1
    }
    create_auto_null_policy_context >/dev/null
  fi
  [ "$(record_get "$(task_state_dir)/policy-context/state.record" sealed)" = true ] || {
    VERIFY_BLOCKER_COUNT=0; VERIFY_BLOCKER_CODES=(); VERIFY_BLOCKER_REFS=()
    add_blocker policy-context-unsealed "workbench:task/$CURRENT_CLAIM_ID"
    print_outcome_json "" false "" "" "" "" "" "" "" ""; return 1
  }
  compute_verification; add_harvest_blockers; revision="$VERIFY_REVISION"
  if [ "$VERIFY_BLOCKER_COUNT" -gt 0 ]; then
    print_outcome_json "" false "" "" "" "" "$revision" "" "" ""; return 1
  fi
  target="$(task_target_ref)"
  local payload_file="$(mktemp "${TMPDIR:-/tmp}/workbench-complete-intent.XXXXXX")"
  python3 "$(intent_helper)" build-payload --contract workbench-task-complete-intent/v1 \
    --field outcome=completed --field "completion_snapshot=$revision" > "$payload_file" \
    || { rm -f "$payload_file"; die "invalid completion intent"; }
  resolve_governed_action task.complete "$target" "$revision" "$instance_id" "$authorization_file" \
    workbench-task-complete-intent/v1 "$payload_file"
  rm -f "$payload_file"
  case "$GOVERNED_POLICY_RC" in 0) ;; 3|4) printf '%s\n' "$GOVERNED_POLICY_OUTPUT"; return "$GOVERNED_POLICY_RC" ;; *) return "$GOVERNED_POLICY_RC" ;; esac
  [ "$(task_revision_digest)" = "$revision" ] || {
    add_blocker action-binding-stale task.complete
    print_outcome_json "" false "$GOVERNED_ACTION_INSTANCE_ID" "$GOVERNED_INTENT_DIGEST" \
      "" "" "$revision" "" "" ""; return 1
  }
  local action_file="$(task_state_dir)/actions/$GOVERNED_ACTION_INSTANCE_ID.record"
  local manifest_digest="$(record_get "$action_file" policy_manifest_digest)"
  local authorization_ref="$(record_get "$action_file" authorization_ref)"
  write_terminal_outcome completed "$GOVERNED_ACTION_INSTANCE_ID" "$GOVERNED_INTENT_DIGEST" \
    "$manifest_digest" "$authorization_ref" "$revision"
  [ "${SUBMISSION_RECOVERY_ACTIVE:-false}" != true ] \
    || terminal_pr="$SUBMISSION_RECOVERY_PR_NUMBER"
  if ! lifecycle_emit "$CURRENT_ROOT" "$CURRENT_HOME" "$CURRENT_ISSUE" task-completed \
    "$CURRENT_CLAIM_ID" "$CURRENT_BRANCH" "$terminal_pr" "$revision" "$GOVERNED_ACTION_INSTANCE_ID" \
    workbench-task/v2 "" "$GOVERNED_INTENT_DIGEST"; then
    return 1
  fi
  local primary_digest="$(digest_manifest "$(task_state_dir)/terminal")"
  consume_governed_action task.complete "$target" "$revision" "$GOVERNED_ACTION_INSTANCE_ID" \
    "$GOVERNED_INTENT_DIGEST" "$primary_digest"
  VERIFY_BLOCKER_COUNT=0
  print_outcome_json completed true "$GOVERNED_ACTION_INSTANCE_ID" "$GOVERNED_INTENT_DIGEST" \
    "$manifest_digest" "$authorization_ref" "$revision" "" "" ""
}

cmd_abandon() {
  local reason_code="" reason_ref="" instance_id="" authorization_file="" format="" target revision terminal_rc
  local recovery_rc payload_file frozen_plan action_file manifest_digest authorization_ref primary_digest terminal_pr="-"
  while [ $# -gt 0 ]; do
    case "$1" in
      --reason-code) reason_code="$2"; shift 2 ;;
      --reason-ref) reason_ref="$2"; shift 2 ;;
      --action-instance-id) instance_id="$2"; shift 2 ;;
      --authorization-file) authorization_file="$2"; shift 2 ;;
      --format) format="$2"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [ "$format" = json ] || die "unsupported format: ${format:-none}"; require_single_line reason_code "$reason_code"
  [ -z "$reason_ref" ] || require_single_line reason_ref "$reason_ref"
  require_v2_task; current_task_identity
  if recover_terminal_effect abandoned "$instance_id"; then return 0
  else recovery_rc=$?; fi
  [ "$recovery_rc" = 10 ] || return "$recovery_rc"
  if terminal_outcome_report abandoned; then return 0; else terminal_rc=$?; [ "$terminal_rc" != 2 ] || return 1; fi
  if [ ! -f "$(task_state_dir)/policy-context/state.record" ]; then
    [ -z "$(index_get context_ref)" ] || {
      VERIFY_BLOCKER_COUNT=0; VERIFY_BLOCKER_CODES=(); VERIFY_BLOCKER_REFS=()
      add_blocker policy-context-unsealed "workbench:task/$CURRENT_CLAIM_ID"
      print_outcome_json "" false "" "" "" "" "" "" "$reason_code" "$reason_ref"; return 1
    }
    create_auto_null_policy_context >/dev/null
  fi
  [ "$(record_get "$(task_state_dir)/policy-context/state.record" sealed)" = true ] || {
    VERIFY_BLOCKER_COUNT=0; VERIFY_BLOCKER_CODES=(); VERIFY_BLOCKER_REFS=()
    add_blocker policy-context-unsealed "workbench:task/$CURRENT_CLAIM_ID"
    print_outcome_json "" false "" "" "" "" "" "" "$reason_code" "$reason_ref"; return 1
  }
  VERIFY_BLOCKER_COUNT=0; VERIFY_BLOCKER_CODES=(); VERIFY_BLOCKER_REFS=()
  if ! build_abandonment_revision "$reason_code" "$reason_ref"; then
    add_blocker writer-claim-unreconciled "$CURRENT_CLAIM_ID"
    print_outcome_json "" false "" "" "" "" "" "" "$reason_code" "$reason_ref"; return 1
  fi
  revision="$TERMINAL_ABANDONMENT_REVISION"; frozen_plan="$TERMINAL_REMOVAL_PLAN_DIGEST"
  target="$(task_target_ref)"
  payload_file="$(mktemp "${TMPDIR:-/tmp}/workbench-abandon-intent.XXXXXX")"
  python3 "$(intent_helper)" build-payload --contract workbench-task-abandon-intent/v1 \
    --field outcome=abandoned --field "abandonment_revision=$revision" \
    --field "reason_code=$reason_code" --field "reason_ref=$(value_or_null "$reason_ref")" \
    > "$payload_file" || { rm -f "$payload_file"; die "invalid abandonment intent"; }
  resolve_governed_action task.abandon "$target" "$revision" "$instance_id" "$authorization_file" \
    workbench-task-abandon-intent/v1 "$payload_file"
  rm -f "$payload_file"
  case "$GOVERNED_POLICY_RC" in 0) ;; 3|4) printf '%s\n' "$GOVERNED_POLICY_OUTPUT"; return "$GOVERNED_POLICY_RC" ;; *) return "$GOVERNED_POLICY_RC" ;; esac
  if ! build_abandonment_revision "$reason_code" "$reason_ref" \
    || [ "$TERMINAL_ABANDONMENT_REVISION" != "$revision" ] \
    || [ "$TERMINAL_REMOVAL_PLAN_DIGEST" != "$frozen_plan" ]; then
    add_blocker action-binding-stale task.abandon
    print_outcome_json "" false "$GOVERNED_ACTION_INSTANCE_ID" "$GOVERNED_INTENT_DIGEST" \
      "" "" "$revision" "$frozen_plan" "$reason_code" "$reason_ref"; return 1
  fi
  action_file="$(task_state_dir)/actions/$GOVERNED_ACTION_INSTANCE_ID.record"
  manifest_digest="$(record_get "$action_file" policy_manifest_digest)"
  authorization_ref="$(record_get "$action_file" authorization_ref)"
  write_terminal_outcome abandoned "$GOVERNED_ACTION_INSTANCE_ID" "$GOVERNED_INTENT_DIGEST" \
    "$manifest_digest" "$authorization_ref" "$revision" "$frozen_plan" "$reason_code" "$reason_ref"
  [ "${SUBMISSION_RECOVERY_ACTIVE:-false}" != true ] \
    || terminal_pr="$SUBMISSION_RECOVERY_PR_NUMBER"
  if ! lifecycle_emit "$CURRENT_ROOT" "$CURRENT_HOME" "$CURRENT_ISSUE" task-abandoned \
    "$CURRENT_CLAIM_ID" "$CURRENT_BRANCH" "$terminal_pr" "$revision" "$GOVERNED_ACTION_INSTANCE_ID" \
    workbench-task/v2 "" "$GOVERNED_INTENT_DIGEST"; then
    return 1
  fi
  primary_digest="$(digest_manifest "$(task_state_dir)/terminal")"
  consume_governed_action task.abandon "$target" "$revision" "$GOVERNED_ACTION_INSTANCE_ID" \
    "$GOVERNED_INTENT_DIGEST" "$primary_digest"
  VERIFY_BLOCKER_COUNT=0
  print_outcome_json abandoned true "$GOVERNED_ACTION_INSTANCE_ID" "$GOVERNED_INTENT_DIGEST" \
    "$manifest_digest" "$authorization_ref" "$revision" "$frozen_plan" "$reason_code" "$reason_ref"
}

# ── done ──────────────────────────────────────────────────────────────

# 이 브랜치에 대응하는 머지된 PR이 origin에 있는가? squash 머지(=새 커밋)는
# git이 브랜치를 merged로 인식하지 못하므로, done이 안전 삭제 여부를 판단할 때
# 쓴다. origin/gh가 없으면(오프라인 등) 1을 반환해 --force 를 요구하게 한다.
branch_is_merged_pr() {
  local root="$1" branch="$2" out
  git -C "$root" remote get-url origin >/dev/null 2>&1 || return 1
  out="$( (cd "$root" && gh pr list --head "$branch" --state merged --json number -q '.[].number') 2>/dev/null )" || return 1
  [ -n "$out" ]
}

cmd_done_v1() {
  local id="" force="" parent=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1; shift ;;
      --parent) parent="$2"; shift 2 ;;
      *) id="$1"; shift ;;
    esac
  done
  [ -n "$id" ] || die "usage: workbench task done <ID> [--parent N] [--force]"
  parse_id "$id"
  local root branch dir
  root="$(wb_root)"
  branch="$(resolve_branch "$HOME_REPO" "$ISSUE" "$parent" "$id")" || exit 1
  dir="$root/.worktrees/$(branch_to_dir "$branch")"

  # codebase 작업 사본 먼저 정리 (디스크 기준 — index.md 는 cleanup으로 없을 수 있음)
  if [ -d "$dir" ]; then
    local wt common clone
    for wt in "$dir"/task/codebases/*/; do
      [ -d "$wt" ] || continue
      common="$(cd "$wt" && git rev-parse --git-common-dir)"
      clone="$(dirname "$(cd "$common" && pwd)")"
      info "codebase 작업 사본 제거: $wt"
      git -C "$clone" worktree remove ${force:+--force} "$wt" \
        || die "작업 사본에 커밋 안 된 변경 있음 — 정리 후 재시도하거나 --force"
    done
    info "task 작업 공간 제거: $dir"
    git -C "$root" worktree remove ${force:+--force} "$dir" \
      || die "task 작업 공간에 커밋 안 된 변경 있음 — push 후 재시도하거나 --force"
  fi

  # 브랜치 삭제 — 머지 안 된 로컬 작업을 조용히 날리지 않는다. 워크벤치는
  # squash 머지(=새 커밋)라 git은 task 브랜치를 merged로 못 본다(게다가 push된
  # 브랜치는 upstream이 자기 자신이라 `git branch -d`가 오판한다). 따라서
  # "머지된 PR이 있는가"로 판단하고, 없으면 --force 를 요구한다.
  if [ -n "$force" ]; then
    info "브랜치 강제 삭제: $branch (--force)"
    git -C "$root" branch -D "$branch" || die "브랜치 삭제 실패: $branch"
  elif branch_is_merged_pr "$root" "$branch"; then
    info "브랜치 삭제: $branch (머지된 PR 확인됨)"
    git -C "$root" branch -D "$branch" || die "브랜치 삭제 실패: $branch"
  else
    die "브랜치 '$branch' 에 머지되지 않은 로컬 커밋이 있고 머지된 PR도 찾지 못함 —
push 하거나 PR을 머지한 뒤 다시 실행하거나, 폐기해도 된다면 --force 로 실행할 것
(워크트리는 이미 제거됨; 로컬 브랜치와 커밋은 보존됨)"
  fi
  local claim_id; claim_id="$(lifecycle_claim_for_branch "$root" "$HOME_REPO" "$ISSUE" "$branch")"
  lifecycle_emit_optional "$root" "$HOME_REPO" "$ISSUE" task-cleaned "$claim_id" "$branch"
  if git -C "$root" remote get-url origin >/dev/null 2>&1; then
    echo "note: origin의 $branch 는 남아 있음 — PR 머지 시 GitHub이 지우거나, 직접: git push origin :$branch"
  fi
  echo "note: 티켓 처분(닫기/유지/후속)은 이 스크립트가 하지 않는다 — /task-done 절차가 묻는다"
  info "완료"
}

cleanup_add_blocker() {
  CLEANUP_BLOCKER_CODES[$CLEANUP_BLOCKER_COUNT]="$1"; CLEANUP_BLOCKER_REFS[$CLEANUP_BLOCKER_COUNT]="$2"
  CLEANUP_BLOCKER_COUNT=$((CLEANUP_BLOCKER_COUNT + 1))
}

print_cleanup_json() {
  local outcome="$1" changed="$2" action_id="$3" intent="$4" manifest="$5" authorization_ref="$6"
  local revision="$7" removal_plan_digest="$8" task_workspace="$9" local_branch="${10}" i
  printf '{"contract_version":"workbench-task-cleanup/v1","task_contract":"workbench-task/v2","task_id":"%s","claim_id":"%s","branch":"%s","outcome":' \
    "$(json_escape "$CLEANUP_TASK_ID")" "$(json_escape "$CLEANUP_CLAIM_ID")" "$(json_escape "$CLEANUP_BRANCH")"
  json_nullable "$outcome"; printf ',"changed":%s,"action_instance_id":' "$changed"; json_nullable "$action_id"
  printf ',"intent_digest":'; json_nullable "$intent"
  printf ',"policy_manifest_digest":'; json_nullable "$manifest"
  printf ',"authorization_ref":'; json_nullable "$authorization_ref"
  printf ',"revision":'; json_nullable "$revision"
  printf ',"removal_plan_digest":'; json_nullable "$removal_plan_digest"
  printf ',"released_writer_operations":['
  for ((i=0; i<CLEANUP_REMOVED_WRITER_COUNT; i++)); do
    [ "$i" -eq 0 ] || printf ','
    printf '{"operation_id":"%s","claim_id":"%s"}' \
      "$(json_escape "${CLEANUP_REMOVED_OPERATION_IDS[$i]}")" \
      "$(json_escape "${CLEANUP_REMOVED_WRITER_IDS[$i]}")"
  done
  printf '],"removed":{"task_workspace":%s,"codebase_worktrees":[' "$task_workspace"
  for ((i=0; i<CLEANUP_REMOVED_COUNT; i++)); do [ "$i" -eq 0 ] || printf ','; printf '"%s"' "$(json_escape "${CLEANUP_REMOVED_NAMES[$i]}")"; done
  printf '],"local_branch":%s},"blockers":[' "$local_branch"
  for ((i=0; i<CLEANUP_BLOCKER_COUNT; i++)); do [ "$i" -eq 0 ] || printf ','; printf '{"code":"%s","ref":"%s"}' \
    "${CLEANUP_BLOCKER_CODES[$i]}" "$(json_escape "${CLEANUP_BLOCKER_REFS[$i]}")"; done
  printf ']}\n'
}

cleanup_contract_helper() {
  printf '%s/../lib/workbench_cleanup.py\n' "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
}

cleanup_journal_latest() {
  local root="$1" home="$2" issue="$3" task_id="$4" branch="$5" expected_author="$6"
  local dir adapter origin observation output rc helper
  dir="$(lifecycle_issue_dir "$root" "$home")"
  [ -d "$dir" ] || return 2
  adapter="${WORKBENCH_TRUSTED_HOSTING_ADAPTER:-}"
  [ -n "$adapter" ] && [ -x "$adapter" ] || return 2
  origin="$(git -C "$dir" remote get-url origin 2>/dev/null)" || return 2
  observation="$(mktemp "${TMPDIR:-/tmp}/workbench-cleanup-observation.XXXXXX")"
  [ -z "${CLEANUP_JOURNAL_PROVENANCE_FILE:-}" ] \
    || rm -f "$CLEANUP_JOURNAL_PROVENANCE_FILE"
  CLEANUP_JOURNAL_PROVENANCE_FILE="$(mktemp \
    "${TMPDIR:-/tmp}/workbench-cleanup-provenance.XXXXXX")" || return 2
  if ! (cd "$dir" && "$adapter" lifecycle --repository "$dir" --issue "$issue" --format json) \
    > "$observation" 2>/dev/null; then
    rm -f "$observation"; return 2
  fi
  helper="$(cleanup_contract_helper)"
  if output="$(python3 "$helper" find-observation --observation-file "$observation" \
    --repository-origin-url "$origin" --issue "$issue" --task-id "$task_id" \
    --branch "$branch" --expected-author "$expected_author" \
    --provenance-file "$CLEANUP_JOURNAL_PROVENANCE_FILE" 2>/dev/null)"; then
    rm -f "$observation"; printf '%s\n' "$output"; return 0
  else
    rc=$?; rm -f "$observation" "$CLEANUP_JOURNAL_PROVENANCE_FILE"
    CLEANUP_JOURNAL_PROVENANCE_FILE=""
    [ "$rc" -eq 1 ] && return 1
    [ "$rc" -eq 3 ] && return 3
    return 2
  fi
}

cleanup_journal_emit() {
  local root="$1" home="$2" issue="$3" journal_file="$4" dir body_file stage branch helper
  dir="$(lifecycle_issue_dir "$root" "$home")"; [ -d "$dir" ] || return 1
  helper="$(cleanup_contract_helper)"
  stage="$(python3 "$helper" field "$journal_file" stage)" || return 1
  branch="$(python3 "$helper" field "$journal_file" branch)" || return 1
  body_file="$(mktemp "${TMPDIR:-/tmp}/workbench-task-cleanup.XXXXXX")"
  {
    printf '%s\n' '<!-- workbench-task-cleanup:v1'
    cat "$journal_file"
    printf '%s\n' '-->'
    printf 'workbench task cleanup: %s `%s`\n' "$stage" "$(safe_field "$branch")"
  } > "$body_file"
  if ! (cd "$dir" && gh issue comment "$issue" --body-file "$body_file") >/dev/null; then
    rm -f "$body_file"; return 1
  fi
  rm -f "$body_file"
}

cleanup_load_plan() {
  local journal_file="$1" helper operation claim disposition owner path
  helper="$(cleanup_contract_helper)"
  CLEANUP_PLAN_WRITER_COUNT=0; CLEANUP_PLAN_COUNT=0
  CLEANUP_PLAN_OPERATION_IDS=(); CLEANUP_PLAN_WRITER_IDS=(); CLEANUP_PLAN_DISPOSITIONS=()
  CLEANUP_PLAN_WORKTREE_OPERATION_IDS=(); CLEANUP_PLAN_WORKTREE_CLAIM_IDS=()
  CLEANUP_PLAN_NAMES=(); CLEANUP_PLAN_PATHS=()
  while IFS=$'\t' read -r operation claim disposition; do
    [ -n "$operation" ] || continue
    CLEANUP_PLAN_OPERATION_IDS[$CLEANUP_PLAN_WRITER_COUNT]="$operation"
    CLEANUP_PLAN_WRITER_IDS[$CLEANUP_PLAN_WRITER_COUNT]="$claim"
    CLEANUP_PLAN_DISPOSITIONS[$CLEANUP_PLAN_WRITER_COUNT]="$disposition"
    CLEANUP_PLAN_WRITER_COUNT=$((CLEANUP_PLAN_WRITER_COUNT + 1))
  done < <(python3 "$helper" list "$journal_file" writer_operations)
  while IFS=$'\t' read -r operation claim owner path; do
    [ -n "$operation" ] || continue
    CLEANUP_PLAN_WORKTREE_OPERATION_IDS[$CLEANUP_PLAN_COUNT]="$operation"
    CLEANUP_PLAN_WORKTREE_CLAIM_IDS[$CLEANUP_PLAN_COUNT]="$claim"
    CLEANUP_PLAN_NAMES[$CLEANUP_PLAN_COUNT]="$owner"
    CLEANUP_PLAN_PATHS[$CLEANUP_PLAN_COUNT]="$path"
    CLEANUP_PLAN_COUNT=$((CLEANUP_PLAN_COUNT + 1))
  done < <(python3 "$helper" list "$journal_file" codebase_worktrees)
}

CLEANUP_SNAPSHOT_DIR=""
CLEANUP_SNAPSHOT_TEMP=""
CLEANUP_JOURNAL_PROVENANCE_FILE=""

cleanup_snapshot_dispose() {
  [ -z "${CLEANUP_SNAPSHOT_TEMP:-}" ] || rm -rf "$CLEANUP_SNAPSHOT_TEMP"
  CLEANUP_SNAPSHOT_DIR=""; CLEANUP_SNAPSHOT_TEMP=""
}

cleanup_materialize_snapshot() {
  local root="$1" dir="$2" branch="$3" origin oid
  cleanup_snapshot_dispose
  if [ -d "$dir" ]; then CLEANUP_SNAPSHOT_DIR="$dir"; return 0; fi
  origin="$(canonical_workspace_origin_url "$root")" || return 1
  oid="$(writer_remote_task_oid "$origin" "$branch")" || return 1
  git -C "$root" fetch --quiet --no-tags --no-write-fetch-head "$origin" "$oid" \
    >/dev/null 2>&1 || return 1
  [ "$(git -C "$root" cat-file -t "$oid" 2>/dev/null)" = commit ] || return 1
  CLEANUP_SNAPSHOT_TEMP="$(mktemp -d "${TMPDIR:-/tmp}/workbench-cleanup-snapshot.XXXXXX")" \
    || return 1
  writer_materialize_context_snapshot "$root" "$oid" "$CLEANUP_SNAPSHOT_TEMP" \
    || { cleanup_snapshot_dispose; return 1; }
  CLEANUP_SNAPSHOT_DIR="$CLEANUP_SNAPSHOT_TEMP"
}

cleanup_validate_retry_snapshot() {
  local root="$1" dir="$2" branch="$3" journal_file="$4" claim descriptor terminal
  local missing_private=""
  [ -d "$dir" ] || missing_private=--allow-missing-private-action
  cleanup_materialize_snapshot "$root" "$dir" "$branch" || return 1
  if ! python3 "$(cleanup_contract_helper)" validate-snapshot \
    --journal-file "$journal_file" --task-dir "$CLEANUP_SNAPSHOT_DIR" \
    --branch "$branch" --now "$(utc_now)" \
    --provenance-file "$CLEANUP_JOURNAL_PROVENANCE_FILE" $missing_private >/dev/null; then
    cleanup_snapshot_dispose; rm -f "$CLEANUP_JOURNAL_PROVENANCE_FILE"
    CLEANUP_JOURNAL_PROVENANCE_FILE=""; return 1
  fi
  claim="$(python3 "$(cleanup_contract_helper)" field "$journal_file" claim_id)" \
    || { cleanup_snapshot_dispose; return 1; }
  descriptor="$(sed -n 's/^workspace_authority_descriptor_digest: *//p' \
    "$CLEANUP_SNAPSHOT_DIR/task/index.md")"
  terminal="$CLEANUP_SNAPSHOT_DIR/task/.workbench/terminal"
  terminal_lifecycle_state "$root" "$HOME_REPO" "$ISSUE" "$branch" "$claim" \
    "$descriptor" "$terminal" || { cleanup_snapshot_dispose; return 1; }
  cleanup_snapshot_dispose; rm -f "$CLEANUP_JOURNAL_PROVENANCE_FILE"
  CLEANUP_JOURNAL_PROVENANCE_FILE=""
}

cleanup_emit_owner_event() {
  local journal_file="$1" root="$2" operation="$3" claim="$4" device="$5" clone="$6"
  local state="$7" phase="$8" event="$9" helper next
  helper="$(cleanup_contract_helper)"
  next="$(mktemp "${TMPDIR:-/tmp}/workbench-cleanup-owner-event.XXXXXX")"
  if ! python3 "$helper" append-event "$journal_file" --event-id "$event" \
    --operation-id "$operation" --writer-claim-id "$claim" --device-id "$device" \
    --clone-id "$clone" --state "$state" --phase "$phase" --at "$(utc_now)" > "$next" \
    || ! cleanup_journal_emit "$root" "$HOME_REPO" "$ISSUE" "$next"; then
    rm -f "$next"; return 1
  fi
  mv "$next" "$journal_file"
}

cleanup_load_owner_prefix() {
  local journal_file="$1" operation="$2" claim="$3" output line
  output="$(python3 "$(cleanup_contract_helper)" event-state "$journal_file" \
    --operation-id "$operation" --writer-claim-id "$claim")" || return 1
  CLEANUP_OWNER_PREFIX_STATE=""; CLEANUP_OWNER_LAST_EVENT=""; CLEANUP_OWNER_LAST_DEVICE=""
  CLEANUP_OWNER_LAST_CLONE=""; CLEANUP_OWNER_LAST_STATE=""; CLEANUP_OWNER_LAST_PHASE=""
  while IFS= read -r line; do
    case "$line" in
      current_state=*) CLEANUP_OWNER_PREFIX_STATE="${line#current_state=}" ;;
      last_event_id=*) CLEANUP_OWNER_LAST_EVENT="${line#last_event_id=}" ;;
      last_device_id=*) CLEANUP_OWNER_LAST_DEVICE="${line#last_device_id=}" ;;
      last_clone_id=*) CLEANUP_OWNER_LAST_CLONE="${line#last_clone_id=}" ;;
      last_state=*) CLEANUP_OWNER_LAST_STATE="${line#last_state=}" ;;
      last_phase=*) CLEANUP_OWNER_LAST_PHASE="${line#last_phase=}" ;;
    esac
  done <<< "$output"
}

cleanup_load_remote_writer() {
  local root="$1" origin="$2" operation_file="$3" ledger state
  ledger="$(mktemp "${TMPDIR:-/tmp}/workbench-cleanup-ledger.XXXXXX")"
  if ! writer_load_remote_ledger "$root" "$origin" "$ledger"; then rm -f "$ledger"; return 1; fi
  state="$(python3 "$(writer_helper)" ledger-state "$ledger" \
    --operation-id "$WRITER_OPERATION_ID" --claim-id "$WRITER_CLAIM_ID" \
    --operation-file "$operation_file" --format json)" || { rm -f "$ledger"; return 1; }
  CLEANUP_REMOTE_COORDINATION_OID="$WRITER_OBSERVED_OID"
  IFS=$'\t' read -r CLEANUP_REMOTE_CLAIM CLEANUP_REMOTE_EVENT CLEANUP_REMOTE_DEVICE \
    CLEANUP_REMOTE_CLONE CLEANUP_REMOTE_EFFECT <<EOF
$(printf '%s\n' "$state" | python3 -c '
import json, sys
value = json.load(sys.stdin)
effect = value["effect_owner"] or {}
print("\t".join((
    value["claim_state"], effect.get("event_id", ""), effect.get("device_id", ""),
    effect.get("clone_id", ""), effect.get("state", ""),
)))
')
EOF
  rm -f "$ledger"
}

cleanup_verify_owned_effects() {
  local dir="$1" origin="$2" worktree="$dir/task/codebases/$WRITER_OWNER"
  local row="$dir/task/.workbench/writer-rows/$WRITER_OWNER.record"
  case "$WRITER_OPERATION_WORKTREE_OWNERSHIP" in
    none) [ ! -e "$worktree" ] || return 1 ;;
    created|adopted) [ -d "$worktree" ] && writer_marker_matches "$worktree" "$origin" || return 1 ;;
  esac
  case "$WRITER_OPERATION_RECORD_OWNERSHIP" in
    none) [ ! -e "$row" ] || return 1 ;;
    created|adopted)
      writer_row_matches_final "$row" || return 1
      repos_block | grep -Fq -- "- $WRITER_OWNER | $WRITER_CODEBASE_BRANCH | work" || return 1
      ;;
  esac
}

cleanup_worktree_descriptor() {
  local root="$1" origin="$2" dir="$3" wt="$4" clone="$5" operation_file="$6"
  python3 "$(writer_helper)" cleanup-descriptor --workspace-root "$root" \
    --workspace-origin-url "$origin" --task-dir "$dir" --worktree "$wt" \
    --clone "$clone" --operation-file "$operation_file" \
    --codebase-branch "$WRITER_CODEBASE_BRANCH"
}

cleanup_remove_local_writer_effects() {
  local root="$1" dir="$2" branch="$3" origin operation_file row record_count owner_rows
  local wt clone descriptor final_descriptor i
  CLEANUP_WRITER_BLOCKER=""
  origin="$(canonical_workspace_origin_url "$root")" || return 1
  TASK_DIR="$dir"; CURRENT_BRANCH="$branch"; CURRENT_CLAIM_ID="$CLEANUP_CLAIM_ID"
  for ((i=0; i<CLEANUP_PLAN_WRITER_COUNT; i++)); do
    operation_file="$dir/task/.workbench/writer-operations/${CLEANUP_PLAN_OPERATION_IDS[$i]}.json"
    [ -f "$operation_file" ] || return 1
    writer_load_operation_final "$operation_file" || return 1
    [ "$WRITER_OPERATION_ID" = "${CLEANUP_PLAN_OPERATION_IDS[$i]}" ] \
      && [ "$WRITER_CLAIM_ID" = "${CLEANUP_PLAN_WRITER_IDS[$i]}" ] \
      && [ "$WRITER_OPERATION_TASK_CLAIM_ID" = "$CLEANUP_CLAIM_ID" ] || return 1
    cleanup_load_remote_writer "$root" "$origin" "$operation_file" || return 1
    [ "$CLEANUP_REMOTE_CLAIM" = active ] && [ "$CLEANUP_REMOTE_EFFECT" = acquired ] \
      || return 1
    [ "$CLEANUP_REMOTE_DEVICE" = "$WRITER_DEVICE_ID" ] \
      && [ "$CLEANUP_REMOTE_CLONE" = "$WRITER_CLONE_ID" ] || return 1

    row="$dir/task/.workbench/writer-rows/$WRITER_OWNER.record"
    record_count="$(repos_block | grep -Fxc -- "- $WRITER_OWNER | $WRITER_CODEBASE_BRANCH | work" || true)"
    owner_rows="$(repos_block | grep -c "^- $WRITER_OWNER |" || true)"
    if [ "$WRITER_OPERATION_RECORD_OWNERSHIP" != none ]; then
      writer_row_matches_final "$row" \
        && [ "$record_count" = 1 ] && [ "$owner_rows" = 1 ] \
        || { CLEANUP_WRITER_BLOCKER=cleanup-ownership-mismatch; return 1; }
    else
      [ ! -e "$row" ] && [ ! -L "$row" ] \
        && ! repos_block | grep -Fq -- "- $WRITER_OWNER |" \
        || { CLEANUP_WRITER_BLOCKER=cleanup-ownership-mismatch; return 1; }
    fi

    wt="$dir/$WRITER_OPERATION_EXPECTED_PATH"; clone="$root/.codebases/$WRITER_OWNER"
    WRITER_WORKTREE="$wt"; WRITER_CLONE="$clone"
    [ ! -L "$clone" ] || { CLEANUP_WRITER_BLOCKER=cleanup-ownership-mismatch; return 1; }
    if [ "$WRITER_OPERATION_WORKTREE_OWNERSHIP" != none ]; then
      if [ -e "$wt" ] || [ -L "$wt" ]; then
        descriptor="$(cleanup_worktree_descriptor "$root" "$origin" "$dir" "$wt" \
          "$clone" "$operation_file")" \
          || { CLEANUP_WRITER_BLOCKER=cleanup-ownership-mismatch; return 1; }
        if [ -n "${WORKBENCH_TEST_CLEANUP_DESCRIPTOR_HOOK:-}" ]; then
          "$WORKBENCH_TEST_CLEANUP_DESCRIPTOR_HOOK" "$wt" \
            "$WRITER_CODEBASE_ORIGIN" "$WRITER_CODEBASE_BRANCH" || return 1
        fi
        final_descriptor="$(cleanup_worktree_descriptor "$root" "$origin" "$dir" "$wt" \
          "$clone" "$operation_file")" \
          || { CLEANUP_WRITER_BLOCKER=cleanup-ownership-mismatch; return 1; }
        [ "$final_descriptor" = "$descriptor" ] \
          || { CLEANUP_WRITER_BLOCKER=cleanup-ownership-mismatch; return 1; }
        git -C "$clone" worktree remove "$wt" >/dev/null 2>&1 || return 1
      fi
      { [ ! -e "$wt" ] && [ ! -L "$wt" ]; } || return 1
      ! git -C "$clone" worktree list --porcelain | grep -Fqx "worktree $wt" || return 1
      ! git -C "$clone" worktree list --porcelain \
        | grep -Fqx "branch refs/heads/$WRITER_CODEBASE_BRANCH" || return 1
    else
      [ ! -e "$wt" ] && [ ! -L "$wt" ] || return 1
    fi
  done
}

cleanup_reconcile_writer_operations() {
  local root="$1" dir="$2" journal_file="$3" origin operation_file disposition i event
  origin="$(canonical_workspace_origin_url "$root")" || return 1
  for ((i=0; i<CLEANUP_PLAN_WRITER_COUNT; i++)); do
    operation_file="$dir/task/.workbench/writer-operations/${CLEANUP_PLAN_OPERATION_IDS[$i]}.json"
    [ -f "$operation_file" ] || return 1
    writer_load_operation_final "$operation_file" || return 1
    [ "$WRITER_OPERATION_ID" = "${CLEANUP_PLAN_OPERATION_IDS[$i]}" ] \
      && [ "$WRITER_CLAIM_ID" = "${CLEANUP_PLAN_WRITER_IDS[$i]}" ] \
      && [ "$CURRENT_CLAIM_ID" = "$(python3 "$(writer_helper)" operation "$operation_file" \
        --format shell | sed -n 's/^task_claim_id=//p')" ] || return 1
    disposition="${CLEANUP_PLAN_DISPOSITIONS[$i]}"
    cleanup_load_remote_writer "$root" "$origin" "$operation_file" || return 1
    cleanup_load_owner_prefix "$journal_file" "$WRITER_OPERATION_ID" "$WRITER_CLAIM_ID" || return 1

    if [ "$CLEANUP_OWNER_LAST_PHASE" = intended ]; then
      [ "$CLEANUP_OWNER_LAST_DEVICE" = "$WRITER_DEVICE_ID" ] \
        && [ "$CLEANUP_OWNER_LAST_CLONE" = "$WRITER_CLONE_ID" ] || return 1
      case "$CLEANUP_OWNER_LAST_STATE" in
        acquired)
          [ "$CLEANUP_REMOTE_EFFECT" = acquired ] \
            && [ "$CLEANUP_REMOTE_EVENT" = "$CLEANUP_OWNER_LAST_EVENT" ] \
            && [ "$CLEANUP_REMOTE_DEVICE" = "$WRITER_DEVICE_ID" ] \
            && [ "$CLEANUP_REMOTE_CLONE" = "$WRITER_CLONE_ID" ] || return 1
          ;;
        released)
          if [ "$CLEANUP_REMOTE_EFFECT" = acquired ]; then
            [ "$CLEANUP_REMOTE_DEVICE" = "$WRITER_DEVICE_ID" ] \
              && [ "$CLEANUP_REMOTE_CLONE" = "$WRITER_CLONE_ID" ] || return 1
            writer_effect_owner_cas "$root" "$origin" released "$CLEANUP_OWNER_LAST_EVENT" "$operation_file" \
              || return 1
            cleanup_load_remote_writer "$root" "$origin" "$operation_file" || return 1
          fi
          [ "$CLEANUP_REMOTE_EFFECT" = released ] \
            && [ "$CLEANUP_REMOTE_EVENT" = "$CLEANUP_OWNER_LAST_EVENT" ] \
            && [ "$CLEANUP_REMOTE_DEVICE" = "$WRITER_DEVICE_ID" ] \
            && [ "$CLEANUP_REMOTE_CLONE" = "$WRITER_CLONE_ID" ] || return 1
          ;;
        *) return 1 ;;
      esac
      cleanup_emit_owner_event "$journal_file" "$root" "$WRITER_OPERATION_ID" \
        "$WRITER_CLAIM_ID" "$WRITER_DEVICE_ID" "$WRITER_CLONE_ID" \
        "$CLEANUP_OWNER_LAST_STATE" verified "$CLEANUP_OWNER_LAST_EVENT" || return 1
      cleanup_load_owner_prefix "$journal_file" "$WRITER_OPERATION_ID" "$WRITER_CLAIM_ID" || return 1
    fi

    if [ "$CLEANUP_OWNER_PREFIX_STATE" = none ]; then
      if [ "$CLEANUP_REMOTE_EFFECT" = acquired ]; then
        [ "$CLEANUP_REMOTE_DEVICE" = "$WRITER_DEVICE_ID" ] \
          && [ "$CLEANUP_REMOTE_CLONE" = "$WRITER_CLONE_ID" ] || return 1
        row="$dir/task/.workbench/writer-rows/$WRITER_OWNER.record"
        if [ "$WRITER_OPERATION_RECORD_OWNERSHIP" = none ]; then
          [ ! -e "$row" ] && [ ! -L "$row" ] \
            && ! repos_block | grep -Fq -- "- $WRITER_OWNER |" || return 1
        else
          writer_row_matches_final "$row" \
            && [ "$(repos_block | grep -Fxc -- "- $WRITER_OWNER | $WRITER_CODEBASE_BRANCH | work" || true)" = 1 ] \
            && [ "$(repos_block | grep -c "^- $WRITER_OWNER |" || true)" = 1 ] \
            || return 1
        fi
        [ ! -e "$dir/$WRITER_OPERATION_EXPECTED_PATH" ] || return 1
        ! git -C "$root/.codebases/$WRITER_OWNER" worktree list --porcelain \
          | grep -Fqx "worktree $dir/$WRITER_OPERATION_EXPECTED_PATH" || return 1
        cleanup_emit_owner_event "$journal_file" "$root" "$WRITER_OPERATION_ID" \
          "$WRITER_CLAIM_ID" "$WRITER_DEVICE_ID" "$WRITER_CLONE_ID" acquired intended \
          "$CLEANUP_REMOTE_EVENT" || return 1
        cleanup_emit_owner_event "$journal_file" "$root" "$WRITER_OPERATION_ID" \
          "$WRITER_CLAIM_ID" "$WRITER_DEVICE_ID" "$WRITER_CLONE_ID" acquired verified \
          "$CLEANUP_REMOTE_EVENT" || return 1
        CLEANUP_OWNER_PREFIX_STATE=acquired
      elif [ "$WRITER_OPERATION_WORKTREE_OWNERSHIP" != none ] \
        || [ "$WRITER_OPERATION_RECORD_OWNERSHIP" != none ]; then
        return 1
      fi
    fi

    if [ "$CLEANUP_OWNER_PREFIX_STATE" = acquired ]; then
      cleanup_load_remote_writer "$root" "$origin" "$operation_file" || return 1
      [ "$CLEANUP_REMOTE_EFFECT" = acquired ] \
        && [ "$CLEANUP_REMOTE_DEVICE" = "$WRITER_DEVICE_ID" ] \
        && [ "$CLEANUP_REMOTE_CLONE" = "$WRITER_CLONE_ID" ] || return 1
      event="$(mint_writer_event_id)"
      cleanup_emit_owner_event "$journal_file" "$root" "$WRITER_OPERATION_ID" \
        "$WRITER_CLAIM_ID" "$WRITER_DEVICE_ID" "$WRITER_CLONE_ID" released intended \
        "$event" || return 1
      writer_effect_owner_cas "$root" "$origin" released "$event" "$operation_file" || return 1
      cleanup_load_remote_writer "$root" "$origin" "$operation_file" || return 1
      [ "$CLEANUP_REMOTE_EFFECT" = released ] && [ "$CLEANUP_REMOTE_EVENT" = "$event" ] \
        || return 1
      cleanup_emit_owner_event "$journal_file" "$root" "$WRITER_OPERATION_ID" \
        "$WRITER_CLAIM_ID" "$WRITER_DEVICE_ID" "$WRITER_CLONE_ID" released verified \
        "$event" || return 1
      CLEANUP_OWNER_PREFIX_STATE=released
    fi

    cleanup_load_remote_writer "$root" "$origin" "$operation_file" || return 1
    if [ "$CLEANUP_REMOTE_CLAIM" = active ]; then
      [ "$CLEANUP_REMOTE_EFFECT" != acquired ] || return 1
      writer_append_release_final "$root" "$origin" "$operation_file" || return 1
      cleanup_load_remote_writer "$root" "$origin" "$operation_file" || return 1
    fi
    if [ "$CLEANUP_REMOTE_CLAIM" = absent ]; then
      [ "$disposition" = cancel-no-effect ] || case "$WRITER_OPERATION_STAGE" in
        prepared|authorization-pending|cancelled) ;; *) return 1 ;; esac
    else
      [ "$CLEANUP_REMOTE_CLAIM" = released ] && [ "$CLEANUP_REMOTE_EFFECT" != acquired ] || return 1
    fi
    CLEANUP_REMOVED_OPERATION_IDS[$CLEANUP_REMOVED_WRITER_COUNT]="$WRITER_OPERATION_ID"
    CLEANUP_REMOVED_WRITER_IDS[$CLEANUP_REMOVED_WRITER_COUNT]="$WRITER_CLAIM_ID"
    CLEANUP_REMOVED_WRITER_COUNT=$((CLEANUP_REMOVED_WRITER_COUNT + 1))
  done
}

cleanup_verify_external_writer_operations() {
  local root="$1" journal_file="$2" origin ledger helper i
  origin="$(canonical_workspace_origin_url "$root")" || return 1
  ledger="$(mktemp "${TMPDIR:-/tmp}/workbench-cleanup-ledger.XXXXXX")"
  writer_load_remote_ledger "$root" "$origin" "$ledger" || { rm -f "$ledger"; return 1; }
  helper="$(cleanup_contract_helper)"
  python3 "$helper" verify-released-writers --journal-file "$journal_file" \
    --ledger-file "$ledger" >/dev/null 2>&1 || { rm -f "$ledger"; return 1; }
  rm -f "$ledger"
  for ((i=0; i<CLEANUP_PLAN_WRITER_COUNT; i++)); do
    CLEANUP_REMOVED_OPERATION_IDS[$CLEANUP_REMOVED_WRITER_COUNT]="${CLEANUP_PLAN_OPERATION_IDS[$i]}"
    CLEANUP_REMOVED_WRITER_IDS[$CLEANUP_REMOVED_WRITER_COUNT]="${CLEANUP_PLAN_WRITER_IDS[$i]}"
    CLEANUP_REMOVED_WRITER_COUNT=$((CLEANUP_REMOVED_WRITER_COUNT + 1))
  done
}

cleanup_apply_removal_plan() {
  local root="$1" dir="$2" branch="$3" journal_file="$4" i name
  CLEANUP_REMOVED_WRITER_COUNT=0; CLEANUP_REMOVED_COUNT=0
  CLEANUP_REMOVED_OPERATION_IDS=(); CLEANUP_REMOVED_WRITER_IDS=(); CLEANUP_REMOVED_NAMES=()
  CLEANUP_TASK_WORKSPACE_REMOVED=false; CLEANUP_LOCAL_BRANCH_REMOVED=false
  if [ -L "$dir" ]; then
    cleanup_add_blocker cleanup-ownership-mismatch "$dir"
    return 1
  fi

  if [ "$CLEANUP_PLAN_WRITER_COUNT" -gt 0 ]; then
    if [ -d "$dir" ]; then
      cleanup_remove_local_writer_effects "$root" "$dir" "$branch" \
        && cleanup_reconcile_writer_operations "$root" "$dir" "$journal_file"
    else
      cleanup_verify_external_writer_operations "$root" "$journal_file"
    fi || {
      cleanup_add_blocker "${CLEANUP_WRITER_BLOCKER:-writer-recovery-blocked}" \
        refs/heads/workbench-coordination/writer-claims
      return 1
    }
  fi

  for ((i=0; i<CLEANUP_PLAN_COUNT; i++)); do
    name="${CLEANUP_PLAN_NAMES[$i]}"
    CLEANUP_REMOVED_NAMES[$CLEANUP_REMOVED_COUNT]="$name"
    CLEANUP_REMOVED_COUNT=$((CLEANUP_REMOVED_COUNT + 1))
  done

  if [ -d "$dir" ]; then
    git -C "$root" worktree remove --force "$dir" || return 1
  fi
  [ ! -d "$dir" ] || return 1
  CLEANUP_TASK_WORKSPACE_REMOVED=true
  if git -C "$root" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$root" branch -D "$branch" >/dev/null || return 1
  fi
  git -C "$root" show-ref --verify --quiet "refs/heads/$branch" && return 1
  CLEANUP_LOCAL_BRANCH_REMOVED=true
}

cleanup_mark_completed_plan() {
  local i
  CLEANUP_REMOVED_WRITER_COUNT=0; CLEANUP_REMOVED_COUNT=0
  CLEANUP_REMOVED_OPERATION_IDS=(); CLEANUP_REMOVED_WRITER_IDS=(); CLEANUP_REMOVED_NAMES=()
  for ((i=0; i<CLEANUP_PLAN_WRITER_COUNT; i++)); do
    CLEANUP_REMOVED_OPERATION_IDS[$CLEANUP_REMOVED_WRITER_COUNT]="${CLEANUP_PLAN_OPERATION_IDS[$i]}"
    CLEANUP_REMOVED_WRITER_IDS[$CLEANUP_REMOVED_WRITER_COUNT]="${CLEANUP_PLAN_WRITER_IDS[$i]}"
    CLEANUP_REMOVED_WRITER_COUNT=$((CLEANUP_REMOVED_WRITER_COUNT + 1))
  done
  for ((i=0; i<CLEANUP_PLAN_COUNT; i++)); do
    CLEANUP_REMOVED_NAMES[$CLEANUP_REMOVED_COUNT]="${CLEANUP_PLAN_NAMES[$i]}"
    CLEANUP_REMOVED_COUNT=$((CLEANUP_REMOVED_COUNT + 1))
  done
  CLEANUP_TASK_WORKSPACE_REMOVED=true; CLEANUP_LOCAL_BRANCH_REMOVED=true
}

cmd_done_v2() {
  local id="$1" parent="$2" branch="$3" dir="$4" instance_id="$5" authorization_file="$6"
  local root latest event lifecycle_actor terminal revision="" outcome target action_id="" wt name journal_rc stage helper
  local journal_file policy_file plan_file payload_file completed_file dirty
  local task_workspace=false local_branch=false intent="" manifest="" authorization_ref="" removal_plan=""
  local primary_digest stored_plan recovered_submission=false
  root="$(wb_root)"; helper="$(cleanup_contract_helper)"
  CLEANUP_TASK_ID="$id"; CLEANUP_BRANCH="$branch"; CLEANUP_CLAIM_ID=""
  CLEANUP_BLOCKER_COUNT=0; CLEANUP_REMOVED_COUNT=0; CLEANUP_REMOVED_WRITER_COUNT=0
  CLEANUP_BLOCKER_CODES=(); CLEANUP_BLOCKER_REFS=(); CLEANUP_REMOVED_NAMES=()
  CLEANUP_REMOVED_OPERATION_IDS=(); CLEANUP_REMOVED_WRITER_IDS=()
  CLEANUP_PLAN_COUNT=0; CLEANUP_PLAN_WRITER_COUNT=0; CLEANUP_PLAN_NAMES=()
  CLEANUP_PLAN_OPERATION_IDS=(); CLEANUP_PLAN_WRITER_IDS=(); CLEANUP_PLAN_DISPOSITIONS=()
  journal_file="$(mktemp "${TMPDIR:-/tmp}/workbench-cleanup-journal.XXXXXX")"

  latest="$(lifecycle_latest_for_branch "$root" "$HOME_REPO" "$ISSUE" "$branch")" || {
    cleanup_add_blocker lifecycle-write-failed "$branch"
    rm -f "$journal_file"; print_cleanup_json "" false "" "" "" "" "" "" false false; return 1
  }
  event="$(lifecycle_field "$latest" event)"
  lifecycle_actor="$(lifecycle_field "$latest" actor)"
  if cleanup_journal_latest "$root" "$HOME_REPO" "$ISSUE" "$id" "$branch" \
    "$lifecycle_actor" > "$journal_file"; then
    journal_rc=0
  else
    journal_rc=$?
  fi
  if [ "$journal_rc" -eq 3 ]; then
    CLEANUP_CLAIM_ID="$(lifecycle_field "$latest" claim_id)"
    cleanup_add_blocker cleanup-journal-untrusted "$branch"
    rm -f "$journal_file"; print_cleanup_json "" false "" "" "" "" "" "" false false; return 1
  fi
  if [ "$journal_rc" -eq 2 ]; then
    CLEANUP_CLAIM_ID="$(lifecycle_field "$latest" claim_id)"
    cleanup_add_blocker cleanup-journal-unavailable "$branch"
    rm -f "$journal_file"; print_cleanup_json "" false "" "" "" "" "" "" false false; return 1
  fi
  if [ "$journal_rc" -eq 0 ]; then
    CLEANUP_CLAIM_ID="$(python3 "$helper" field "$journal_file" claim_id)"
    revision="$(python3 "$helper" field "$journal_file" revision)"
    action_id="$(python3 "$helper" field "$journal_file" action_instance_id)"
    intent="$(python3 "$helper" field "$journal_file" intent_digest)"
    manifest="$(python3 "$helper" field "$journal_file" policy_manifest | sed -n 's/.*"digest":"\([^"]*\)".*/\1/p')"
    authorization_ref="$(python3 "$helper" field "$journal_file" authorization_ref)"
    removal_plan="$(python3 "$helper" field "$journal_file" removal_plan_digest)"
    stage="$(python3 "$helper" field "$journal_file" stage)"
    cleanup_load_plan "$journal_file"
    if ! cleanup_validate_retry_snapshot "$root" "$dir" "$branch" "$journal_file"; then
      cleanup_add_blocker cleanup-journal-unreconciled "$branch"
      rm -f "$journal_file"; print_cleanup_json "" false "$action_id" "$intent" "$manifest" \
        "$authorization_ref" "$revision" "$removal_plan" false false; return 1
    fi
    if [ "$stage" = completed ]; then
      if [ -d "$dir" ] || git -C "$root" show-ref --verify --quiet "refs/heads/$branch"; then
        cleanup_add_blocker cleanup-reconciliation-failed "$branch"
        rm -f "$journal_file"; print_cleanup_json "" false "$action_id" "$intent" "$manifest" \
          "$authorization_ref" "$revision" "$removal_plan" false false; return 1
      fi
      cleanup_mark_completed_plan
      if [ "$event" = task-cleaned ]; then
        if ! submission_recovery_retire "$root" "$branch" "$CLEANUP_CLAIM_ID"; then
          cleanup_add_blocker submission-recovery-retirement-failed "$branch"
          rm -f "$journal_file"; print_cleanup_json "" false "$action_id" "$intent" "$manifest" \
            "$authorization_ref" "$revision" "$removal_plan" true true; return 1
        fi
        rm -f "$journal_file"; print_cleanup_json cleaned false "$action_id" "$intent" "$manifest" \
          "$authorization_ref" "$revision" "$removal_plan" true true; return 0
      fi
      if ! lifecycle_emit "$root" "$HOME_REPO" "$ISSUE" task-cleaned "$CLEANUP_CLAIM_ID" \
        "$branch" - "$revision" "$action_id" workbench-task/v2 "" "$intent"; then
        cleanup_add_blocker lifecycle-write-failed "$branch"
        rm -f "$journal_file"; print_cleanup_json "" false "$action_id" "$intent" "$manifest" \
          "$authorization_ref" "$revision" "$removal_plan" true true; return 1
      fi
      if ! submission_recovery_retire "$root" "$branch" "$CLEANUP_CLAIM_ID"; then
        cleanup_add_blocker submission-recovery-retirement-failed "$branch"
        rm -f "$journal_file"; print_cleanup_json "" false "$action_id" "$intent" "$manifest" \
          "$authorization_ref" "$revision" "$removal_plan" true true; return 1
      fi
      rm -f "$journal_file"; print_cleanup_json cleaned true "$action_id" "$intent" "$manifest" \
        "$authorization_ref" "$revision" "$removal_plan" true true; return 0
    fi

    if [ -d "$dir" ] && [ -f "$dir/task/.workbench/actions/$action_id.record" ]; then
      TASK_DIR="$dir"; CURRENT_CLAIM_ID="$CLEANUP_CLAIM_ID"; CURRENT_ROOT="$root"
      CURRENT_HOME="$HOME_REPO"; CURRENT_ISSUE="$ISSUE"; CURRENT_BRANCH="$branch"
      primary_digest="$(digest_manifest "$journal_file")"
      consume_governed_action task.cleanup "workbench:task/$CLEANUP_CLAIM_ID" "$revision" \
        "$action_id" "$intent" "$primary_digest" || {
        cleanup_add_blocker action-effect-unreconciled "$action_id"
        rm -f "$journal_file"; print_cleanup_json "" false "$action_id" "$intent" "$manifest" \
          "$authorization_ref" "$revision" "$removal_plan" false false; return 1
      }
    fi
    if ! cleanup_apply_removal_plan "$root" "$dir" "$branch" "$journal_file"; then
      [ "$CLEANUP_BLOCKER_COUNT" -gt 0 ] || cleanup_add_blocker cleanup-reconciliation-failed "$branch"
      task_workspace="$CLEANUP_TASK_WORKSPACE_REMOVED"; local_branch="$CLEANUP_LOCAL_BRANCH_REMOVED"
      rm -f "$journal_file"; print_cleanup_json "" false "$action_id" "$intent" "$manifest" \
        "$authorization_ref" "$revision" "$removal_plan" "$task_workspace" "$local_branch"; return 1
    fi
    completed_file="$(mktemp "${TMPDIR:-/tmp}/workbench-cleanup-completed.XXXXXX")"
    if ! python3 "$helper" stage "$journal_file" --stage completed --at "$(utc_now)" > "$completed_file" \
      || ! cleanup_journal_emit "$root" "$HOME_REPO" "$ISSUE" "$completed_file"; then
      cleanup_add_blocker cleanup-journal-unavailable "$branch"
      rm -f "$journal_file" "$completed_file"; print_cleanup_json "" false "$action_id" "$intent" \
        "$manifest" "$authorization_ref" "$revision" "$removal_plan" true true; return 1
    fi
    rm -f "$journal_file" "$completed_file"
    if ! lifecycle_emit "$root" "$HOME_REPO" "$ISSUE" task-cleaned "$CLEANUP_CLAIM_ID" \
      "$branch" - "$revision" "$action_id" workbench-task/v2 "" "$intent"; then
      cleanup_add_blocker lifecycle-write-failed "$branch"
      print_cleanup_json "" false "$action_id" "$intent" "$manifest" "$authorization_ref" \
        "$revision" "$removal_plan" true true; return 1
    fi
    if ! submission_recovery_retire "$root" "$branch" "$CLEANUP_CLAIM_ID"; then
      cleanup_add_blocker submission-recovery-retirement-failed "$branch"
      print_cleanup_json "" false "$action_id" "$intent" "$manifest" "$authorization_ref" \
        "$revision" "$removal_plan" true true; return 1
    fi
    print_cleanup_json cleaned true "$action_id" "$intent" "$manifest" "$authorization_ref" \
      "$revision" "$removal_plan" true true; return 0
  fi

  [ -d "$dir" ] && [ -f "$dir/task/index.md" ] || {
    CLEANUP_CLAIM_ID="$(lifecycle_field "$latest" claim_id)"; cleanup_add_blocker missing-terminal-outcome "$branch"
    rm -f "$journal_file"; print_cleanup_json "" false "" "" "" "" "" "" false false; return 1
  }
  TASK_DIR="$dir"; CLEANUP_CLAIM_ID="$(index_get claim_id)"
  [ -n "$CLEANUP_CLAIM_ID" ] || CLEANUP_CLAIM_ID="$(lifecycle_field "$latest" claim_id)"
  if ! git -C "$dir" ls-files --error-unmatch task/index.md >/dev/null 2>&1; then
    if submission_recovery_guard; then
      recovered_submission=true
    else
      cleanup_add_blocker submission-recovery-unavailable "$branch"
    fi
  fi
  terminal="$(task_state_dir)/terminal"
  if [ ! -f "$terminal" ]; then cleanup_add_blocker missing-terminal-outcome "$branch"
  else
    outcome="$(record_get "$terminal" outcome)"; revision="$(record_get "$terminal" revision)"
    case "$outcome" in completed|abandoned) ;; *) cleanup_add_blocker missing-terminal-outcome "$branch" ;; esac
  fi
  if [ "$recovered_submission" = true ]; then
    dirty="$(git -C "$dir" status --porcelain | grep -v '^?? task/$' || true)"
  else
    dirty="$(git -C "$dir" status --porcelain | grep -v ' task/.workbench/actions/' || true)"
  fi
  [ -z "$dirty" ] || cleanup_add_blocker dirty-task-worktree "$branch"
  for wt in "$dir"/task/codebases/*/; do
    [ -d "$wt" ] || continue; name="$(basename "${wt%/}")"
    [ -z "$(git -C "$wt" status --porcelain)" ] || cleanup_add_blocker dirty-codebase-worktree "$name"
  done
  if [ "$recovered_submission" != true ]; then
    if ! git -C "$root" show-ref --verify --quiet "refs/remotes/origin/$branch" \
      || [ "$(git -C "$root" rev-list --count "origin/$branch..$branch" 2>/dev/null || echo 1)" -gt 0 ]; then
      cleanup_add_blocker unpushed-task-branch "$branch"
    fi
  fi
  if [ "$CLEANUP_BLOCKER_COUNT" -gt 0 ]; then
    rm -f "$journal_file"; print_cleanup_json "" false "" "" "" "" "$revision" "" false false; return 1
  fi

  CURRENT_CLAIM_ID="$CLEANUP_CLAIM_ID"; target="workbench:task/$CLEANUP_CLAIM_ID"; CURRENT_ROOT="$root"; CURRENT_HOME="$HOME_REPO"
  CURRENT_ISSUE="$ISSUE"; CURRENT_BRANCH="$branch"
  if ! build_terminal_removal_plan; then
    cleanup_add_blocker cleanup-plan-mismatch "$branch"
    rm -f "$journal_file"; print_cleanup_json "" false "" "" "" "" "$revision" "" false false; return 1
  fi
  removal_plan="$TERMINAL_REMOVAL_PLAN_DIGEST"; stored_plan="$(record_get "$terminal" removal_plan_digest)"
  if [ "$outcome" = abandoned ] && [ "$stored_plan" != "$removal_plan" ]; then
    cleanup_add_blocker cleanup-plan-mismatch "$branch"
    rm -f "$journal_file"; print_cleanup_json "" false "" "" "" "" "$revision" \
      "$removal_plan" false false; return 1
  fi
  payload_file="$(mktemp "${TMPDIR:-/tmp}/workbench-cleanup-intent.XXXXXX")"
  python3 "$(intent_helper)" build-payload --contract workbench-task-cleanup-intent/v1 \
    --field "terminal_revision=$revision" --field "removal_plan_digest=$removal_plan" \
    > "$payload_file" || { rm -f "$payload_file" "$journal_file"; die "invalid cleanup intent"; }
  resolve_governed_action task.cleanup "$target" "$revision" "$instance_id" "$authorization_file" \
    workbench-task-cleanup-intent/v1 "$payload_file"
  rm -f "$payload_file"
  case "$GOVERNED_POLICY_RC" in
    0) ;;
    3|4) rm -f "$journal_file"; printf '%s\n' "$GOVERNED_POLICY_OUTPUT"; return "$GOVERNED_POLICY_RC" ;;
    *) rm -f "$journal_file"; return "$GOVERNED_POLICY_RC" ;;
  esac
  action_id="$GOVERNED_ACTION_INSTANCE_ID"; intent="$GOVERNED_INTENT_DIGEST"
  if [ "$(record_get "$terminal" revision)" != "$revision" ] \
    || ! build_terminal_removal_plan \
    || [ "$TERMINAL_REMOVAL_PLAN_DIGEST" != "$removal_plan" ]; then
    cleanup_add_blocker action-binding-stale task.cleanup
    rm -f "$journal_file"; print_cleanup_json "" false "$action_id" "$intent" "" "" \
      "$revision" "$removal_plan" false false; return 1
  fi

  policy_file="$(mktemp "${TMPDIR:-/tmp}/workbench-cleanup-policy.XXXXXX")"
  plan_file="$(mktemp "${TMPDIR:-/tmp}/workbench-cleanup-plan.XXXXXX")"
  printf '%s\n' "$GOVERNED_POLICY_OUTPUT" > "$policy_file"
  printf '%s\n' "$TERMINAL_REMOVAL_PLAN_JSON" > "$plan_file"
  if ! python3 "$helper" build --policy-resolution-file "$policy_file" --task-id "$id" \
    --claim-id "$CLEANUP_CLAIM_ID" --branch "$branch" --revision "$revision" \
    --action-instance-id "$action_id" --intent-digest "$intent" \
    --removal-plan-digest "$removal_plan" --removal-plan-file "$plan_file" \
    --at "$(utc_now)" > "$journal_file"; then
    cleanup_add_blocker action-binding-stale task.cleanup
    rm -f "$journal_file" "$policy_file" "$plan_file"
    print_cleanup_json "" false "$action_id" "$intent" "" "" "$revision" "$removal_plan" false false; return 1
  fi
  rm -f "$policy_file" "$plan_file"
  manifest="$(python3 "$helper" field "$journal_file" policy_manifest | sed -n 's/.*"digest":"\([^"]*\)".*/\1/p')"
  authorization_ref="$(python3 "$helper" field "$journal_file" authorization_ref)"
  if ! cleanup_journal_emit "$root" "$HOME_REPO" "$ISSUE" "$journal_file"; then
    cleanup_add_blocker cleanup-journal-unavailable "$branch"
    rm -f "$journal_file"; print_cleanup_json "" false "$action_id" "$intent" "$manifest" \
      "$authorization_ref" "$revision" "$removal_plan" false false; return 1
  fi
  primary_digest="$(digest_manifest "$journal_file")"
  if ! consume_governed_action task.cleanup "$target" "$revision" "$action_id" "$intent" "$primary_digest"; then
    cleanup_add_blocker action-effect-unreconciled "$action_id"
    rm -f "$journal_file"; print_cleanup_json "" false "$action_id" "$intent" "$manifest" \
      "$authorization_ref" "$revision" "$removal_plan" false false; return 1
  fi
  cleanup_load_plan "$journal_file"
  if ! cleanup_apply_removal_plan "$root" "$dir" "$branch" "$journal_file"; then
    [ "$CLEANUP_BLOCKER_COUNT" -gt 0 ] || cleanup_add_blocker cleanup-reconciliation-failed "$branch"
    task_workspace="$CLEANUP_TASK_WORKSPACE_REMOVED"; local_branch="$CLEANUP_LOCAL_BRANCH_REMOVED"
    rm -f "$journal_file"; print_cleanup_json "" false "$action_id" "$intent" "$manifest" \
      "$authorization_ref" "$revision" "$removal_plan" "$task_workspace" "$local_branch"; return 1
  fi
  completed_file="$(mktemp "${TMPDIR:-/tmp}/workbench-cleanup-completed.XXXXXX")"
  if ! python3 "$helper" stage "$journal_file" --stage completed --at "$(utc_now)" > "$completed_file" \
    || ! cleanup_journal_emit "$root" "$HOME_REPO" "$ISSUE" "$completed_file"; then
    cleanup_add_blocker cleanup-journal-unavailable "$branch"
    rm -f "$journal_file" "$completed_file"; print_cleanup_json "" false "$action_id" "$intent" \
      "$manifest" "$authorization_ref" "$revision" "$removal_plan" true true; return 1
  fi
  rm -f "$journal_file" "$completed_file"
  if ! lifecycle_emit "$root" "$HOME_REPO" "$ISSUE" task-cleaned "$CLEANUP_CLAIM_ID" \
    "$branch" - "$revision" "$action_id" workbench-task/v2 "" "$intent"; then
    cleanup_add_blocker lifecycle-write-failed "$branch"
    print_cleanup_json "" false "$action_id" "$intent" "$manifest" "$authorization_ref" \
      "$revision" "$removal_plan" true true; return 1
  fi
  if ! submission_recovery_retire "$root" "$branch" "$CLEANUP_CLAIM_ID"; then
    cleanup_add_blocker submission-recovery-retirement-failed "$branch"
    print_cleanup_json "" false "$action_id" "$intent" "$manifest" "$authorization_ref" \
      "$revision" "$removal_plan" true true; return 1
  fi
  print_cleanup_json cleaned true "$action_id" "$intent" "$manifest" "$authorization_ref" \
    "$revision" "$removal_plan" true true
}

cmd_done() {
  local original=("$@") id="" force="" parent="" instance_id="" authorization_file="" format="" root branch dir task_contract latest
  while [ $# -gt 0 ]; do
    case "$1" in --force) force=1; shift ;; --parent) parent="$2"; shift 2 ;;
      --action-instance-id) instance_id="$2"; shift 2 ;; --authorization-file) authorization_file="$2"; shift 2 ;;
      --format) format="$2"; shift 2 ;; *) id="$1"; shift ;; esac
  done
  [ -n "$id" ] || die "usage: workbench task done <ID> [--parent N] ..."
  parse_id "$id"; root="$(wb_root)"; branch="$(resolve_branch "$HOME_REPO" "$ISSUE" "$parent" "$id")" || exit 1
  dir="$root/.worktrees/$(branch_to_dir "$branch")"; task_contract=""
  if [ -f "$dir/task/index.md" ]; then task_contract="$(sed -n '/^---$/,/^---$/p' "$dir/task/index.md" | sed -n 's/^task_contract: *//p' | head -1)"; fi
  if [ -z "$task_contract" ]; then
    latest="$(lifecycle_latest_for_branch "$root" "$HOME_REPO" "$ISSUE" "$branch")" \
      || die "lifecycle-source-unavailable"
    if [ -z "$latest" ] && [ "$(workspace_schema "$root")" != workbench/v2 ]; then
      task_contract=workbench-task/v1
    else
      task_contract="$(lifecycle_contract_for_branch "$root" "$HOME_REPO" "$ISSUE" "$branch")" \
        || die "lifecycle identity unavailable for task: $branch"
    fi
    case "$task_contract" in
      workbench-task/v1|workbench-task/v2) ;;
      *) die "lifecycle identity unavailable for task: $branch" ;;
    esac
  fi
  if [ "$task_contract" = workbench-task/v1 ]; then
    [ -z "$format$instance_id$authorization_file" ] || die "v1 task does not support v2 cleanup options"
    cmd_done_v1 "${original[@]}"; return
  fi
  [ -z "$force" ] || { echo "error: --force is invalid for workbench-task/v2" >&2; return 2; }
  [ "$format" = json ] || die "v2 cleanup requires --format json"
  cmd_done_v2 "$id" "$parent" "$branch" "$dir" "$instance_id" "$authorization_file"
}

# ── status ────────────────────────────────────────────────────────────

repos_block_from_index() {
  local file="$1"
  sed -n '/<!-- repos:begin -->/,/<!-- repos:end -->/p' "$file" | grep '^- ' || true
}

work_owners_from_index() {
  local file="$1" name branch role
  while IFS='|' read -r name branch role; do
    name="$(printf '%s' "$name" | sed -E 's/^- *| *$//g')"
    role="$(printf '%s' "$role" | sed -E 's/^ +| +$//g')"
    [ "$role" = work ] && [ -n "$name" ] && printf '%s\n' "$name"
  done < <(repos_block_from_index "$file")
}

status_task_projection() {
  local root="$1" index task_path branch parsed identity line key value
  local task_contract claim issue home descriptor
  local rows
  rows="$(mktemp "${TMPDIR:-/tmp}/workbench-status-tasks.XXXXXX")" || return 1
  observe_workspace_authority "$root" \
    || { rm -f "$rows"; return 1; }
  while IFS= read -r index; do
    [ -f "$index" ] || continue
    task_path="${index%/task/index.md}"
    branch="$(git -C "$task_path" symbolic-ref --quiet --short HEAD 2>/dev/null)" \
      || { rm -f "$rows"; return 1; }
    parsed="$(python3 "$(lifecycle_helper)" task-index --file "$index" \
      --branch "$branch" --format json 2>/dev/null)" \
      || { rm -f "$rows"; return 1; }
    identity="$(printf '%s\n' "$parsed" | python3 -c '
import json, sys
value = json.load(sys.stdin)
for key in ("task_contract", "claim_id", "issue", "home", "workspace_authority_descriptor_digest"):
    item = value[key]
    print("{}={}".format(key, "" if item is None else item))
')" || { rm -f "$rows"; return 1; }
    task_contract=""; claim=""; issue=""; home=""; descriptor=""
    while IFS= read -r line; do
      key="${line%%=*}"; value="${line#*=}"
      case "$key" in
        task_contract) task_contract="$value" ;; claim_id) claim="$value" ;;
        issue) issue="$value" ;; home) home="$value" ;;
        workspace_authority_descriptor_digest) descriptor="$value" ;;
      esac
    done <<< "$identity"
    if [ "$task_contract" = workbench-task/v2 ]; then
      [ "$descriptor" = "$AUTHORITY_DESCRIPTOR_DIGEST" ] \
        && lifecycle_identity_for_branch "$root" "$home" "$issue" "$branch" \
        && [ "$LIFECYCLE_IDENTITY_CONTRACT" = workbench-task/v2 ] \
        && [ "$LIFECYCLE_IDENTITY_CLAIM_ID" = "$claim" ] \
        && [ "$LIFECYCLE_IDENTITY_DESCRIPTOR_DIGEST" = "$descriptor" ] \
        || { rm -f "$rows"; return 1; }
    fi
    printf '%s\n' "$parsed" >> "$rows"
  done < <(find "$root/.worktrees" -mindepth 3 -maxdepth 3 \
    -path '*/task/index.md' -type f 2>/dev/null | sort)
  python3 - "$rows" <<'PY'
import json
import sys

tasks = []
with open(sys.argv[1], encoding="utf-8") as handle:
    for line in handle:
        value = json.loads(line)
        tasks.append({
            "task_id": value["id"],
            "issue": value["issue"],
            "home": value["home"],
            "parent": value["parent"],
            "claim_id": value["claim_id"],
            "task_contract": value["task_contract"],
            "branch": value["branch"],
            "workspace_authority_descriptor_digest": value["workspace_authority_descriptor_digest"],
            "context_ref": value["context_ref"],
            "work_ref": value["work_ref"],
            "work_owners": sorted(
                item["owner"] for item in value["repos"] if item["role"] == "work"
            ),
        })
tasks.sort(key=lambda item: item["branch"])
json.dump(tasks, sys.stdout, ensure_ascii=False, separators=(",", ":"))
sys.stdout.write("\n")
PY
  local rc=$?; rm -f "$rows"; return "$rc"
}

cmd_status_json() {
  local root tasks_json ledger inventory projection origin legacy_util operation blocker_count rc=0
  local writer_conflicts='[]' integrity_blockers='[]' args
  root="$(wb_root)"; ledger="$(mktemp "${TMPDIR:-/tmp}/workbench-status-ledger.XXXXXX")"
  inventory="$(mktemp "${TMPDIR:-/tmp}/workbench-status-legacy.XXXXXX")"
  tasks_json="$(status_task_projection "$root")" \
    || { rm -f "$ledger" "$inventory"; die "task-status-identity-unreconciled"; }
  origin="$(canonical_workspace_origin_url "$root" || true)"
  legacy_util="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/legacy-inventory"
  args=(status-projection --ledger-file "$ledger" --legacy-inventory-file "$inventory")
  while IFS= read -r operation; do
    [ -f "$operation" ] && args+=(--operation-file "$operation")
  done < <(find "$root/.worktrees" -path '*/task/.workbench/writer-operations/*.json' -type f 2>/dev/null | sort)
  if [ -z "$origin" ] || ! writer_load_remote_ledger "$root" "$origin" "$ledger"; then
    integrity_blockers='[{"code":"writer-lock-unavailable","ref":"refs/heads/workbench-coordination/writer-claims"}]'
  elif ! "$legacy_util" show --format json > "$inventory" 2>/dev/null; then
    integrity_blockers='[{"code":"legacy-writer-source-unavailable","ref":"workbench legacy-inventory show"}]'
  elif ! projection="$(python3 "$(writer_helper)" "${args[@]}" 2>/dev/null)"; then
    integrity_blockers='[{"code":"writer-claim-unreconciled","ref":"refs/heads/workbench-coordination/writer-claims"}]'
  else
    writer_conflicts="$(writer_json_query "$projection" writer_conflicts)"
    integrity_blockers="$(writer_json_query "$projection" writer_integrity_blockers)"
  fi
  printf '{"contract_version":"workbench-task-status/v2","tasks":%s,"writer_conflicts":%s,"writer_integrity_blockers":%s}\n' \
    "$tasks_json" "$writer_conflicts" "$integrity_blockers"
  blocker_count="$(printf '%s\n' "$integrity_blockers" | python3 -c 'import json,sys; print(len(json.load(sys.stdin)))')"
  rm -f "$ledger" "$inventory"
  [ "$blocker_count" -eq 0 ] || rc=1
  return "$rc"
}

# 모든 task의 현황을 구조화 출력한다 (read-only — 변경 0).
# 산문·분류는 하지 않는다. 사실 필드만 — 진단·분류는 /task-status 스킬의 몫.
# task 작업 공간으로 cd 하지 않는다 (git -C·절대경로만 — #19 cd 오염 교훈).
cmd_status() {
  if [ $# -gt 0 ]; then
    [ "$#" -eq 2 ] && [ "$1" = --format ] && [ "$2" = json ] || die "usage: workbench task status [--format json]"
    cmd_status_json; return
  fi
  local root; root="$(wb_root)"

  # 진짜 origin 의 task 브랜치 (ls-remote — ref 변경 없는 순수 read).
  # 오프라인이면 로컬 추적 ref로 폴백한다 (낡았을 수 있음 → remote_source: cached).
  local remote_set remote_src
  if remote_set="$(git -C "$root" ls-remote --heads origin 'refs/heads/task/*' 2>/dev/null)"; then
    remote_set="$(printf '%s\n' "$remote_set" | sed 's#.*refs/heads/##')"
    remote_src=live
  else
    remote_set="$(git -C "$root" for-each-ref --format='%(refname:short)' \
                    refs/remotes/origin/task/ 2>/dev/null | sed 's#^origin/##')"
    remote_src=cached
  fi

  # 메타 줄: 첫 레코드 앞 (스킬이 먼저 읽는다)
  printf 'remote_source: %s\n\n' "$remote_src"

  # task 브랜치 합집합: 로컬 head ∪ 로컬 추적 ref ∪ 진짜 origin(resume 케이스)
  local branches
  branches="$( { git -C "$root" for-each-ref --format='%(refname:short)' \
                   refs/heads/task/ refs/remotes/origin/task/ 2>/dev/null \
                   | sed 's#^origin/##'; printf '%s\n' "$remote_set"; } \
               | grep -v '^$' | sort -u)"

  local first=1 branch
  while IFS= read -r branch; do
    [ -n "$branch" ] || continue
    [ "$first" = 1 ] && first=0 || echo

    local dir issue rest last local_p remote_p ref tip ahead behind pr sf status_line sc cas
    dir="$root/.worktrees/$(branch_to_dir "$branch")"
    rest="${branch#task/}"; last="${rest##*/}"; issue="${last%%-*}"

    [ -d "$dir" ] && local_p=yes || local_p=no
    printf '%s\n' "$remote_set" | grep -qx "$branch" && remote_p=yes || remote_p=no

    # 브랜치 tip ref — 로컬 우선, 없으면 origin
    ref="refs/heads/$branch"
    git -C "$root" show-ref --verify --quiet "$ref" || ref="refs/remotes/origin/$branch"
    tip="$(git -C "$root" log -1 --format=%cI "$ref" 2>/dev/null || true)"

    # ahead/behind — 로컬·원격 ref 둘 다 있을 때만 (미push 감지)
    ahead=0; behind=0
    if git -C "$root" show-ref --verify --quiet "refs/heads/$branch" \
       && git -C "$root" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
      set -- $(git -C "$root" rev-list --left-right --count \
                 "refs/remotes/origin/$branch...refs/heads/$branch" 2>/dev/null || echo "0 0")
      behind="${1:-0}"; ahead="${2:-0}"
    fi

    # PR (브랜치당 1콜) — gh는 -C 없음, established 패턴인 subshell cd 사용
    pr="$( (cd "$root" && gh pr list --head "$branch" --state all \
              --json number,state --jq '.[0] // empty | "#\(.number) \(.state)"') 2>/dev/null || true)"
    [ -n "$pr" ] || pr=none

    # status.md — 로컬 디스크에서만 (cleanup으로 휘발 가능)
    status_line=""
    sf="$dir/task/status.md"
    [ -f "$sf" ] && status_line="$(grep -m1 '^상태:' "$sf" 2>/dev/null || true)"

    # status.md 갱신 커밋 이후 커밋 수 — status 낡음 진단용
    cas=0
    sc="$(git -C "$root" log -1 --format=%H "$ref" -- task/status.md 2>/dev/null || true)"
    [ -n "$sc" ] && cas="$(git -C "$root" rev-list --count "$sc..$ref" 2>/dev/null || echo 0)"

    printf 'branch: %s\n'   "$branch"
    printf 'issue: %s\n'    "$issue"
    printf 'local: %s\n'    "$local_p"
    printf 'remote: %s\n'   "$remote_p"
    printf 'pr: %s\n'       "$pr"
    printf 'ahead: %s\n'    "$ahead"
    printf 'behind: %s\n'   "$behind"
    printf 'last_commit: %s\n' "$tip"
    printf 'status_line: %s\n' "$status_line"
    printf 'commits_after_status: %s\n' "$cas"
  done <<< "$branches"
}

# 열린 workbench 이슈별 task/lifecycle 사실을 구조화 출력한다 (read-only).
# 판단 문구는 만들지 않는다. 분류는 스킬 레이어의 몫이다.
cmd_tickets() {
  local root; root="$(wb_root)"
  local rows branches remote_set
  branches="$(task_known_branches "$root")"
  remote_set="$(task_remote_branches "$root" | sed '/^$/d' | sort -u)"
  rows="$(cd "$root" && gh issue list --state open --limit 100 \
            --json number,title,state,url \
            --jq '.[] | "\(.number)\t\(.title)\t\(.state)\t\(.url)"')"

  local first=1 issue title issue_state url
  while IFS=$'\t' read -r issue title issue_state url; do
    [ -n "$issue" ] || continue
    [ "$first" = 1 ] && first=0 || echo

    local branch local_p remote_p pr latest event claim_id lifecycle_branch lifecycle_pr
    branch="$(find_branch_in_list "$branches" "" "$issue" 2>/dev/null || true)"
    local_p=no
    remote_p=no
    pr=none

    if [ -n "$branch" ]; then
      git -C "$root" show-ref --verify --quiet "refs/heads/$branch" && local_p=yes
      printf '%s\n' "$remote_set" | grep -qx "$branch" && remote_p=yes
      pr="$( (cd "$root" && gh pr list --head "$branch" --state all \
                --json number,state --jq '.[0] // empty | "#\(.number) \(.state)"') 2>/dev/null || true)"
      [ -n "$pr" ] || pr=none
    fi

    latest=""
    [ -n "$branch" ] && latest="$(lifecycle_latest_for_branch "$root" "" "$issue" "$branch")"
    [ -n "$latest" ] || latest="$(lifecycle_latest_for_issue "$root" "" "$issue")"
    event="$(lifecycle_field "$latest" event)"
    claim_id="$(lifecycle_field "$latest" claim_id)"
    lifecycle_branch="$(lifecycle_field "$latest" branch)"
    lifecycle_pr="$(lifecycle_field "$latest" pr)"

    printf 'issue: %s\n' "$issue"
    printf 'title: %s\n' "$title"
    printf 'issue_state: %s\n' "$issue_state"
    printf 'url: %s\n' "$url"
    printf 'branch: %s\n' "$branch"
    printf 'branch_local: %s\n' "$local_p"
    printf 'branch_remote: %s\n' "$remote_p"
    printf 'pr: %s\n' "$pr"
    printf 'lifecycle_event: %s\n' "$event"
    printf 'lifecycle_claim_id: %s\n' "$claim_id"
    printf 'lifecycle_branch: %s\n' "$lifecycle_branch"
    printf 'lifecycle_pr: %s\n' "$lifecycle_pr"
  done <<< "$rows"
}

# ── 디스패치 ──────────────────────────────────────────────────────────

case "${1:-}" in
  start)    shift; cmd_start "$@" ;;
  add-repo) shift; cmd_add_repo "$@" ;;
  writer-operation) shift; cmd_writer_operation "$@" ;;
  resume)   shift; cmd_resume "$@" ;;
  submit)   shift; cmd_submit "$@" ;;
  done)     shift; cmd_done "$@" ;;
  refs)     shift; cmd_refs "$@" ;;
  policy-context) shift; cmd_policy_context "$@" ;;
  deliverable) shift; cmd_deliverable "$@" ;;
  required-check) shift; cmd_required_check "$@" ;;
  harvest)  shift; cmd_harvest "$@" ;;
  evidence) shift; cmd_evidence "$@" ;;
  verify)   shift; cmd_verify "$@" ;;
  complete) shift; cmd_complete "$@" ;;
  abandon)  shift; cmd_abandon "$@" ;;
  commit)   shift; cmd_commit "$@" ;;
  check)    shift; cmd_check "$@" ;;
  status)   shift; cmd_status "$@" ;;
  tickets)  shift; cmd_tickets "$@" ;;
  *) sed -n '6,17p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
