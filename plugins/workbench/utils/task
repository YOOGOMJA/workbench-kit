}

writer_recover_zero_history() {
  local ledger="$1" operation="$2" matching count effects row operation_id claim_id state
  [ ! -e "$WRITER_WORKTREE" ] || return 10
  ! repos_block | grep -q "^- $WRITER_OWNER |" || return 10
  [ ! -e "$(writer_row_dir)/$WRITER_OWNER.record" ] || return 10
  ! git -C "$WRITER_CLONE" worktree list --porcelain | grep -Fq "branch refs/heads/$WRITER_CODEBASE_BRANCH" \
    || return 10
  matching="$(python3 "$(writer_helper)" matching-active "$ledger" \
    --task-claim-id "$CURRENT_CLAIM_ID" --owner "$WRITER_OWNER" --branch "$CURRENT_BRANCH")" || return 10
  count="$(printf '%s\n' "$matching" | python3 -c 'import json,sys; print(len(json.load(sys.stdin)["matches"]))')"
  effects="$(printf '%s\n' "$matching" | python3 -c 'import json,sys; print(len(json.load(sys.stdin)["effect_events"]))')"
  [ "$count" = 1 ] || { [ "$count" = 0 ] && return 10 || return 11; }
  [ "$effects" = 0 ] || return 12
  row="$(writer_json_query "$matching" matches.0)"
  [ "$(writer_json_query "$row" task_claim_id)" = "$CURRENT_CLAIM_ID" ] \
    && [ "$(writer_json_query "$row" owner)" = "$WRITER_OWNER" ] \
    && [ "$(writer_json_query "$row" branch)" = "$CURRENT_BRANCH" ] \
    && [ "$(writer_json_query "$row" expected_path)" = "task/codebases/$WRITER_OWNER" ] \
    && [ "$(writer_json_query "$row" codebase_origin_url)" = "$WRITER_CODEBASE_ORIGIN" ] \
    && [ "$(writer_json_query "$row" context_policy_set_digest)" = "$WRITER_CONTEXT_DIGEST" ] \
    && [ "$(writer_json_query "$row" action_instance_id)" = null ] \
    && [ "$(writer_json_query "$row" policy_manifest_digest)" = null ] \
    && [ "$(writer_json_query "$row" intent_digest)" = null ] \
    && [ "$(writer_json_query "$row" authorization_ref)" = null ] \
    || return 12
  operation_id="$(writer_json_query "$row" operation_id)"; claim_id="$(writer_json_query "$row" claim_id)"
  python3 "$(writer_helper)" operation-create --operation-id "$operation_id" --claim-id "$claim_id" \
    --task-claim-id "$CURRENT_CLAIM_ID" --owner "$WRITER_OWNER" --branch "$CURRENT_BRANCH" \
    --expected-path "task/codebases/$WRITER_OWNER" --codebase-origin-url "$WRITER_CODEBASE_ORIGIN" \
    --registry-revision "$PROTECTED_REGISTRY_REVISION" --registry-digest "$PROTECTED_REGISTRY_DIGEST" \
    --context-policy-set-digest "$WRITER_CONTEXT_DIGEST" --device-id "$WRITER_DEVICE_ID" \
    --clone-id "$WRITER_CLONE_ID" --coordination-oid "$WRITER_OBSERVED_OID" \
    --stage remote-claimed --output "$operation" || return 12
  state="$(python3 "$(writer_helper)" ledger-state "$ledger" --operation-id "$operation_id" \
    --claim-id "$claim_id" --operation-file "$operation" --format shell | \
    sed -n 's/^claim_state=//p')" || return 12
  [ "$state" = active ] || return 12
  return 0
}

writer_resolve_final() {
  local operation="$1" ledger="$2" instance_id="$3" authorization_file="$4"
  local payload policy_file action_rc
  local GOVERNED_REQUIRE_EXPLICIT_AUTHORIZATION=0
  writer_conflict_final "$ledger" "$operation" || return 1
  if [ "$WRITER_CONFLICT_COUNT" -eq 0 ]; then
    writer_operation_update "$operation" --clear-action-binding --stage prepared
    return 0
  fi
  writer_prepare_context_union "$(wb_root)" || {
    echo "error: policy-context-unavailable" >&2
    return 1
  }
  writer_load_operation_final "$operation" || { writer_context_union_cleanup; return 1; }
  [ -n "$instance_id" ] || instance_id="$WRITER_OPERATION_ACTION"
  payload="$(mktemp "${TMPDIR:-/tmp}/workbench-writer-intent.XXXXXX")"
  python3 "$(intent_helper)" build-payload --contract workbench-writer-request/v1 \
    --field "operation_id=$WRITER_OPERATION_ID" --field "claim_id=$WRITER_CLAIM_ID" \
    --field "owner=$WRITER_OWNER" --field "branch=$CURRENT_BRANCH" \
    --field "expected_path=task/codebases/$WRITER_OWNER" \
    --field "codebase_origin_url=$WRITER_CODEBASE_ORIGIN" \
    --field "context_policy_set_digest=$WRITER_CONTEXT_DIGEST" \
    --field "conflict_revision=$WRITER_CONFLICT_REVISION" > "$payload" \
    || { rm -f "$payload"; writer_context_union_cleanup; return 1; }
  writer_conflict_has_legacy && GOVERNED_REQUIRE_EXPLICIT_AUTHORIZATION=1
  resolve_governed_action task.concurrent-write "workbench:codebase/$WRITER_OWNER" \
    "$WRITER_CONFLICT_REVISION" "$instance_id" "$authorization_file" \
    workbench-writer-request/v1 "$payload"
  rm -f "$payload"; writer_context_union_cleanup
  action_rc="$GOVERNED_POLICY_RC"
  policy_file="$(mktemp "${TMPDIR:-/tmp}/workbench-writer-policy.XXXXXX")"
  printf '%s\n' "$GOVERNED_POLICY_OUTPUT" > "$policy_file"
  case "$action_rc" in
    0) writer_operation_update "$operation" --policy-resolution-file "$policy_file" --stage prepared ;;
    3) writer_operation_update "$operation" --policy-resolution-file "$policy_file" --stage authorization-pending ;;
    4) writer_operation_update "$operation" --policy-resolution-file "$policy_file" --stage cancelled ;;
    *) rm -f "$policy_file"; return "$action_rc" ;;
  esac
  rm -f "$policy_file"; writer_load_operation_final "$operation"
  [ "$action_rc" -eq 0 ] || { printf '%s\n' "$GOVERNED_POLICY_OUTPUT"; return "$action_rc"; }
}

writer_revalidate_final() {
  local operation="$1" root="$2" origin="$3" instance_id="$4" authorization_file="$5"
  local ledger payload policy_file state action_rc protected_digest protected_origin
  local GOVERNED_REQUIRE_EXPLICIT_AUTHORIZATION=0
  local GOVERNED_ALLOW_ACTION_REPLACEMENT=1
  writer_load_operation_final "$operation" || return 1
  protected_registry_entry "$root" "$WRITER_OWNER" \
    "$(index_get workspace_authority_descriptor_digest)" || return 1
  protected_digest="$PROTECTED_REGISTRY_DIGEST"; protected_origin="$PROTECTED_REGISTRY_ORIGIN"
  [ "$protected_digest" = "$WRITER_OPERATION_REGISTRY_DIGEST" ] \
    && [ "$protected_origin" = "$WRITER_CODEBASE_ORIGIN" ] || return 1
  [ "$(record_get "$(task_state_dir)/policy-context/state.record" digest)" \
    = "$WRITER_CONTEXT_DIGEST" ] || return 1
  ledger="$(mktemp "${TMPDIR:-/tmp}/workbench-writer-revalidate.XXXXXX")"
  writer_load_remote_ledger "$root" "$origin" "$ledger" || { rm -f "$ledger"; return 1; }
  state="$(python3 "$(writer_helper)" ledger-state "$ledger" \
    --operation-id "$WRITER_OPERATION_ID" --claim-id "$WRITER_CLAIM_ID" \
    --operation-file "$operation" --format shell | sed -n 's/^claim_state=//p')" \
    || { rm -f "$ledger"; return 1; }
  [ "$state" = active ] || { rm -f "$ledger"; return 1; }
  writer_conflict_final "$ledger" "$operation" || { rm -f "$ledger"; return 1; }
  rm -f "$ledger"
  if [ "$WRITER_CONFLICT_COUNT" -eq 0 ]; then
    if [ -n "$WRITER_OPERATION_ACTION" ]; then
      writer_operation_update "$operation" --clear-action-binding || return 1
      writer_load_operation_final "$operation" || return 1
    fi
    GOVERNED_POLICY_OUTPUT=""; GOVERNED_POLICY_RC=0
    return 0
  fi
  writer_prepare_context_union "$root" || {
    echo "error: policy-context-unavailable" >&2
    return 1
  }
  [ -n "$instance_id" ] || instance_id="$WRITER_OPERATION_ACTION"
  payload="$(mktemp "${TMPDIR:-/tmp}/workbench-writer-intent.XXXXXX")"
  python3 "$(intent_helper)" build-payload --contract workbench-writer-request/v1 \
    --field "operation_id=$WRITER_OPERATION_ID" --field "claim_id=$WRITER_CLAIM_ID" \
    --field "owner=$WRITER_OWNER" --field "branch=$CURRENT_BRANCH" \
    --field "expected_path=task/codebases/$WRITER_OWNER" \
    --field "codebase_origin_url=$WRITER_CODEBASE_ORIGIN" \
    --field "context_policy_set_digest=$WRITER_CONTEXT_DIGEST" \
    --field "conflict_revision=$WRITER_CONFLICT_REVISION" > "$payload" \
    || { rm -f "$payload"; writer_context_union_cleanup; return 1; }
  writer_conflict_has_legacy && GOVERNED_REQUIRE_EXPLICIT_AUTHORIZATION=1
  resolve_governed_action task.concurrent-write "workbench:codebase/$WRITER_OWNER" \
    "$WRITER_CONFLICT_REVISION" "$instance_id" "$authorization_file" \
    workbench-writer-request/v1 "$payload"
  rm -f "$payload"; writer_context_union_cleanup
  action_rc="$GOVERNED_POLICY_RC"
  case "$action_rc" in 0|3|4) ;; *) return 1 ;; esac
  policy_file="$(mktemp "${TMPDIR:-/tmp}/workbench-writer-policy.XXXXXX")"
  printf '%s\n' "$GOVERNED_POLICY_OUTPUT" > "$policy_file"
  writer_operation_update "$operation" --policy-resolution-file "$policy_file" \
    || { rm -f "$policy_file"; return 1; }
  rm -f "$policy_file"
  writer_load_operation_final "$operation" || return 1
  return "$action_rc"
}

writer_compensation_start_step() {
  if [ "$WRITER_OPERATION_RECORD_OWNERSHIP" != none ]; then printf 'record\n'
  elif [ "$WRITER_OPERATION_WORKTREE_OWNERSHIP" != none ]; then printf 'worktree\n'
  elif [ "$WRITER_OPERATION_EFFECT_OWNER_STATE" = acquired ]; then printf 'effect-owner\n'
  elif [ "$1" = released ]; then printf 'claim\n'
  else printf 'finish\n'
  fi
}

writer_reconcile_compensation_effects() {
  local operation="$1" row_file record_count owner_rows
  writer_load_operation_final "$operation" || return 1
  row_file="$(writer_row_dir)/$WRITER_OWNER.record"
  record_count="$(repos_block | grep -Fxc -- "- $WRITER_OWNER | $WRITER_CODEBASE_BRANCH | work" || true)"
  owner_rows="$(repos_block | grep -c "^- $WRITER_OWNER |" || true)"
  if [ "$WRITER_OPERATION_RECORD_OWNERSHIP" = none ]; then
    if [ -e "$row_file" ]; then
      writer_row_matches_pending_final "$row_file" || writer_row_matches_final "$row_file" \
        || return 1
      [ "$record_count" = 1 ] && [ "$owner_rows" = 1 ] || return 1
      writer_operation_update "$operation" --repo-record-ownership adopted || return 1
      writer_load_operation_final "$operation" || return 1
    else
      [ "$record_count" = 0 ] && [ "$owner_rows" = 0 ] || return 1
    fi
  fi
  if [ "$WRITER_OPERATION_WORKTREE_OWNERSHIP" = none ]; then
    if [ -e "$WRITER_WORKTREE" ]; then
      writer_worktree_matches_final || return 1
      writer_operation_update "$operation" --worktree-ownership adopted || return 1
      writer_load_operation_final "$operation" || return 1
    else
      ! git -C "$WRITER_CLONE" worktree list --porcelain | \
        grep -Fqx "branch refs/heads/$WRITER_CODEBASE_BRANCH" || return 1
    fi
  fi
}

writer_remove_repo_index_row_idempotent() {
  local row="- $WRITER_OWNER | $WRITER_CODEBASE_BRANCH | work" file tmp count owner_rows
  file="$TASK_DIR/task/index.md"; tmp="$file.tmp.$$"
  count="$(grep -Fxc -- "$row" "$file" || true)"
  owner_rows="$(repos_block | grep -c "^- $WRITER_OWNER |" || true)"
  if [ "$count" = 0 ] && [ "$owner_rows" = 0 ]; then return 0; fi
  [ "$count" = 1 ] && [ "$owner_rows" = 1 ] || return 1
  awk -v row="$row" '$0 != row { print }' "$file" > "$tmp" && mv "$tmp" "$file"
}

writer_print_stored_policy_final() {
  local operation="$1" decision="$2" action_file
  writer_load_operation_final "$operation" || return 1
  [ -n "$WRITER_OPERATION_ACTION" ] || return 1
  action_file="$(task_state_dir)/actions/$WRITER_OPERATION_ACTION.record"
  python3 - "$operation" "$action_file" "$decision" <<'PY'
import json
import sys

operation = json.load(open(sys.argv[1], encoding="utf-8"))
record = {}
for raw in open(sys.argv[2], encoding="utf-8"):
    key, separator, value = raw.rstrip("\n").partition("=")
    if not separator or key in record:
        raise SystemExit(1)
    record[key] = value
decision = sys.argv[3]
expected = {
    "id": operation["action_instance_id"],
    "action_id": "task.concurrent-write",
    "task_claim_id": operation["task_claim_id"],
    "target_ref": f"workbench:codebase/{operation['owner']}",
    "intent_digest": operation["intent_digest"],
    "policy_manifest_digest": operation["policy_manifest"]["digest"],
}
if any(record.get(key) != value for key, value in expected.items()):
    raise SystemExit(1)
if decision == "deny" and record.get("status") != "denied":
    raise SystemExit(1)
value = {
    "contract_version": "workbench-policy/v1",
    "action_instance": {
        "id": record["id"],
        "action_id": record["action_id"],
        "task_claim_id": record["task_claim_id"],
        "target_ref": record["target_ref"],
        "revision": record["revision"],
        "intent_digest": record["intent_digest"],
        "policy_manifest": operation["policy_manifest"],
        "status": record["status"],
    },
    "decision": decision,
    "authorization_ref": operation["authorization_ref"],
}
print(json.dumps(value, separators=(",", ":")))
PY
}

writer_compensate_revalidation() {
  local operation="$1" root="$2" origin="$3" target="$4" reason="$5"
  local row_file next_step state ledger
  writer_reconcile_compensation_effects "$operation" || return 1
  writer_load_operation_final "$operation" || return 1
  if [ "$WRITER_OPERATION_STAGE" != compensation-pending ] \
    && [ "$WRITER_OPERATION_STAGE" != release-pending ]; then
    next_step="$(writer_compensation_start_step "$target")"
    if [ "$next_step" = claim ]; then
      writer_operation_update "$operation" --stage release-pending \
        --compensation-target released --compensation-reason "$reason" \
        --compensation-next-step claim || return 1
    else
      writer_operation_update "$operation" --stage compensation-pending \
        --compensation-target "$target" --compensation-reason "$reason" \
        --compensation-next-step "$next_step" || return 1
    fi
    writer_load_operation_final "$operation" || return 1
  fi
  [ "$(writer_json_query "$(cat "$operation")" compensation_target)" = "$target" ] \
    && [ "$(writer_json_query "$(cat "$operation")" compensation_reason)" = "$reason" ] || return 1

  next_step="$(writer_json_query "$(cat "$operation")" compensation_next_step)"
  if [ "$next_step" = record ]; then
    row_file="$(writer_row_dir)/$WRITER_OWNER.record"
    [ "$WRITER_OPERATION_RECORD_OWNERSHIP" != none ] || return 1
    if [ -e "$row_file" ]; then
      writer_row_matches_pending_final "$row_file" || writer_row_matches_final "$row_file" \
        || return 1
      writer_remove_repo_index_row_idempotent || return 1
      rm -f "$row_file"
    else
      writer_remove_repo_index_row_idempotent || return 1
    fi
    if writer_test_interrupt compensation-record-removed "$operation"; then return 1; fi
    writer_operation_update "$operation" --repo-record-ownership none \
      --compensation-next-step worktree || return 1
    writer_load_operation_final "$operation" || return 1
    next_step=worktree
  fi

  if [ "$next_step" = worktree ]; then
    [ "$WRITER_OPERATION_WORKTREE_OWNERSHIP" != none ] || return 1
    if [ -e "$WRITER_WORKTREE" ]; then
      writer_worktree_matches_final \
        && git -C "$WRITER_CLONE" worktree remove "$WRITER_WORKTREE" >/dev/null 2>&1 \
        || return 1
    else
      ! git -C "$WRITER_CLONE" worktree list --porcelain | \
        grep -Fqx "branch refs/heads/$WRITER_CODEBASE_BRANCH" || return 1
    fi
    if writer_test_interrupt compensation-worktree-removed "$operation"; then return 1; fi
    writer_operation_update "$operation" --worktree-ownership none \
      --compensation-next-step effect-owner || return 1
    writer_load_operation_final "$operation" || return 1
    next_step=effect-owner
  fi

  if [ "$next_step" = effect-owner ]; then
    [ "$WRITER_OPERATION_EFFECT_OWNER_STATE" = acquired ] || return 1
    writer_effect_owner_cas "$root" "$origin" released "" "$operation" || return 1
    if writer_test_interrupt compensation-effect-owner-released "$operation"; then return 1; fi
    if [ "$target" = released ]; then
      writer_operation_update "$operation" --stage release-pending --effect-owner-state released \
        --coordination-oid "$WRITER_COORDINATION_REVISION" \
        --compensation-target released --compensation-reason "$reason" \
        --compensation-next-step claim || return 1
      next_step=claim
    else
      writer_operation_update "$operation" --effect-owner-state released \
        --coordination-oid "$WRITER_COORDINATION_REVISION" \
        --compensation-next-step finish || return 1
      next_step=finish
    fi
    writer_load_operation_final "$operation" || return 1
  fi

  if [ "$next_step" = claim ]; then
    [ "$target" = released ] && [ "$WRITER_OPERATION_STAGE" = release-pending ] || return 1
    writer_append_release_final "$root" "$origin" "$operation" || return 1
    if writer_test_interrupt compensation-claim-released "$operation"; then return 1; fi
    ledger="$(mktemp "${TMPDIR:-/tmp}/workbench-writer-compensation.XXXXXX")"
    writer_load_remote_ledger "$root" "$origin" "$ledger" || { rm -f "$ledger"; return 1; }
    state="$(python3 "$(writer_helper)" ledger-state "$ledger" \
      --operation-id "$WRITER_OPERATION_ID" --claim-id "$WRITER_CLAIM_ID" \
      --operation-file "$operation" --format shell | sed -n 's/^claim_state=//p')" \
      || { rm -f "$ledger"; return 1; }
    rm -f "$ledger"; [ "$state" = released ] || return 1
    writer_operation_update "$operation" --coordination-oid "$WRITER_COORDINATION_REVISION" \
      --compensation-next-step finish || return 1
    writer_load_operation_final "$operation" || return 1
    next_step=finish
  fi

  [ "$next_step" = finish ] || return 1
  if [ "$target" = reserved ]; then
    writer_operation_update "$operation" --stage remote-claimed --clear-compensation || return 1
  else
    writer_operation_update "$operation" --stage released --clear-compensation || return 1
  fi
  writer_load_operation_final "$operation"
}

writer_revalidation_gate() {
  local operation="$1" root="$2" origin="$3" instance_id="$4" authorization_file="$5"
  local revalidation_rc policy_output
  if writer_revalidate_final "$operation" "$root" "$origin" "$instance_id" "$authorization_file"; then
    writer_load_operation_final "$operation"
    return 0
  else
    revalidation_rc=$?
  fi
  policy_output="${GOVERNED_POLICY_OUTPUT:-}"
  case "$revalidation_rc" in
    3)
      writer_load_operation_final "$operation" || return 1
      writer_reconcile_compensation_effects "$operation" || {
        writer_load_operation_final "$operation" || true
        print_writer_claim_json_final false writer-recovery-blocked; return 1
      }
      if [ "$WRITER_OPERATION_RECORD_OWNERSHIP" != none ] \
        || [ "$WRITER_OPERATION_WORKTREE_OWNERSHIP" != none ] \
        || [ "$WRITER_OPERATION_EFFECT_OWNER_STATE" = acquired ]; then
        writer_compensate_revalidation "$operation" "$root" "$origin" reserved ask || {
          writer_load_operation_final "$operation" || true
          print_writer_claim_json_final false writer-recovery-blocked; return 1
        }
      fi
      printf '%s\n' "$policy_output"; return 3
      ;;
    4)
      writer_load_operation_final "$operation" || return 1
      writer_compensate_revalidation "$operation" "$root" "$origin" released deny || {
        writer_load_operation_final "$operation" || true
        print_writer_claim_json_final false writer-recovery-blocked; return 1
      }
      printf '%s\n' "$policy_output"; return 4
      ;;
    *)
      writer_load_operation_final "$operation" || true
      print_writer_claim_json_final false writer-recovery-blocked; return 1
      ;;
  esac
}

cmd_add_repo_v2_work_final() {
  local name="$1" ref="$2" instance_id="$3" authorization_file="$4"
  local root context_state operation_dir operation ledger origin observed existing recovery_rc gate_rc
  local issue parent slug snapshot row_file primary_digest changed=true
  local marker_file recovery_digest record_recovered=false record_count owner_rows
  local compensation_target compensation_reason
  root="$(wb_root)"; WRITER_OWNER="$name"; WRITER_CLONE="$root/.codebases/$name"
  [ -d "$WRITER_CLONE/.git" ] || die ".codebases/$name 없음 — codebases.yaml에 추가 후 workbench setup 실행"
  current_task_identity; writer_runtime_identity "$root"
  WRITER_RUNTIME_DEVICE_ID="$WRITER_DEVICE_ID"; WRITER_RUNTIME_CLONE_ID="$WRITER_CLONE_ID"
  protected_registry_entry "$root" "$name" "$(index_get workspace_authority_descriptor_digest)" \
    || die "protected-codebase-registry-unavailable: $name"
  WRITER_CODEBASE_ORIGIN="$PROTECTED_REGISTRY_ORIGIN"
  [ "$(git -C "$WRITER_CLONE" remote get-url origin 2>/dev/null || true)" = "$WRITER_CODEBASE_ORIGIN" ] \
    || die "codebase-origin-mismatch: $name"
  context_state="$(task_state_dir)/policy-context/state.record"
  if [ ! -f "$context_state" ]; then
    [ -z "$(index_get context_ref)" ] || { WRITER_CLAIM_ID=""; WRITER_OPERATION_ID=""; WRITER_CONFLICTS_JSON='[]'; print_writer_claim_json_final false policy-context-unsealed; return 1; }
    create_auto_null_policy_context >/dev/null
  fi
  [ "$(record_get "$context_state" sealed)" = true ] || { WRITER_CLAIM_ID=""; WRITER_OPERATION_ID=""; WRITER_CONFLICTS_JSON='[]'; print_writer_claim_json_final false policy-context-unsealed; return 1; }
  WRITER_CONTEXT_DIGEST="$(record_get "$context_state" digest)"
  issue="$(index_get issue)"; parent="$(index_get parent)"; slug="$(index_get slug)"
  validate_slug "$slug" || die "invalid task slug: $slug"
  WRITER_CODEBASE_BRANCH="task/${parent:+$parent/}${issue}-${slug}"
  WRITER_WORKTREE="$TASK_DIR/task/codebases/$name"
  [ -n "$ref" ] || ref="$(git -C "$WRITER_CLONE" symbolic-ref --short HEAD)"
  origin="$(canonical_workspace_origin_url "$root")" || return 1
  operation_dir="$(writer_operation_dir)"; mkdir -p "$operation_dir" "$(writer_row_dir)"
  if existing="$(writer_find_operation_for_owner "$name")"; then operation="$existing"
  else
    recovery_rc=$?
    [ "$recovery_rc" != 2 ] || { WRITER_CLAIM_ID=""; WRITER_OPERATION_ID=""; WRITER_CONFLICTS_JSON='[]'; print_writer_claim_json_final false writer-recovery-ambiguous; return 1; }
    operation=""
  fi
  ledger="$(mktemp "${TMPDIR:-/tmp}/workbench-writer-ledger.XXXXXX")"
  writer_load_remote_ledger "$root" "$origin" "$ledger" \
    || { rm -f "$ledger"; WRITER_CLAIM_ID=""; WRITER_OPERATION_ID=""; WRITER_CONFLICTS_JSON='[]'; print_writer_claim_json_final false writer-lock-unavailable; return 1; }
  observed="$WRITER_OBSERVED_OID"
  if [ -z "$operation" ]; then
    operation="$operation_dir/pending.json"
    if writer_recover_zero_history "$ledger" "$operation"; then
      writer_load_operation_final "$operation"; mv "$operation" "$operation_dir/$WRITER_OPERATION_ID.json"; operation="$operation_dir/$WRITER_OPERATION_ID.json"
    else
      recovery_rc=$?
      case "$recovery_rc" in
        10)
          WRITER_OPERATION_ID="$(mint_writer_operation_id)"; WRITER_CLAIM_ID="$(mint_writer_claim_id)"
          operation="$operation_dir/$WRITER_OPERATION_ID.json"
          python3 "$(writer_helper)" operation-create --operation-id "$WRITER_OPERATION_ID" \
            --claim-id "$WRITER_CLAIM_ID" --task-claim-id "$CURRENT_CLAIM_ID" --owner "$name" \
            --branch "$CURRENT_BRANCH" --expected-path "task/codebases/$name" \
            --codebase-origin-url "$WRITER_CODEBASE_ORIGIN" \
            --registry-revision "$PROTECTED_REGISTRY_REVISION" --registry-digest "$PROTECTED_REGISTRY_DIGEST" \
            --context-policy-set-digest "$WRITER_CONTEXT_DIGEST" \
            --device-id "$WRITER_DEVICE_ID" --clone-id "$WRITER_CLONE_ID" \
            ${observed:+--coordination-oid "$observed"} --stage prepared --output "$operation" || { rm -f "$ledger"; return 1; }
          ;;
        11) rm -f "$ledger"; WRITER_CLAIM_ID=""; WRITER_OPERATION_ID=""; WRITER_CONFLICTS_JSON='[]'; print_writer_claim_json_final false writer-recovery-ambiguous; return 1 ;;
        *) rm -f "$ledger"; WRITER_CLAIM_ID=""; WRITER_OPERATION_ID=""; WRITER_CONFLICTS_JSON='[]'; print_writer_claim_json_final false writer-recovery-blocked; return 1 ;;
      esac
    fi
  fi
  writer_load_operation_final "$operation" || { rm -f "$ledger"; return 1; }
  WRITER_OPERATION_FILE="$operation"
  [ "$WRITER_OPERATION_REGISTRY_DIGEST" = "$PROTECTED_REGISTRY_DIGEST" ] \
    && [ "$WRITER_CODEBASE_ORIGIN" = "$PROTECTED_REGISTRY_ORIGIN" ] \
    || { rm -f "$ledger"; print_writer_claim_json_final false writer-recovery-blocked; return 1; }
  case "$WRITER_OPERATION_STAGE" in
    compensation-pending|release-pending)
      compensation_target="$(writer_json_query "$(cat "$operation")" compensation_target)"
      compensation_reason="$(writer_json_query "$(cat "$operation")" compensation_reason)"
      case "$compensation_target:$compensation_reason" in
        reserved:ask|released:deny|released:authorization-deny) ;;
        *) rm -f "$ledger"; print_writer_claim_json_final false writer-recovery-blocked; return 1 ;;
      esac
      [ "$WRITER_DEVICE_ID" = "$WRITER_RUNTIME_DEVICE_ID" ] \
        && [ "$WRITER_CLONE_ID" = "$WRITER_RUNTIME_CLONE_ID" ] \
        || { rm -f "$ledger"; print_writer_claim_json_final false writer-recovery-blocked; return 1; }
      rm -f "$ledger"
      writer_compensate_revalidation "$operation" "$root" "$origin" \
        "$compensation_target" "$compensation_reason" || {
        writer_load_operation_final "$operation" || true
        print_writer_claim_json_final false writer-recovery-blocked; return 1
      }
      if [ "$compensation_target" = released ]; then
        writer_print_stored_policy_final "$operation" deny || {
          print_writer_claim_json_final false writer-recovery-blocked; return 1
        }
        return 4
      fi
      ledger="$(mktemp "${TMPDIR:-/tmp}/workbench-writer-ledger.XXXXXX")"
      writer_load_remote_ledger "$root" "$origin" "$ledger" || {
        rm -f "$ledger"; print_writer_claim_json_final false writer-lock-unavailable; return 1
      }
      observed="$WRITER_OBSERVED_OID"
      ;;
  esac
  if [ "$WRITER_OPERATION_STAGE" = consumed ]; then
    writer_conflict_final "$ledger" "$operation" || { rm -f "$ledger"; return 1; }
    if ! writer_consumed_matches_final "$ledger" "$operation"; then
      rm -f "$ledger"; print_writer_claim_json_final false writer-recovery-blocked; return 1
    fi
    WRITER_COORDINATION_REVISION="$observed"; rm -f "$ledger"
    print_writer_claim_json_final false; return 0
  fi
  local publish_attempt publish_rc published=false operation_already_claimed=false
  case "$WRITER_OPERATION_STAGE" in
    remote-claimed|effect-owner-acquired|worktree-create-pending|worktree-ready|record-create-pending|record-ready|handoff-ready)
      operation_already_claimed=true ;;
    prepared|authorization-pending) : ;;
    *) rm -f "$ledger"; print_writer_claim_json_final false writer-recovery-blocked; return 1 ;;
  esac
  if [ "$operation_already_claimed" = true ]; then
    [ "$WRITER_DEVICE_ID" = "$WRITER_RUNTIME_DEVICE_ID" ] \
      && [ "$WRITER_CLONE_ID" = "$WRITER_RUNTIME_CLONE_ID" ] \
      || { rm -f "$ledger"; print_writer_claim_json_final false writer-recovery-blocked; return 1; }
    writer_conflict_final "$ledger" "$operation" || {
      rm -f "$ledger"; print_writer_claim_json_final false writer-recovery-blocked; return 1
    }
    rm -f "$ledger"
    if writer_append_active_final "$root" "$origin" "$operation"; then
      published=true
    else
      print_writer_claim_json_final false writer-recovery-blocked; return 1
    fi
  else
    for ((publish_attempt=1; publish_attempt<=8; publish_attempt++)); do
      if writer_resolve_final "$operation" "$ledger" "$instance_id" "$authorization_file"; then
        :
      else
        recovery_rc=$?; rm -f "$ledger"; return "$recovery_rc"
      fi
      writer_load_operation_final "$operation"; rm -f "$ledger"
      if writer_append_active_final "$root" "$origin" "$operation"; then published=true; break
      else publish_rc=$?; fi
      [ "$publish_rc" = 3 ] || { print_writer_claim_json_final false writer-lock-unavailable; return 1; }
      ledger="$(mktemp "${TMPDIR:-/tmp}/workbench-writer-ledger.XXXXXX")"
      writer_load_remote_ledger "$root" "$origin" "$ledger" \
        || { rm -f "$ledger"; print_writer_claim_json_final false writer-lock-unavailable; return 1; }
      instance_id=""
    done
  fi
  [ "$published" = true ] || { print_writer_claim_json_final false writer-lock-unavailable; return 1; }
  if [ "$operation_already_claimed" = false ]; then
    writer_operation_update "$operation" --stage remote-claimed --coordination-oid "$WRITER_COORDINATION_REVISION"
    writer_load_operation_final "$operation"
  fi
  if [ "${WORKBENCH_TEST_FAIL_AFTER_WRITER_CLAIM:-0}" = 1 ]; then
    print_writer_claim_json_final false writer-lock-unavailable
    return 1
  fi
  if writer_revalidation_gate "$operation" "$root" "$origin" "$instance_id" "$authorization_file"; then
    :
  else
    gate_rc=$?; return "$gate_rc"
  fi
  if writer_effect_owner_cas "$root" "$origin" acquired; then
    :
  else
    recovery_rc=$?; [ "$recovery_rc" = 2 ] && print_writer_claim_json_final false writer-recovery-blocked \
      || print_writer_claim_json_final false writer-lock-unavailable; return 1
  fi
  if [ "$WRITER_OPERATION_EFFECT_OWNER_STATE" != acquired ]; then
    writer_operation_update "$operation" --stage effect-owner-acquired --effect-owner-state acquired \
      --coordination-oid "$WRITER_COORDINATION_REVISION"
    writer_load_operation_final "$operation"
  fi
  if writer_test_interrupt effect-owner-acquired "$operation"; then return 1; fi
  if writer_revalidation_gate "$operation" "$root" "$origin" "$instance_id" "$authorization_file"; then
    :
  else
    gate_rc=$?; return "$gate_rc"
  fi

  if [ -z "$WRITER_OPERATION_WORKTREE_SET_DIGEST" ]; then
    snapshot="$(writer_worktree_snapshot_digest "$WRITER_CLONE" "$WRITER_CODEBASE_ORIGIN" \
      "$WRITER_WORKTREE" "$WRITER_CODEBASE_BRANCH")" || {
      print_writer_claim_json_final false writer-recovery-blocked; return 1
    }
    writer_operation_update "$operation" --stage worktree-create-pending --worktree-set-digest "$snapshot"
    writer_load_operation_final "$operation"
  fi

  local worktree_failed=false worktree_recovered=false
  if [ -d "$WRITER_WORKTREE" ]; then
    if recovery_digest="$(writer_worktree_recovery_digest "$WRITER_CLONE" "$WRITER_CODEBASE_ORIGIN" \
      "$WRITER_WORKTREE" "$WRITER_CODEBASE_BRANCH")"; then
      [ "$recovery_digest" = "$WRITER_OPERATION_WORKTREE_SET_DIGEST" ] \
        && writer_worktree_structure_matches_final || {
        print_writer_claim_json_final false writer-recovery-blocked; return 1
      }
      marker_file="$(writer_marker_file "$WRITER_WORKTREE")" || {
        print_writer_claim_json_final false writer-recovery-blocked; return 1
      }
      if writer_marker_matches "$WRITER_WORKTREE" "$WRITER_CODEBASE_ORIGIN"; then
        [ "$WRITER_OPERATION_WORKTREE_OWNERSHIP" = none ] && worktree_recovered=true
      elif [ -e "$marker_file" ] || [ "$WRITER_OPERATION_WORKTREE_OWNERSHIP" != none ]; then
        print_writer_claim_json_final false writer-recovery-blocked; return 1
      else
        writer_write_marker "$WRITER_WORKTREE" "$WRITER_CODEBASE_ORIGIN" || {
          print_writer_claim_json_final false writer-recovery-blocked; return 1
        }
        if writer_test_interrupt marker-written "$operation"; then return 1; fi
        worktree_recovered=true
      fi
    elif [ "$WRITER_OPERATION_WORKTREE_OWNERSHIP" = none ]; then
      worktree_failed=true
    else
      print_writer_claim_json_final false writer-recovery-blocked; return 1
    fi
  elif [ "$WRITER_OPERATION_WORKTREE_OWNERSHIP" != none ]; then
    print_writer_claim_json_final false writer-recovery-blocked; return 1
  elif ! writer_local_attach "$WRITER_CLONE" "$WRITER_WORKTREE" "$WRITER_CODEBASE_BRANCH" "$ref" >/dev/null 2>&1; then
    worktree_failed=true
  else
    if writer_test_interrupt worktree-attached "$operation"; then return 1; fi
    writer_write_marker "$WRITER_WORKTREE" "$WRITER_CODEBASE_ORIGIN" || worktree_failed=true
    if [ "$worktree_failed" = false ] \
      && writer_test_interrupt marker-written "$operation"; then return 1; fi
  fi
  if [ "$worktree_failed" = true ]; then
      writer_operation_update "$operation" --stage compensation-pending --compensation-target released \
        --compensation-reason creation-failure --compensation-next-step effect-owner
      if writer_effect_owner_cas "$root" "$origin" released; then
        writer_operation_update "$operation" --stage release-pending --effect-owner-state released \
          --compensation-target released --compensation-reason creation-failure --compensation-next-step claim
        if writer_append_release_final "$root" "$origin"; then
          writer_operation_update "$operation" --stage released --coordination-oid "$WRITER_COORDINATION_REVISION" \
            --clear-compensation
        fi
      fi
      writer_load_operation_final "$operation"; print_writer_claim_json_final false writer-lock-unavailable; return 1
  fi
  if [ "$WRITER_OPERATION_WORKTREE_OWNERSHIP" = none ]; then
    if [ "$worktree_recovered" = true ]; then
      writer_operation_update "$operation" --stage worktree-ready --worktree-ownership adopted
    else
      writer_operation_update "$operation" --stage worktree-ready --worktree-ownership created
    fi
    writer_load_operation_final "$operation"
  fi
  if writer_test_interrupt worktree-ready "$operation"; then return 1; fi
  if writer_revalidation_gate "$operation" "$root" "$origin" "$instance_id" "$authorization_file"; then
    :
  else
    gate_rc=$?; return "$gate_rc"
  fi
  writer_operation_update "$operation" --stage record-create-pending
  writer_load_operation_final "$operation"
  record_count="$(repos_block | grep -Fxc -- "- $name | $WRITER_CODEBASE_BRANCH | work" || true)"
  owner_rows="$(repos_block | grep -c "^- $name |" || true)"
  if [ "$record_count" = 0 ] && [ "$owner_rows" = 0 ]; then
    repos_append "- $name | $WRITER_CODEBASE_BRANCH | work"
    if writer_test_interrupt repo-index-written "$operation"; then return 1; fi
  elif [ "$record_count" = 1 ] && [ "$owner_rows" = 1 ]; then
    record_recovered=true
  else
    print_writer_claim_json_final false writer-recovery-blocked; return 1
  fi
  row_file="$(writer_row_dir)/$name.record"
  if [ -e "$row_file" ]; then
    writer_row_matches_pending_final "$row_file" || {
      print_writer_claim_json_final false writer-recovery-blocked; return 1
    }
    record_recovered=true
  else
    write_writer_row_final "$row_file" "" "" "" ""
    if writer_test_interrupt writer-row-written "$operation"; then return 1; fi
  fi
  if [ "$record_recovered" = true ]; then
    writer_operation_update "$operation" --stage record-ready --repo-record-ownership adopted
  else
    writer_operation_update "$operation" --stage record-ready --repo-record-ownership created
  fi
  writer_load_operation_final "$operation"
  if writer_revalidation_gate "$operation" "$root" "$origin" "$instance_id" "$authorization_file"; then
    :
  else
    gate_rc=$?; return "$gate_rc"
  fi
  if [ -n "$WRITER_OPERATION_ACTION" ]; then
    write_writer_row_final "$row_file" "$WRITER_OPERATION_ACTION" "$WRITER_OPERATION_INTENT" \
      "$WRITER_OPERATION_MANIFEST" "$WRITER_OPERATION_AUTHORIZATION"
    primary_digest="$(digest_manifest "$row_file")"
    consume_governed_action task.concurrent-write "workbench:codebase/$name" "$WRITER_CONFLICT_REVISION" \
      "$WRITER_OPERATION_ACTION" "$WRITER_OPERATION_INTENT" "$primary_digest" || {
      print_writer_claim_json_final false action-effect-unreconciled; return 1
    }
  fi
  writer_operation_update "$operation" --stage consumed
  writer_load_operation_final "$operation"
  git -C "$TASK_DIR" add task/index.md task/.workbench/writer-operations \
    task/.workbench/writer-rows task/.workbench/actions 2>/dev/null || true
  if ! git -C "$TASK_DIR" diff --cached --quiet; then
    git -C "$TASK_DIR" commit -q -m "task: add-repo $name (work)"
  fi
  print_writer_claim_json_final "$changed"
}

cmd_add_repo() {
  local original=("$@") name="" ref="" role=work format="" instance_id="" authorization_file="" task_contract
  while [ $# -gt 0 ]; do
    case "$1" in
      --ref) ref="$2"; shift 2 ;; --role) role="$2"; shift 2 ;; --format) format="$2"; shift 2 ;;
      --action-instance-id) instance_id="$2"; shift 2 ;; --authorization-file) authorization_file="$2"; shift 2 ;;
      *) name="$1"; shift ;;
    esac
  done
  [ -n "$name" ] || die "usage: workbench task add-repo <name> [--ref <base>] [--role work|reference]"
  validate_home_name "$name" || die "invalid codebase home: $name"
  require_task_worktree; [ -f "$TASK_DIR/task/index.md" ] || die "task/index.md 없음"
  task_contract="$(index_get task_contract)"; [ -n "$task_contract" ] || task_contract=workbench-task/v1
  if [ "$task_contract" = workbench-task/v1 ]; then
    [ -z "$format$instance_id$authorization_file" ] || die "v1 task does not support v2 add-repo options"
    cmd_add_repo_v1 "${original[@]}"; return
  fi
  require_v2_task; require_mutable_task task.add-repo || return 1
  [ "$format" = json ] || die "v2 add-repo requires --format json"
  case "$role" in work|reference) ;; *) die "role must be work or reference" ;; esac
  if [ "$role" = work ]; then
    cmd_add_repo_v2_work_final "$name" "$ref" "$instance_id" "$authorization_file"
  else
    protected_registry_entry "$(wb_root)" "$name" "$(index_get workspace_authority_descriptor_digest)" \
      || die "protected-codebase-registry-unavailable: $name"
    [ "$(git -C "$(wb_root)/.codebases/$name" remote get-url origin 2>/dev/null || true)" \
      = "$PROTECTED_REGISTRY_ORIGIN" ] || die "codebase-origin-mismatch: $name"
    cmd_add_repo_v1 "$name" ${ref:+--ref "$ref"} --role reference
    WRITER_OWNER="$name"; WRITER_CLAIM_ID=""; WRITER_TASK_CLAIM_ID="$(index_get claim_id)"; WRITER_ROLE=reference
    WRITER_CONFLICT_COUNT=0; print_writer_claim_json true "" ""
  fi
}

writer_operation_file() {
  local operation_id="$1"
  validate_record_id operation_id "$operation_id"
  printf '%s/%s.json\n' "$(writer_operation_dir)" "$operation_id"
}

writer_operation_context() {
  local operation_id="$1" root origin operation
  require_task_worktree; require_v2_task; current_task_identity
  operation="$(writer_operation_file "$operation_id")"
  [ -f "$operation" ] || die "writer operation not found: $operation_id"
  root="$(wb_root)"; writer_runtime_identity "$root"
  WRITER_RUNTIME_DEVICE_ID="$WRITER_DEVICE_ID"
  WRITER_RUNTIME_CLONE_ID="$WRITER_CLONE_ID"
  writer_load_operation_final "$operation" || die "invalid writer operation: $operation_id"
  [ "$WRITER_OPERATION_ID" = "$operation_id" ] \
    && [ "$WRITER_OPERATION_TASK_CLAIM_ID" = "$CURRENT_CLAIM_ID" ] \
    && [ "$WRITER_CODEBASE_BRANCH" = "$CURRENT_BRANCH" ] \
    || die "writer operation does not bind the current task: $operation_id"
  WRITER_CLONE="$root/.codebases/$WRITER_OWNER"
  WRITER_WORKTREE="$TASK_DIR/$WRITER_OPERATION_EXPECTED_PATH"
  [ -d "$WRITER_CLONE/.git" ] || die "writer codebase cache unavailable: $WRITER_OWNER"
  origin="$(canonical_workspace_origin_url "$root")" || return 1
  WRITER_OPERATION_FILE="$operation"
  WRITER_WORKSPACE_ROOT="$root"
  WRITER_WORKSPACE_ORIGIN="$origin"
  WRITER_OPERATION_LEDGER="$(mktemp "${TMPDIR:-/tmp}/workbench-writer-ledger.XXXXXX")"
  writer_load_remote_ledger "$root" "$origin" "$WRITER_OPERATION_LEDGER" || {
    rm -f "$WRITER_OPERATION_LEDGER"; die "writer coordination unavailable"
  }
  WRITER_COORDINATION_REVISION="$WRITER_OBSERVED_OID"
}

writer_operation_transition_json() {
  local transition="$1" changed="$2" blocker="${3:-}" target_device="${4:-}" target_clone="${5:-}"
  printf '{"contract_version":"workbench-writer-operation-transition/v1","transition":"%s","operation_id":"%s","claim_id":"%s","changed":%s,"operation_stage":"%s","coordination_ref":"%s","coordination_revision":' \
    "$transition" "$(json_escape "$WRITER_OPERATION_ID")" "$(json_escape "$WRITER_CLAIM_ID")" \
    "$changed" "$(json_escape "$WRITER_OPERATION_STAGE")" "$WRITER_COORDINATION_REF"
  json_nullable "${WRITER_COORDINATION_REVISION:-}"
  printf ',"target_device_id":'; json_nullable "$target_device"
  printf ',"target_clone_id":'; json_nullable "$target_clone"
  printf ',"blockers":['
  [ -z "$blocker" ] || printf '{"code":"%s","ref":"%s"}' \
    "$blocker" "$(json_escape "$WRITER_OPERATION_ID")"
  printf ']}\n'
}

writer_persist_operation_transition() {
  git -C "$TASK_DIR" add -A task/index.md task/.workbench/writer-operations \
    task/.workbench/writer-rows 2>/dev/null || return 1
  if ! git -C "$TASK_DIR" diff --cached --quiet; then
    git -C "$TASK_DIR" commit -q -m "task: writer-operation $1 $WRITER_OPERATION_ID" || return 1
  fi
  git -C "$TASK_DIR" push -q origin "$CURRENT_BRANCH"
}

writer_worktree_matches_final() {
  writer_worktree_structure_matches_final \
    && writer_marker_matches "$WRITER_WORKTREE" "$WRITER_CODEBASE_ORIGIN"
}

writer_remove_repo_index_row() {
  local row="- $WRITER_OWNER | $WRITER_CODEBASE_BRANCH | work" file tmp count
  file="$TASK_DIR/task/index.md"; tmp="$file.tmp.$$"
  count="$(grep -Fxc -- "$row" "$file" || true)"
  [ "$count" = 1 ] || return 1
  awk -v row="$row" '$0 != row { print }' "$file" > "$tmp" && mv "$tmp" "$file"
}

cmd_writer_operation_show() {
  local operation_id="$1" format="$2"
  [ "$format" = json ] || die "writer-operation show requires --format json"
  writer_operation_context "$operation_id"
  if ! python3 "$(writer_helper)" operation-status --operation-file "$WRITER_OPERATION_FILE" \
    --ledger-file "$WRITER_OPERATION_LEDGER"; then
    rm -f "$WRITER_OPERATION_LEDGER"; return 1
  fi
  rm -f "$WRITER_OPERATION_LEDGER"
}

cmd_writer_operation_cancel() {
  local operation_id="$1" format="$2" status cancellable
  [ "$format" = json ] || die "writer-operation cancel requires --format json"
  writer_operation_context "$operation_id"
  status="$(python3 "$(writer_helper)" operation-status \
    --operation-file "$WRITER_OPERATION_FILE" --ledger-file "$WRITER_OPERATION_LEDGER")" || {
    rm -f "$WRITER_OPERATION_LEDGER"; writer_operation_transition_json cancel false writer-recovery-blocked; return 1
  }
  cancellable="$(writer_json_query "$status" cancellable)"
  if [ "$WRITER_OPERATION_STAGE" = cancelled ] && [ "$cancellable" = true ]; then
    rm -f "$WRITER_OPERATION_LEDGER"
    writer_operation_transition_json cancel false; return 0
  fi
  if [ "$cancellable" != true ]; then
    rm -f "$WRITER_OPERATION_LEDGER"
    writer_operation_transition_json cancel false writer-cancel-has-effects; return 1
  fi
  writer_operation_update "$WRITER_OPERATION_FILE" --stage cancelled
  writer_load_operation_final "$WRITER_OPERATION_FILE"
  rm -f "$WRITER_OPERATION_LEDGER"
  if ! writer_persist_operation_transition cancel; then
    writer_operation_transition_json cancel true writer-transition-not-durable; return 1
  fi
  writer_operation_transition_json cancel true
}

cmd_writer_operation_handoff() {
  local operation_id="$1" format="$2" target_device="$3" target_clone="$4"
  local row_file next ledger_rc
  [ "$format" = json ] || die "writer-operation handoff requires --format json"
  require_single_line to_device_id "$target_device"
  printf '%s\n' "$target_clone" | grep -Eq \
    '^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$' \
    || die "invalid handoff clone id: $target_clone"
  writer_operation_context "$operation_id"
  if [ "$WRITER_OPERATION_STAGE" = handoff-ready ]; then
    if [ "$WRITER_DEVICE_ID" = "$target_device" ] && [ "$WRITER_CLONE_ID" = "$target_clone" ] \
      && python3 "$(writer_helper)" operation-status --operation-file "$WRITER_OPERATION_FILE" \
        --ledger-file "$WRITER_OPERATION_LEDGER" >/dev/null; then
      rm -f "$WRITER_OPERATION_LEDGER"
      writer_operation_transition_json handoff false "" "$target_device" "$target_clone"; return 0
    fi
    rm -f "$WRITER_OPERATION_LEDGER"
    writer_operation_transition_json handoff false writer-handoff-blocked "$target_device" "$target_clone"; return 1
  fi
  if [ "$WRITER_OPERATION_STAGE" = consumed ]; then
    if [ "$WRITER_RUNTIME_DEVICE_ID" != "$WRITER_DEVICE_ID" ] \
      || [ "$WRITER_RUNTIME_CLONE_ID" != "$WRITER_CLONE_ID" ] \
      || ! writer_consumed_matches_final "$WRITER_OPERATION_LEDGER" "$WRITER_OPERATION_FILE"; then
      rm -f "$WRITER_OPERATION_LEDGER"
      writer_operation_transition_json handoff false writer-handoff-blocked "$target_device" "$target_clone"; return 1
    fi
    [ "$target_device" != "$WRITER_DEVICE_ID" ] || [ "$target_clone" != "$WRITER_CLONE_ID" ] || {
      rm -f "$WRITER_OPERATION_LEDGER"
      writer_operation_transition_json handoff false writer-handoff-blocked "$target_device" "$target_clone"; return 1
    }
    writer_operation_update "$WRITER_OPERATION_FILE" --stage compensation-pending \
      --compensation-target reserved --compensation-reason handoff --compensation-next-step record
    writer_load_operation_final "$WRITER_OPERATION_FILE"
  elif [ "$WRITER_OPERATION_STAGE" != compensation-pending ] \
    || [ "$(writer_json_query "$(cat "$WRITER_OPERATION_FILE")" compensation_reason)" != handoff ]; then
    rm -f "$WRITER_OPERATION_LEDGER"
    writer_operation_transition_json handoff false writer-handoff-blocked "$target_device" "$target_clone"; return 1
  fi

  row_file="$(writer_row_dir)/$WRITER_OWNER.record"
  if [ "$WRITER_OPERATION_RECORD_OWNERSHIP" != none ]; then
    writer_row_matches_final "$row_file" && writer_remove_repo_index_row || {
      rm -f "$WRITER_OPERATION_LEDGER"
      writer_operation_transition_json handoff false writer-handoff-blocked "$target_device" "$target_clone"; return 1
    }
    rm -f "$row_file"
    writer_operation_update "$WRITER_OPERATION_FILE" --repo-record-ownership none \
      --compensation-next-step worktree
    writer_load_operation_final "$WRITER_OPERATION_FILE"
  elif [ -e "$row_file" ] || repos_block | grep -Fqx -- "- $WRITER_OWNER | $WRITER_CODEBASE_BRANCH | work"; then
    rm -f "$WRITER_OPERATION_LEDGER"
    writer_operation_transition_json handoff false writer-handoff-blocked "$target_device" "$target_clone"; return 1
  fi

  if [ "$WRITER_OPERATION_WORKTREE_OWNERSHIP" != none ]; then
    if ! writer_worktree_matches_final \
      || ! git -C "$WRITER_CLONE" worktree remove "$WRITER_WORKTREE" >/dev/null 2>&1; then
      rm -f "$WRITER_OPERATION_LEDGER"
      writer_operation_transition_json handoff false writer-handoff-blocked "$target_device" "$target_clone"; return 1
    fi
    writer_operation_update "$WRITER_OPERATION_FILE" --worktree-ownership none \
      --compensation-next-step effect-owner
    writer_load_operation_final "$WRITER_OPERATION_FILE"
  elif [ -e "$WRITER_WORKTREE" ]; then
    rm -f "$WRITER_OPERATION_LEDGER"
    writer_operation_transition_json handoff false writer-handoff-blocked "$target_device" "$target_clone"; return 1
  fi

  if [ "$WRITER_OPERATION_EFFECT_OWNER_STATE" != released ]; then
    if writer_effect_owner_cas "$WRITER_WORKSPACE_ROOT" "$WRITER_WORKSPACE_ORIGIN" released; then
      :
    else
      ledger_rc=$?; rm -f "$WRITER_OPERATION_LEDGER"
      [ "$ledger_rc" = 2 ] && writer_operation_transition_json handoff false writer-handoff-blocked "$target_device" "$target_clone" \
        || writer_operation_transition_json handoff false writer-lock-unavailable "$target_device" "$target_clone"
      return 1
    fi
    writer_operation_update "$WRITER_OPERATION_FILE" --effect-owner-state released \
      --coordination-oid "$WRITER_COORDINATION_REVISION" --compensation-next-step finish
    writer_load_operation_final "$WRITER_OPERATION_FILE"
  fi

  rm -f "$WRITER_OPERATION_LEDGER"
  WRITER_OPERATION_LEDGER="$(mktemp "${TMPDIR:-/tmp}/workbench-writer-ledger.XXXXXX")"
  writer_load_remote_ledger "$WRITER_WORKSPACE_ROOT" "$WRITER_WORKSPACE_ORIGIN" \
    "$WRITER_OPERATION_LEDGER" || {
    rm -f "$WRITER_OPERATION_LEDGER"
    writer_operation_transition_json handoff false writer-lock-unavailable "$target_device" "$target_clone"; return 1
  }
  next="$WRITER_OPERATION_FILE.handoff.$$"
  if ! python3 "$(writer_helper)" operation-handoff --operation-file "$WRITER_OPERATION_FILE" \
    --ledger-file "$WRITER_OPERATION_LEDGER" --to-device-id "$target_device" \
    --to-clone-id "$target_clone" --output "$next"; then
    rm -f "$WRITER_OPERATION_LEDGER" "$next"
    writer_operation_transition_json handoff false writer-handoff-blocked "$target_device" "$target_clone"; return 1
  fi
  mv "$next" "$WRITER_OPERATION_FILE"
  writer_load_operation_final "$WRITER_OPERATION_FILE"
  WRITER_COORDINATION_REVISION="$WRITER_OBSERVED_OID"
  rm -f "$WRITER_OPERATION_LEDGER"
  if ! writer_persist_operation_transition handoff; then
    writer_operation_transition_json handoff true writer-transition-not-durable "$target_device" "$target_clone"; return 1
  fi
  writer_operation_transition_json handoff true "" "$target_device" "$target_clone"
}

cmd_writer_operation() {
  local subcommand="${1:-}" operation_id="" format="" target_device="" target_clone=""
  [ -n "$subcommand" ] || die "usage: workbench task writer-operation show|cancel|handoff ..."
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --operation-id) operation_id="$2"; shift 2 ;;
      --format) format="$2"; shift 2 ;;
      --to-device-id) target_device="$2"; shift 2 ;;
      --to-clone-id) target_clone="$2"; shift 2 ;;
      *) die "unknown writer-operation option: $1" ;;
    esac
  done
  [ -n "$operation_id" ] || die "writer-operation requires --operation-id"
  require_task_worktree; require_v2_task
  case "$subcommand" in
    show) [ -z "$target_device$target_clone" ] || die "show does not accept a handoff target"
      cmd_writer_operation_show "$operation_id" "$format" ;;
    cancel) [ -z "$target_device$target_clone" ] || die "cancel does not accept a handoff target"
      require_mutable_task task.writer-operation.cancel || return 1
      cmd_writer_operation_cancel "$operation_id" "$format" ;;
    handoff) [ -n "$target_device" ] && [ -n "$target_clone" ] \
        || die "handoff requires --to-device-id and --to-clone-id"
      require_mutable_task task.writer-operation.handoff || return 1
      cmd_writer_operation_handoff "$operation_id" "$format" "$target_device" "$target_clone" ;;
    *) die "unknown writer-operation command: $subcommand" ;;
  esac
}

# ── v2 task state ──────────────────────────────────────────────────────

task_state_dir() { printf '%s/task/.workbench\n' "$TASK_DIR"; }
deliverable_dir() { printf '%s/deliverables\n' "$(task_state_dir)"; }
acceptance_dir() { printf '%s/acceptances\n' "$(task_state_dir)"; }
acceptance_attempt_dir() { printf '%s/acceptance-attempts\n' "$(task_state_dir)"; }
evidence_dir() { printf '%s/evidence\n' "$(task_state_dir)"; }
required_check_dir() { printf '%s/required-checks\n' "$(task_state_dir)"; }
harvest_dir() { printf '%s/harvest\n' "$(task_state_dir)"; }

record_get() {
  local file="$1" key="$2"
  sed -n "s/^${key}=//p" "$file" | head -1
}

validate_record_id() {
  local label="$1" value="$2"
  printf '%s' "$value" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]*$' \
    || die "invalid $label: $value"
}

validate_namespaced_ref() {
  local value="$1"
  printf '%s' "$value" | grep -Eq '^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*/[A-Za-z0-9._-]+$' \
    || die "invalid namespaced reference: $value"
}

frontmatter_set() {
  local file="$1" key="$2" value="$3" tmp
  tmp="$file.tmp.$$"
  awk -v key="$key" -v value="$value" '
    BEGIN { separators=0; replaced=0 }
    /^---$/ {
      separators++
      if (separators == 2 && !replaced) { print key ": " value; replaced=1 }
      print
      next
    }
    separators == 1 && index($0, key ":") == 1 {
      print key ": " value
      replaced=1
      next
    }
    { print }
  ' "$file" > "$tmp" && mv "$tmp" "$file"
}

frontmatter_delete() {
  local file="$1" key="$2" tmp
  tmp="$file.tmp.$$"
  awk -v key="$key" '
    BEGIN { separators=0 }
    /^---$/ { separators++; print; next }
    separators == 1 && index($0, key ":") == 1 { next }
    { print }
  ' "$file" > "$tmp" && mv "$tmp" "$file"
}

print_refs_json() {
  local changed="$1" context_ref work_ref task_contract
  context_ref="$(index_get context_ref)"; work_ref="$(index_get work_ref)"
  task_contract="$(index_get task_contract)"; [ -n "$task_contract" ] || task_contract=workbench-task/v1
  printf '{"contract_version":"workbench-task-refs/v1","task_contract":"%s","context_ref":' "$task_contract"
  json_nullable "$context_ref"; printf ',"work_ref":'; json_nullable "$work_ref"
  printf ',"changed":%s}\n' "$changed"
}

task_terminal_outcome() {
  local root="$1" home="$2" issue="$3" branch="$4" dir="$5" terminal latest event
  local task_contract claim outcome expected
  terminal="$dir/task/.workbench/terminal"
  task_contract="$(sed -n '/^---$/,/^---$/p' "$dir/task/index.md" 2>/dev/null | \
    sed -n 's/^task_contract: *//p' | head -1)"
  if [ "$task_contract" = workbench-task/v2 ]; then
    [ -f "$terminal" ] || return 1
    claim="$(sed -n '/^---$/,/^---$/p' "$dir/task/index.md" | sed -n 's/^claim_id: *//p' | head -1)"
    python3 "$(terminal_helper)" terminal-validate --task-dir "$dir" \
      --terminal-file "$terminal" --claim-id "$claim" --now "$(utc_now)" \
      --format quiet >/dev/null 2>&1 || return 1
    outcome="$(record_get "$terminal" outcome)"; expected="task-$outcome"
    terminal_lifecycle_state "$root" "$home" "$issue" "$branch" "$claim" \
      "$(sed -n '/^---$/,/^---$/p' "$dir/task/index.md" | \
        sed -n 's/^workspace_authority_descriptor_digest: *//p' | head -1)" "$terminal" || return 1
    printf '%s\n' "$outcome"
    return 0
  fi
  latest="$(lifecycle_latest_for_branch "$root" "$home" "$issue" "$branch")" || return 1
  event="$(lifecycle_field "$latest" event)"
  case "$event" in
    task-completed) printf '%s\n' completed ;;
    task-abandoned) printf '%s\n' abandoned ;;
    *) return 1 ;;
  esac
}

local_duplicate_active_work_ref() {
  local value="$1" root other other_value home issue branch outcome
  root="$(wb_root)"
  for other in "$root"/.worktrees/task__*/task/index.md; do
    [ -f "$other" ] || continue
    [ "$other" = "$TASK_DIR/task/index.md" ] && continue
    branch="$(sed -n '/^---$/,/^---$/p' "$other" | sed -n 's/^branch: *//p' | head -1)"
    python3 "$(lifecycle_helper)" task-index --file "$other" --branch "$branch" \
      --format json >/dev/null 2>&1 || return 2
    other_value="$(sed -n '/^---$/,/^---$/p' "$other" | sed -n 's/^work_ref: *//p' | head -1)"
    [ "$other_value" = "$value" ] || continue
    home="$(sed -n '/^---$/,/^---$/p' "$other" | sed -n 's/^home: *//p' | head -1)"
    issue="$(sed -n '/^---$/,/^---$/p' "$other" | sed -n 's/^issue: *//p' | head -1)"
    if ! outcome="$(task_terminal_outcome "$root" "$home" "$issue" "$branch" "${other%/task/index.md}")"; then
      printf '%s\n' "$branch"
      return 0
    fi
  done
  return 1
}

authoritative_active_task_inventory() {
  local output="$1" root legacy observation adapter legacy_util default_branch
  root="$(wb_root)"
  observe_workspace_authority "$root" "$(index_get workspace_authority_descriptor_digest)"
  legacy="$(mktemp "${TMPDIR:-/tmp}/workbench-active-legacy.XXXXXX")"
  observation="$(mktemp "${TMPDIR:-/tmp}/workbench-active-observation.XXXXXX")"
  legacy_util="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/legacy-inventory"
  adapter="${WORKBENCH_TRUSTED_HOSTING_ADAPTER:-}"
  default_branch="${AUTHORITY_DEFAULT_REF#refs/heads/}"
  [ "refs/heads/$default_branch" = "$AUTHORITY_DEFAULT_REF" ] \
    || { rm -f "$legacy" "$observation"; return 1; }
  if [ -z "$adapter" ] || [ ! -x "$adapter" ] \
    || ! "$legacy_util" show --format json > "$legacy" 2>/dev/null \
    || ! "$adapter" active-tasks --repository "$root" \
      --legacy-inventory-file "$legacy" --default-revision "$AUTHORITY_REVISION" \
      --default-ref "$default_branch" \
      --format json > "$observation" 2>/dev/null \
    || ! python3 "$(lifecycle_helper)" active-inventory \
      --observation-file "$observation" --legacy-inventory-file "$legacy" \
      --repository "$root" --workspace-origin-url "$AUTHORITY_ORIGIN_URL" \
      --workspace-home "$AUTHORITY_WORKSPACE_HOME" \
      --default-ref "$AUTHORITY_DEFAULT_REF" \
      --default-revision "$AUTHORITY_REVISION" \
      --descriptor-digest "$AUTHORITY_DESCRIPTOR_DIGEST" > "$output" 2>/dev/null; then
    rm -f "$legacy" "$observation"; return 1
  fi
  rm -f "$legacy" "$observation"
}

authoritative_duplicate_active_work_ref() {
  local value="$1" inventory projection count branch
  inventory="$(mktemp "${TMPDIR:-/tmp}/workbench-active-inventory.XXXXXX")"
  authoritative_active_task_inventory "$inventory" \
    || { rm -f "$inventory"; return 2; }
  projection="$(python3 "$(writer_helper)" work-ref-conflict \
    --inventory-file "$inventory" --work-ref "$value" \
    --current-claim-id "$(index_get claim_id)" 2>/dev/null)" \
    || { rm -f "$inventory"; return 2; }
  rm -f "$inventory"
  count="$(printf '%s\n' "$projection" | python3 -c \
    'import json,sys; print(len(json.load(sys.stdin)["conflicts"]))')" || return 2
  [ "$count" -gt 0 ] || return 1
  branch="$(printf '%s\n' "$projection" | python3 -c \
    'import json,sys; print(json.load(sys.stdin)["conflicts"][0]["branch"])')" || return 2
  printf '%s\n' "$branch"
}

cmd_refs() {
  local sub="${1:-}"; [ $# -gt 0 ] && shift || true
  case "$sub" in
    show)
      local format=""
      while [ $# -gt 0 ]; do
        case "$1" in --format) format="$2"; shift 2 ;; *) die "unknown option: $1" ;; esac
      done
      [ "$format" = json ] || die "unsupported format: ${format:-none}"
      require_task_worktree
      [ -f "$TASK_DIR/task/index.md" ] || die "task/index.md not found"
      print_refs_json false
      ;;
    set)
      local context_ref="" work_ref="" set_context="" set_work="" clear_context="" clear_work=""
      local duplicate format="" changed=false duplicate_rc
      while [ $# -gt 0 ]; do
        case "$1" in
          --context-ref) context_ref="$2"; set_context=1; shift 2 ;;
          --work-ref) work_ref="$2"; set_work=1; shift 2 ;;
          --clear-context-ref) clear_context=1; shift ;;
          --clear-work-ref) clear_work=1; shift ;;
          --format) format="$2"; shift 2 ;;
          *) die "unknown option: $1" ;;
        esac
      done
      [ "$format" = json ] || die "unsupported format: ${format:-none}"
      [ -n "$set_context$set_work$clear_context$clear_work" ] || die "refs set requires a set or clear option"
      [ -z "$set_context$clear_context" ] || [ -z "$set_context" ] || [ -z "$clear_context" ] || die "context set and clear are mutually exclusive"
      [ -z "$set_work$clear_work" ] || [ -z "$set_work" ] || [ -z "$clear_work" ] || die "work set and clear are mutually exclusive"
      require_v2_task
      require_mutable_task task.refs.set || return 1
      if [ -n "$set_context$clear_context" ] \
        && [ -f "$(task_state_dir)/policy-context/state.record" ] \
        && [ "$(record_get "$(task_state_dir)/policy-context/state.record" sealed)" = true ]; then
        die "policy-context-immutable"
      fi
      if [ -n "$set_context" ]; then validate_namespaced_ref "$context_ref"; fi
      if [ -n "$set_work" ]; then
        validate_namespaced_ref "$work_ref"
        if duplicate="$(authoritative_duplicate_active_work_ref "$work_ref")"; then
          die "duplicate active work_ref: $work_ref ($duplicate)"
        else
          duplicate_rc=$?
          [ "$duplicate_rc" -eq 1 ] || die "active-task-inventory-unavailable"
        fi
        if duplicate="$(local_duplicate_active_work_ref "$work_ref")"; then
          die "duplicate active work_ref: $work_ref ($duplicate)"
        else
          duplicate_rc=$?
          [ "$duplicate_rc" -eq 1 ] || die "active-task-local-identity-unreconciled"
        fi
      fi
      if [ -n "$set_context" ] && [ "$(index_get context_ref)" != "$context_ref" ]; then
        frontmatter_set "$TASK_DIR/task/index.md" context_ref "$context_ref"; changed=true
      elif [ -n "$clear_context" ] && [ -n "$(index_get context_ref)" ]; then
        frontmatter_delete "$TASK_DIR/task/index.md" context_ref; changed=true
      fi
      if [ -n "$set_work" ] && [ "$(index_get work_ref)" != "$work_ref" ]; then
        frontmatter_set "$TASK_DIR/task/index.md" work_ref "$work_ref"; changed=true
      elif [ -n "$clear_work" ] && [ -n "$(index_get work_ref)" ]; then
        frontmatter_delete "$TASK_DIR/task/index.md" work_ref; changed=true
      fi
      print_refs_json "$changed"
      ;;
    *) die "usage: workbench task refs show|set ..." ;;
  esac
}

policy_context_projection_shell() {
  local registration_file="$1" sealed="$2" changed="$3"
  local output line key value args=(context-set --registration-file "$registration_file" \
    --workspace-root "$TASK_DIR" --sealed "$sealed" --changed "$changed" --format shell)
  output="$(python3 "$(contract_helper)" "${args[@]}")" \
    || die "policy-source-tampered"
  POLICY_CONTEXT_DIGEST=""; POLICY_CONTEXT_REGISTRATION_REF=""
  POLICY_CONTEXT_REGISTRATION_DIGEST=""; POLICY_CONTEXT_REGISTRATION_JSON=""
  while IFS= read -r line; do
    key="${line%%=*}"; value="${line#*=}"
    case "$key" in
      digest) POLICY_CONTEXT_DIGEST="$value" ;;
      registration_ref) POLICY_CONTEXT_REGISTRATION_REF="$value" ;;
      registration_digest) POLICY_CONTEXT_REGISTRATION_DIGEST="$value" ;;
      registration_json) POLICY_CONTEXT_REGISTRATION_JSON="$value" ;;
    esac
  done <<< "$output"
  [ -n "$POLICY_CONTEXT_DIGEST" ] && [ -n "$POLICY_CONTEXT_REGISTRATION_JSON" ] \
    || die "invalid context policy projection"
}

write_policy_context_state() {
  local file="$1" registration_ref="$2" registration_digest="$3" task_context_ref="$4"
  local sealed="$5" digest="$6" registration_action="$7" registration_intent="$8"
  local registration_manifest="$9" registration_authorization="${10}" seal_action="${11}"
  local seal_intent="${12}" seal_manifest="${13}" seal_authorization="${14}"
  local registered_at="${15}" sealed_at="${16}" tmp
  tmp="$file.tmp.$$"
  {
    printf 'registration_ref=%s\n' "$registration_ref"
    printf 'registration_digest=%s\n' "$registration_digest"
    printf 'task_context_ref=%s\n' "$task_context_ref"
    printf 'sealed=%s\n' "$sealed"
    printf 'digest=%s\n' "$digest"
    printf 'registration_action_instance_id=%s\n' "$registration_action"
    printf 'registration_intent_digest=%s\n' "$registration_intent"
    printf 'registration_policy_manifest_digest=%s\n' "$registration_manifest"
    printf 'registration_authorization_ref=%s\n' "$registration_authorization"
    printf 'seal_action_instance_id=%s\n' "$seal_action"
    printf 'seal_intent_digest=%s\n' "$seal_intent"
    printf 'seal_policy_manifest_digest=%s\n' "$seal_manifest"
    printf 'seal_authorization_ref=%s\n' "$seal_authorization"
    printf 'registered_at=%s\n' "$registered_at"
    printf 'sealed_at=%s\n' "$sealed_at"
  } > "$tmp" && mv "$tmp" "$file"
}

print_policy_context_projection() {
  local registration_file="$1" sealed="$2" changed="$3" state_file="${4:-}"
  local args=(context-set --registration-file "$registration_file" --workspace-root "$TASK_DIR" \
    --sealed "$sealed" --changed "$changed" --format json)
  if [ -n "$state_file" ] && [ -f "$state_file" ]; then
    local field option value
    while IFS=$'\t' read -r field option; do
      value="$(record_get "$state_file" "$field")"
      [ -z "$value" ] || args+=("$option" "$value")
    done <<'EOF'
registration_action_instance_id	--registration-action-instance-id
registration_intent_digest	--registration-intent-digest
registration_policy_manifest_digest	--registration-policy-manifest-digest
registration_authorization_ref	--registration-authorization-ref
seal_action_instance_id	--seal-action-instance-id
seal_intent_digest	--seal-intent-digest
seal_policy_manifest_digest	--seal-policy-manifest-digest
seal_authorization_ref	--seal-authorization-ref
EOF
  fi
  python3 "$(contract_helper)" "${args[@]}" \
    || die "policy-source-tampered"
}

create_auto_null_policy_context() {
  local dir state at output line key value registration_json="" digest="" registration_ref="" registration_digest=""
  dir="$(task_state_dir)/policy-context"; state="$dir/state.record"; at="$(utc_now)"
  output="$(python3 "$(contract_helper)" context-set --auto-null \
    --task-claim-id "$(index_get claim_id)" --at "$at" --sealed true --changed true --format shell)" \
    || die "invalid auto-null context policy set"
  while IFS= read -r line; do
    key="${line%%=*}"; value="${line#*=}"
    case "$key" in
      digest) digest="$value" ;; registration_ref) registration_ref="$value" ;;
      registration_digest) registration_digest="$value" ;; registration_json) registration_json="$value" ;;
    esac
  done <<< "$output"
  mkdir -p "$dir"; printf '%s\n' "$registration_json" > "$dir/registration.json"
  write_policy_context_state "$state" "$registration_ref" "$registration_digest" "" true \
    "$digest" "" "" "" "" "" "" "" "" "$at" "$at"
  python3 "$(contract_helper)" context-set --auto-null --task-claim-id "$(index_get claim_id)" \
    --at "$at" --sealed true --changed true --format json
}

recover_policy_context_effect() {
  local kind="$1" supplied_instance="$2" dir state registration action_field sealed action_id
  local action_file request_file result decision primary_digest target revision intent status
  local -a reduce_args
  dir="$(task_state_dir)/policy-context"; state="$dir/state.record"
  registration="$dir/registration.json"
  [ -f "$state" ] && [ -f "$registration" ] || return 10
  sealed="$(record_get "$state" sealed)"
  case "$kind" in
    register) action_field=registration_action_instance_id ;;
    seal) action_field=seal_action_instance_id; [ "$sealed" = true ] || return 10 ;;
    *) return 10 ;;
  esac
  action_id="$(record_get "$state" "$action_field")"
  [ -n "$action_id" ] || return 10
  [ -z "$supplied_instance" ] || [ "$supplied_instance" = "$action_id" ] || return 10
  action_file="$(task_state_dir)/actions/$action_id.record"
  request_file="$(task_state_dir)/actions/$action_id.request.json"
  [ -f "$action_file" ] && [ -f "$request_file" ] || {
    printf '{"contract_version":"workbench-error/v1","operation":"task.policy-context.%s","blockers":[{"code":"action-effect-unreconciled","ref":"%s"}]}\n' \
      "$kind" "$(json_escape "$action_id")"
    return 1
  }
  policy_context_projection_shell "$registration" "$sealed" false
  [ "$(record_get "$state" registration_ref)" = "$POLICY_CONTEXT_REGISTRATION_REF" ] \
    && [ "$(record_get "$state" registration_digest)" = "$POLICY_CONTEXT_REGISTRATION_DIGEST" ] \
    && [ "$(record_get "$state" task_context_ref)" = "$(index_get context_ref)" ] \
    && [ "$(record_get "$state" digest)" = "$POLICY_CONTEXT_DIGEST" ] || {
      printf '{"contract_version":"workbench-error/v1","operation":"task.policy-context.%s","blockers":[{"code":"action-effect-unreconciled","ref":"%s"}]}\n' \
        "$kind" "$(json_escape "$action_id")"
      return 1
    }
  status="$(record_get "$action_file" status)"
  if [ "$kind" = register ] && [ "$sealed" = true ] && [ "$status" = consumed ]; then
    print_policy_context_projection "$registration" true false "$state"
    return 0
  fi
  reduce_args=(reduce-files --action-file "$action_file" --request-file "$request_file" \
    --primary-file "$state" --primary-kind "context-$kind" --secondary-state exact)
  [ "$kind" != register ] || reduce_args+=(--mandatory-authorization)
  result="$(python3 "$(effect_helper)" "${reduce_args[@]}")" || return 1
  decision="$(json_string_field "$result" decision)"
  [ "$decision" != blocked ] || { printf '%s\n' "$result"; return 1; }
  if [ "$decision" = idempotent ]; then
    print_policy_context_projection "$registration" "$sealed" false "$state"
    return 0
  fi
  [ "$decision" = reconcile ] || return 10
  primary_digest="$(json_string_field "$result" primary_digest)"
  target="$(record_get "$action_file" target_ref)"
  revision="$(record_get "$action_file" revision)"
  intent="$(record_get "$action_file" intent_digest)"
  consume_governed_action "task.policy-context.$kind" "$target" "$revision" "$action_id" \
    "$intent" "$primary_digest" || return 1
  print_policy_context_projection "$registration" "$sealed" true "$state"
}

cmd_policy_context() {
  local sub="${1:-}"; [ $# -gt 0 ] && shift || true
  local format="" registration_file="" instance_id="" authorization_file=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --registration-file) registration_file="$2"; shift 2 ;;
      --action-instance-id) instance_id="$2"; shift 2 ;;
      --authorization-file) authorization_file="$2"; shift 2 ;;
      --format) format="$2"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [ "$format" = json ] || die "policy-context requires --format json"
  require_v2_task; require_mutable_task "task.policy-context.$sub" || return 1
  current_task_identity
  local dir state stored_registration context_ref parsed line key value
  local registration_id="" registration_digest="" registration_json="" actor="" registered_at=""
  local target revision old_state action_file auth_actor auth_at payload_file
  local manifest_digest authorization_ref primary_digest
  dir="$(task_state_dir)/policy-context"; state="$dir/state.record"; stored_registration="$dir/registration.json"
  context_ref="$(index_get context_ref)"; target="workbench:task/$CURRENT_CLAIM_ID"
  case "$sub" in
    show)
      if [ ! -f "$state" ]; then
        printf '{"contract_version":"workbench-context-policy-set/v1","task_contract":"workbench-task/v2","task_claim_id":"%s","task_context_ref":' \
          "$(json_escape "$CURRENT_CLAIM_ID")"
        json_nullable "$context_ref"
        printf ',"sealed":false,"changed":false,"digest":null,"registration_ref":null,"registration_digest":null,"registration_action_instance_id":null,"registration_intent_digest":null,"registration_policy_manifest_digest":null,"registration_authorization_ref":null,"seal_action_instance_id":null,"seal_intent_digest":null,"seal_policy_manifest_digest":null,"seal_authorization_ref":null,"participants":[],"task_policy":null}\n'
      else
        [ -f "$stored_registration" ] || die "policy-source-tampered"
        if [ "$(record_get "$state" registration_ref)" = "workbench:context-registration/auto-null/$CURRENT_CLAIM_ID" ]; then
          python3 "$(contract_helper)" context-set --auto-null --task-claim-id "$CURRENT_CLAIM_ID" \
            --at "$(record_get "$state" registered_at)" --sealed "$(record_get "$state" sealed)" \
            --changed false --format json
        else
          print_policy_context_projection "$stored_registration" "$(record_get "$state" sealed)" false "$state"
        fi
      fi
      ;;
    register)
      [ -n "$registration_file" ] && [ -f "$registration_file" ] \
        || die "policy-context register requires --registration-file"
      [ -n "$context_ref" ] || die "null context does not accept registration"
      if [ -f "$state" ]; then
        if recover_policy_context_effect register "$instance_id"; then return 0
        else
          local recovery_rc=$?
          [ "$recovery_rc" = 10 ] || return "$recovery_rc"
        fi
      fi
      [ ! -f "$state" ] || die "policy context is already registered"
      parsed="$(python3 "$(contract_helper)" registration "$registration_file" \
        --workspace-root "$TASK_DIR")" || die "invalid context policy registration"
      while IFS= read -r line; do
        key="${line%%=*}"; value="${line#*=}"
        case "$key" in registration_id) registration_id="$value" ;; registration_digest) registration_digest="$value" ;;
          task_claim_id) [ "$value" = "$CURRENT_CLAIM_ID" ] || die "registration task claim mismatch" ;;
          task_context_ref) [ "$value" = "$context_ref" ] || die "registration task context mismatch" ;;
          actor) actor="$value" ;; registered_at) registered_at="$value" ;; registration_json) registration_json="$value" ;;
        esac
      done <<< "$parsed"
      revision="$registration_digest"
      payload_file="$(mktemp "${TMPDIR:-/tmp}/workbench-context-registration.XXXXXX")"
      printf '%s\n' "$registration_json" > "$payload_file"
      resolve_governed_action task.policy-context.register "$target" "$revision" "$instance_id" \
        "$authorization_file" workbench-context-policy-registration/v1 "$payload_file"
      rm -f "$payload_file"
      case "$GOVERNED_POLICY_RC" in
        0) ;;
        3|4) printf '%s\n' "$GOVERNED_POLICY_OUTPUT"; return "$GOVERNED_POLICY_RC" ;;
        *) return "$GOVERNED_POLICY_RC" ;;
      esac
      action_file="$(task_state_dir)/actions/$GOVERNED_ACTION_INSTANCE_ID.record"
      auth_actor="$(record_get "$action_file" authorization_actor)"; auth_at="$(record_get "$action_file" authorization_at)"
      [ "$auth_actor" = "$actor" ] && [ "$auth_at" = "$registered_at" ] \
        || die "registration authorization actor or timestamp mismatch"
      mkdir -p "$dir"; printf '%s\n' "$registration_json" > "$stored_registration"
      policy_context_projection_shell "$stored_registration" false true
      manifest_digest="$(record_get "$action_file" policy_manifest_digest)"
      authorization_ref="$(record_get "$action_file" authorization_ref)"
      write_policy_context_state "$state" "$POLICY_CONTEXT_REGISTRATION_REF" \
        "$POLICY_CONTEXT_REGISTRATION_DIGEST" "$context_ref" false "$POLICY_CONTEXT_DIGEST" \
        "$GOVERNED_ACTION_INSTANCE_ID" "$GOVERNED_INTENT_DIGEST" "$manifest_digest" \
        "$authorization_ref" "" "" "" "" "$registered_at" ""
      primary_digest="$(digest_manifest "$state")"
      if [ "${WORKBENCH_TEST_FAIL_AFTER_CONTEXT_PRIMARY:-}" = register ]; then
        return 1
      fi
      if ! consume_governed_action task.policy-context.register "$target" "$revision" \
        "$GOVERNED_ACTION_INSTANCE_ID" "$GOVERNED_INTENT_DIGEST" "$primary_digest"; then
        rm -rf "$dir"; return 1
      fi
      print_policy_context_projection "$stored_registration" false true "$state"
      ;;
    seal)
      [ -z "$registration_file" ] || die "policy-context seal does not accept registration input"
      if [ ! -f "$state" ]; then
        [ -z "$context_ref" ] || die "policy-context-unsealed"
        create_auto_null_policy_context; return 0
      fi
      [ -f "$stored_registration" ] || die "policy-source-tampered"
      if [ -n "$(record_get "$state" seal_action_instance_id)" ]; then
        if recover_policy_context_effect seal "$instance_id"; then return 0
        else
          local recovery_rc=$?
          [ "$recovery_rc" = 10 ] || return "$recovery_rc"
        fi
      fi
      if [ "$(record_get "$state" sealed)" = true ]; then
        if [ "$(record_get "$state" registration_ref)" = "workbench:context-registration/auto-null/$CURRENT_CLAIM_ID" ]; then
          python3 "$(contract_helper)" context-set --auto-null --task-claim-id "$CURRENT_CLAIM_ID" \
            --at "$(record_get "$state" registered_at)" --sealed true --changed false --format json
        else
          print_policy_context_projection "$stored_registration" true false "$state"
        fi
        return 0
      fi
      policy_context_projection_shell "$stored_registration" false false
      revision="$POLICY_CONTEXT_DIGEST"
      payload_file="$(mktemp "${TMPDIR:-/tmp}/workbench-context-set.XXXXXX")"
      print_policy_context_projection "$stored_registration" true false "$state" > "$payload_file"
      resolve_governed_action task.policy-context.seal "$target" "$revision" "$instance_id" \
        "$authorization_file" workbench-context-policy-set/v1 "$payload_file"
      rm -f "$payload_file"
      case "$GOVERNED_POLICY_RC" in
        0) ;;
        3|4) printf '%s\n' "$GOVERNED_POLICY_OUTPUT"; return "$GOVERNED_POLICY_RC" ;;
        *) return "$GOVERNED_POLICY_RC" ;;
      esac
      old_state="$(cat "$state")"
      action_file="$(task_state_dir)/actions/$GOVERNED_ACTION_INSTANCE_ID.record"
      manifest_digest="$(record_get "$action_file" policy_manifest_digest)"
      authorization_ref="$(record_get "$action_file" authorization_ref)"
      write_policy_context_state "$state" "$(record_get "$state" registration_ref)" \
        "$(record_get "$state" registration_digest)" "$context_ref" true "$revision" \
        "$(record_get "$state" registration_action_instance_id)" \
        "$(record_get "$state" registration_intent_digest)" \
        "$(record_get "$state" registration_policy_manifest_digest)" \
        "$(record_get "$state" registration_authorization_ref)" \
        "$GOVERNED_ACTION_INSTANCE_ID" "$GOVERNED_INTENT_DIGEST" "$manifest_digest" \
        "$authorization_ref" "$(record_get "$state" registered_at)" "$(utc_now)"
      primary_digest="$(digest_manifest "$state")"
      if [ "${WORKBENCH_TEST_FAIL_AFTER_CONTEXT_PRIMARY:-}" = seal ]; then
        return 1
      fi
      if ! consume_governed_action task.policy-context.seal "$target" "$revision" \
        "$GOVERNED_ACTION_INSTANCE_ID" "$GOVERNED_INTENT_DIGEST" "$primary_digest"; then
        printf '%s\n' "$old_state" > "$state"; return 1
      fi
      print_policy_context_projection "$stored_registration" true true "$state"
      ;;
    *) die "usage: workbench task policy-context register|seal|show ..." ;;
  esac
}

