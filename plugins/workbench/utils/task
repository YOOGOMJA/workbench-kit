recover_pack_acceptance() {
  local deliverable_file="$1" deliverable_id="$2" supplied_instance="$3"
  local acceptance_file action_file request_file action_id status acceptance_ref secondary
  local result decision primary_digest intent target revision required owner kind owner_context_ref
  local acceptance_authority_ref external_ref candidate_instance
  local -a primaries=() reduce_args
  for acceptance_file in "$(acceptance_dir)"/*.record; do
    [ -f "$acceptance_file" ] || continue
    [ "$(record_get "$acceptance_file" deliverable_id)" = "$deliverable_id" ] || continue
    candidate_instance="$(record_get "$acceptance_file" action_instance_id)"
    [ -n "$candidate_instance" ] || continue
    [ -z "$supplied_instance" ] || [ "$candidate_instance" = "$supplied_instance" ] || continue
    action_file="$(task_state_dir)/actions/$candidate_instance.record"
    [ -f "$action_file" ] || {
      printf '{"contract_version":"workbench-error/v1","operation":"task.deliverable.accept","blockers":[{"code":"action-effect-unreconciled","ref":"%s"}]}\n' \
        "$(json_escape "$candidate_instance")"
      return 1
    }
    status="$(record_get "$action_file" status)"
    [ -n "$supplied_instance" ] || [ "$status" != consumed ] || continue
    primaries+=("$acceptance_file")
  done
  [ "${#primaries[@]}" -gt 0 ] || return 10
  action_id="$(record_get "${primaries[0]}" action_instance_id)"
  action_file="$(task_state_dir)/actions/$action_id.record"
  request_file="$(task_state_dir)/actions/$action_id.request.json"
  acceptance_ref="workbench:acceptance/$(record_get "${primaries[0]}" acceptance_id)"
  if [ -z "$(record_get "$deliverable_file" acceptance_ref)" ]; then secondary=missing
  elif [ "$(record_get "$deliverable_file" acceptance_ref)" = "$acceptance_ref" ] \
    && [ "$(record_get "$deliverable_file" state)" = accepted ]; then secondary=exact
  else secondary=incompatible
  fi
  reduce_args=(reduce-files --action-file "$action_file" --request-file "$request_file" \
    --secondary-state "$secondary" --mandatory-authorization)
  for acceptance_file in "${primaries[@]}"; do reduce_args+=(--primary-file "$acceptance_file"); done
  result="$(python3 "$(effect_helper)" "${reduce_args[@]}")" || {
    printf '{"contract_version":"workbench-error/v1","operation":"task.deliverable.accept","blockers":[{"code":"action-effect-unreconciled","ref":"%s"}]}\n' \
      "$(json_escape "$action_id")"
    return 1
  }
  decision="$(json_string_field "$result" decision)"
  [ "$decision" != blocked ] || { printf '%s\n' "$result"; return 1; }
  if [ "$decision" = idempotent ]; then
    [ "$secondary" = exact ] || return 10
    print_deliverable_acceptance_json false "$deliverable_file" "${primaries[0]}"
    return 0
  fi
  [ "$decision" = reconcile ] || return 10

  owner="$(record_get "$deliverable_file" owner)"; kind="$(record_get "$deliverable_file" kind)"
  owner_context_ref="$(record_get "$deliverable_file" owner_context_ref)"
  acceptance_authority_ref="$(record_get "$deliverable_file" acceptance_authority_ref)"
  required="$(record_get "$deliverable_file" required)"
  external_ref="$(record_get "$deliverable_file" external_ref)"
  revision="$(record_get "$deliverable_file" revision)"
  if printf '%s' "$result" | grep -Fq '"write_secondary":true'; then
    write_deliverable_record "$deliverable_file" "$deliverable_id" "$owner" "$kind" \
      "$owner_context_ref" "$acceptance_authority_ref" "$required" "$external_ref" \
      "$revision" accepted "$acceptance_ref"
  fi
  primary_digest="$(json_string_field "$result" primary_digest)"
  intent="$(record_get "${primaries[0]}" intent_digest)"
  target="$(record_get "$action_file" target_ref)"; revision="$(record_get "$action_file" revision)"
  current_task_identity
  consume_governed_action task.deliverable.accept "$target" "$revision" "$action_id" \
    "$intent" "$primary_digest" || return 1
  print_deliverable_acceptance_json true "$deliverable_file" "${primaries[0]}"
  return 0
}

