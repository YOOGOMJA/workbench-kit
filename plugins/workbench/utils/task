probe_kernel_deliverable() {
  local file="$1" owner external revision expected_repository state head merge observed helper
  owner="$(record_get "$file" owner)"; external="$(record_get "$file" external_ref)"
  revision="$(record_get "$file" revision)"; [ -n "$revision" ] || return 1
  [[ "$external" =~ ^https://github.com/([^/]+)/([^/]+)/pull/([0-9]+)$ ]] || return 1
  PROBE_REPOSITORY="${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"; PROBE_NUMBER="${BASH_REMATCH[3]}"
  expected_repository="$(registered_github_repository "$owner" || true)"
  [ -n "$expected_repository" ] && [ "$expected_repository" = "$PROBE_REPOSITORY" ] || return 1
  IFS=$'\t' read -r state head merge <<EOF
$(gh pr view "$external" --json state,headRefOid,mergeCommit --jq '[.state,.headRefOid,.mergeCommit.oid] | @tsv' 2>/dev/null || true)
EOF
  [ "$state" = MERGED ] && [ "$head" = "$revision" ] && [ -n "$merge" ] || return 1
  observed="$(utc_now)"; helper="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)/workbench_contract.py"
  PROBE_OBSERVED_AT="$observed"
  PROBE_DIGEST="$(python3 "$helper" github-probe --repository "$PROBE_REPOSITORY" \
    --pull-request "$PROBE_NUMBER" --external-ref "$external" --state merged \
    --head-revision "$head" --merge-revision "$merge" --observed-at "$observed" --format digest)" \
    || return 1
  PROBE_SUBJECT_DIGEST="$(python3 "$helper" github-probe --repository "$PROBE_REPOSITORY" \
    --pull-request "$PROBE_NUMBER" --external-ref "$external" --state merged \
    --head-revision "$head" --merge-revision "$merge" --observed-at "$observed" \
    --format subject-digest)" || return 1
}

