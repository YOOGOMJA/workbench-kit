  git -C "$clone" worktree list --porcelain -z > "$porcelain" || {
    rm -f "$porcelain"; return 1
  }
  common="$(git -C "$clone" rev-parse --git-common-dir)" || {
    rm -f "$porcelain"; return 1
  }
  case "$common" in /*) ;; *) common="$clone/$common" ;; esac
  digest="$(python3 "$(writer_helper)" worktree-set --porcelain-file "$porcelain" \
    --common-git-dir "$common" --origin-url "$origin" --expected-path "$expected_path" \
    --expected-branch "refs/heads/$expected_branch" --format digest)" || {
    rm -f "$porcelain"; return 1
  }
  rm -f "$porcelain"; printf '%s\n' "$digest"
}

