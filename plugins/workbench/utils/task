      printf ',"action_instance_id":'; json_nullable "$(record_get "$file" action_instance_id)"
      printf ',"intent_digest":'; json_nullable "$(record_get "$file" intent_digest)"
      printf ',"policy_manifest_digest":'; json_nullable "$(record_get "$file" policy_manifest_digest)"
      printf ',"authorization_ref":'
      json_nullable "$(record_get "$file" authorization_ref)"; printf '}'
    else printf 'null'; fi
    printf '}'
  done
  printf ']}\n'
}

cmd_harvest() {
  local sub="${1:-}"; [ $# -gt 0 ] && shift || true
  case "$sub" in
    show)
      [ "$#" -eq 2 ] && [ "$1" = --format ] && [ "$2" = json ] || die "usage: workbench task harvest show --format json"
      require_v2_task; print_harvest_ledger false
      ;;
    seal)
      [ "$#" -eq 2 ] && [ "$1" = --format ] && [ "$2" = json ] || die "usage: workbench task harvest seal --format json"
      require_v2_task
      require_mutable_task task.harvest.seal || return 1
      local dir changed=false; dir="$(harvest_dir)"; mkdir -p "$dir"
      if ! harvest_is_sealed; then printf 'true\n' > "$dir/sealed"; changed=true; fi
      print_harvest_ledger "$changed"
      ;;
    candidate)
      [ "${1:-}" = declare ] || die "usage: workbench task harvest candidate declare ..."
      shift
      local id="" kind="" source_ref="" format="" dir file
      while [ $# -gt 0 ]; do case "$1" in --id) id="$2"; shift 2 ;; --kind) kind="$2"; shift 2 ;;
        --source-ref) source_ref="$2"; shift 2 ;; --format) format="$2"; shift 2 ;; *) die "unknown option: $1" ;; esac; done
      [ "$format" = json ] || die "unsupported format: ${format:-none}"
      require_v2_task
      require_mutable_task task.harvest.candidate.declare || return 1
      validate_record_id candidate_id "$id"; case "$kind" in decision|lesson|runbook|framework-change) ;; *) die "invalid harvest kind: $kind" ;; esac
      require_single_line source_ref "$source_ref"; dir="$(harvest_dir)/candidates"; mkdir -p "$dir"; file="$dir/$id.record"
      if [ -f "$file" ]; then
        [ "$(record_get "$file" kind)" = "$kind" ] && [ "$(record_get "$file" source_ref)" = "$source_ref" ] \
          || die "conflicting candidate_id: $id"
        print_harvest_ledger false; return 0
      fi
      write_harvest_candidate "$file" "$id" "$kind" "$source_ref" pending
      rm -f "$(harvest_dir)/sealed"; print_harvest_ledger true
      ;;
    dispose)
      local id="" decision="" reason_code="" reason_ref="" target_ref=""
      local instance_id="" authorization_file="" format=""
      while [ $# -gt 0 ]; do case "$1" in --id) id="$2"; shift 2 ;; --decision) decision="$2"; shift 2 ;;
        --reason-code) reason_code="$2"; shift 2 ;; --reason-ref) reason_ref="$2"; shift 2 ;;
        --target-ref) target_ref="$2"; shift 2 ;; --action-instance-id) instance_id="$2"; shift 2 ;;
        --authorization-file) authorization_file="$2"; shift 2 ;; --format) format="$2"; shift 2 ;;
        *) die "unknown option: $1" ;; esac; done
      [ "$format" = json ] || die "unsupported format: ${format:-none}"
      require_v2_task
      require_mutable_task task.harvest.dispose || return 1
      current_task_identity; validate_record_id candidate_id "$id"
      local file kind source_ref state old_decision old_target old_reason old_reason_ref
      local revision action_target authorization_ref recovery_rc
      file="$(harvest_dir)/candidates/$id.record"; [ -f "$file" ] || die "unknown candidate_id: $id"
      if recover_harvest_disposition "$file" "$instance_id"; then return 0
      else recovery_rc=$?; fi
      [ "$recovery_rc" = 10 ] || return "$recovery_rc"
      case "$decision" in absorb|codebase|follow-up|discard) ;; *) die "invalid harvest decision: $decision" ;; esac
      require_single_line reason_code "$reason_code"; [ -z "$reason_ref" ] || require_single_line reason_ref "$reason_ref"
      case "$decision" in discard) [ -z "$target_ref" ] || die "discard must not have target_ref" ;; *) require_single_line target_ref "$target_ref" ;; esac
      kind="$(record_get "$file" kind)"; source_ref="$(record_get "$file" source_ref)"; state="$(record_get "$file" state)"
      if [ "$state" = disposed ]; then
        old_decision="$(record_get "$file" decision)"; old_target="$(record_get "$file" target_ref)"
        old_reason="$(record_get "$file" reason_code)"; old_reason_ref="$(record_get "$file" reason_ref)"
        [ "$old_decision" = "$decision" ] && [ "$old_target" = "$target_ref" ] \
          && [ "$old_reason" = "$reason_code" ] && [ "$old_reason_ref" = "$reason_ref" ] \
          || die "conflicting harvest disposition: $id"
        print_harvest_ledger false; return 0
      fi
      revision="$(harvest_candidate_record_digest "$file")"; action_target="workbench:harvest/$id"
      local payload_file="$(mktemp "${TMPDIR:-/tmp}/workbench-harvest-intent.XXXXXX")"
      python3 "$(intent_helper)" build-payload --contract workbench-harvest-disposition-intent/v1 \
        --field "candidate_id=$id" --field "record_revision=$revision" --field "decision=$decision" \
        --field "target_ref=$(value_or_null "$target_ref")" --field "reason_code=$reason_code" \
        --field "reason_ref=$(value_or_null "$reason_ref")" > "$payload_file" \
        || { rm -f "$payload_file"; die "invalid harvest disposition intent"; }
      resolve_governed_action task.harvest.dispose "$action_target" "$revision" "$instance_id" \
        "$authorization_file" workbench-harvest-disposition-intent/v1 "$payload_file"
      rm -f "$payload_file"
      case "$GOVERNED_POLICY_RC" in 0) ;; 3|4) printf '%s\n' "$GOVERNED_POLICY_OUTPUT"; return "$GOVERNED_POLICY_RC" ;; *) return "$GOVERNED_POLICY_RC" ;; esac
      authorization_ref="$(json_string_field "$GOVERNED_POLICY_OUTPUT" authorization_ref)"
      local action_file="$(task_state_dir)/actions/$GOVERNED_ACTION_INSTANCE_ID.record"
      local manifest_digest="$(record_get "$action_file" policy_manifest_digest)"
      write_harvest_candidate "$file" "$id" "$kind" "$source_ref" disposed "$decision" \
        "$target_ref" "$reason_code" "$reason_ref" "$GOVERNED_ACTION_INSTANCE_ID" \
        "$GOVERNED_INTENT_DIGEST" "$manifest_digest" "$authorization_ref"
      local primary_digest="$(digest_manifest "$file")"
      consume_governed_action task.harvest.dispose "$action_target" "$revision" \
        "$GOVERNED_ACTION_INSTANCE_ID" "$GOVERNED_INTENT_DIGEST" "$primary_digest"
      print_harvest_ledger true
      ;;
    *) die "usage: workbench task harvest candidate|dispose|seal|show ..." ;;
  esac
}

evidence_is_stale() {
  local file="$1" subject_ref subject_revision current_revision
  subject_ref="$(record_get "$file" subject_ref)"
  subject_revision="$(record_get "$file" subject_revision)"
  current_revision="$(current_subject_revision "$subject_ref" || true)"
  [ -z "$current_revision" ] || [ "$subject_revision" != "$current_revision" ]
}

current_subject_revision() {
  local subject_ref="$1" id file
  case "$subject_ref" in
    workbench:deliverable/*)
      id="${subject_ref#workbench:deliverable/}"
      file="$(deliverable_dir)/$id.record"; [ -f "$file" ] || return 1
      record_get "$file" revision
      ;;
    workbench:task/*)
      current_task_identity
      [ "$subject_ref" = "workbench:task/$CURRENT_CLAIM_ID" ] || return 1
      task_content_digest
      ;;
    *) return 1 ;;
  esac
}

print_evidence_json() {
  local file="$1" evidence_id owner subject_ref subject_revision check_id command result recorded_at source url stale
  evidence_id="$(record_get "$file" evidence_id)"; owner="$(record_get "$file" owner)"
  subject_ref="$(record_get "$file" subject_ref)"; subject_revision="$(record_get "$file" subject_revision)"
  check_id="$(record_get "$file" check_id)"; command="$(record_get "$file" command)"
  result="$(record_get "$file" result)"; recorded_at="$(record_get "$file" recorded_at)"
  source="$(record_get "$file" source)"; url="$(record_get "$file" url)"
  if evidence_is_stale "$file"; then stale=true; else stale=false; fi
  printf '{"evidence_id":"%s","owner":"%s","subject_ref":"%s","subject_revision":"%s","check_id":"%s","command":' \
    "$(json_escape "$evidence_id")" "$(json_escape "$owner")" "$(json_escape "$subject_ref")" \
    "$(json_escape "$subject_revision")" "$(json_escape "$check_id")"
  json_nullable "$command"
  printf ',"result":"%s","recorded_at":"%s","source":"%s","url":' \
    "$result" "$recorded_at" "$source"
  json_nullable "$url"
  printf ',"stale":%s}' "$stale"
}

print_evidence_mutation_json() {
  local changed="$1" file="$2"
  printf '{"contract_version":"workbench-evidence/v1","task_contract":"workbench-task/v2","changed":%s,"evidence":' "$changed"
  print_evidence_json "$file"; printf '}\n'
}

cmd_evidence() {
  local sub="${1:-}"; [ $# -gt 0 ] && shift || true
  case "$sub" in
    record)
      local id="" owner="" subject_ref="" subject_revision="" check_id="" command=""
      local result="" source="" url="" recorded_at="" format=""
      while [ $# -gt 0 ]; do
        case "$1" in
          --id) id="$2"; shift 2 ;; --owner) owner="$2"; shift 2 ;;
          --subject-ref) subject_ref="$2"; shift 2 ;; --subject-revision) subject_revision="$2"; shift 2 ;;
          --check-id) check_id="$2"; shift 2 ;; --command) command="$2"; shift 2 ;;
          --result) result="$2"; shift 2 ;; --source) source="$2"; shift 2 ;;
          --url) url="$2"; shift 2 ;;
          --format) format="$2"; shift 2 ;;
          *) die "unknown option: $1" ;;
        esac
      done
      require_v2_task
      require_mutable_task task.evidence.record || return 1
      [ "$format" = json ] || die "unsupported format: ${format:-none}"
      validate_record_id evidence_id "$id"
      require_single_line owner "$owner"; require_single_line subject_ref "$subject_ref"
      require_single_line subject_revision "$subject_revision"
      require_single_line check_id "$check_id"
      [ -z "$command" ] || require_single_line command "$command"
      [ -z "$url" ] || require_single_line url "$url"
      case "$result" in passed|failed) ;; *) die "result must be passed or failed" ;; esac
      case "$source" in local|ci) ;; *) die "source must be local or ci" ;; esac
      recorded_at="$(utc_now)"
      local dir file tmp check_file
      check_file="$(required_check_dir)/$check_id.record"
      [ -f "$check_file" ] || die "unknown check_id: $check_id"
      [ "$(record_get "$check_file" owner)" = "$owner" ] \
        || die "evidence owner does not match required check"
      [ "$(record_get "$check_file" subject_ref)" = "$subject_ref" ] \
        || die "evidence subject does not match required check"
      dir="$(evidence_dir)"; mkdir -p "$dir"; file="$dir/$id.record"
      if [ -f "$file" ]; then
        [ "$(record_get "$file" owner)" = "$owner" ] \
          && [ "$(record_get "$file" subject_ref)" = "$subject_ref" ] \
          && [ "$(record_get "$file" subject_revision)" = "$subject_revision" ] \
          && [ "$(record_get "$file" check_id)" = "$check_id" ] \
          && [ "$(record_get "$file" command)" = "$command" ] \
          && [ "$(record_get "$file" result)" = "$result" ] \
          && [ "$(record_get "$file" source)" = "$source" ] \
          && [ "$(record_get "$file" url)" = "$url" ] \
          || die "conflicting evidence_id: $id"
        print_evidence_mutation_json false "$file"; return 0
      fi
      tmp="$file.tmp.$$"
      {
        printf 'evidence_id=%s\n' "$id"
        printf 'owner=%s\n' "$owner"
        printf 'subject_ref=%s\n' "$subject_ref"
        printf 'subject_revision=%s\n' "$subject_revision"
        printf 'check_id=%s\n' "$check_id"
        printf 'command=%s\n' "$command"
        printf 'result=%s\n' "$result"
        printf 'recorded_at=%s\n' "$recorded_at"
        printf 'source=%s\n' "$source"
        printf 'url=%s\n' "$url"
      } > "$tmp" && mv "$tmp" "$file"
      print_evidence_mutation_json true "$file"
      ;;
    list)
      local format="" dir file first=1
      while [ $# -gt 0 ]; do case "$1" in --format) format="$2"; shift 2 ;; *) die "unknown option: $1" ;; esac; done
      [ "$format" = json ] || die "unsupported format: ${format:-none}"
      require_task_worktree; dir="$(evidence_dir)"
      printf '{"contract_version":"workbench-evidence/v1","task_contract":"%s","evidence":[' "$(index_get task_contract)"
      for file in "$dir"/*.record; do
        [ -f "$file" ] || continue
        [ "$first" = 1 ] || printf ','; first=0; print_evidence_json "$file"
      done
      printf ']}\n'
      ;;
    *) die "usage: workbench task evidence record|list ..." ;;
  esac
}

# ── resume ────────────────────────────────────────────────────────────

cmd_resume() {
  local id="" parent="" format=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --parent) parent="$2"; shift 2 ;;
      --format) format="$2"; shift 2 ;;
      --*) die "unknown option: $1" ;;
      *) [ -n "$id" ] || id="$1"; shift ;;
    esac
  done
  [ -n "$id" ] || die "usage: workbench task resume <ID> [--parent N] [--format json]"
  parse_id "$id"
  local root branch dir changed=false task_contract descriptor_digest
  root="$(wb_root)"

  git -C "$root" fetch origin 2>/dev/null || true
  branch="$(resolve_branch "$HOME_REPO" "$ISSUE" "$parent" "$id")" || exit 1
  dir="$root/.worktrees/$(branch_to_dir "$branch")"

  if [ ! -d "$dir" ]; then
    changed=true
    if [ "$format" = json ]; then
      info "워크트리 복원: $branch → $dir" >&2
      git -C "$root" worktree add -q "$dir" "$branch"
    else
      info "워크트리 복원: $branch → $dir"
      git -C "$root" worktree add "$dir" "$branch"
    fi
  else
    if [ "$format" = json ]; then info "워크트리 이미 존재: $dir" >&2; else info "워크트리 이미 존재: $dir"; fi
  fi

  # index.md 기록 기반으로 codebase 작업 사본 재구성
  TASK_DIR="$dir"
  if [ ! -f "$dir/task/index.md" ]; then
    [ -z "$format" ] || die "v2 resume cannot recover submitted task without task identity"
    info "task/ 없음 (submit 이후 상태) — codebase 복원 생략"
    info "완료. cd $dir"; return 0
  fi
  task_contract="$(index_get task_contract)"; [ -n "$task_contract" ] || task_contract=workbench-task/v1
  if [ "$task_contract" = workbench-task/v2 ]; then
    [ "$format" = json ] || die "v2 task resume requires --format json"
    descriptor_digest="$(index_get workspace_authority_descriptor_digest)"
    observe_workspace_authority "$root" "$descriptor_digest"
    info "완료. cd $dir" >&2
    print_task_start_json "$dir" "$changed"
    return 0
  fi
  [ -z "$format" ] || die "v1 task resume does not support --format"
  local name cb_branch role clone wt
  while IFS='|' read -r name cb_branch role; do
    name="$(echo "$name" | sed -E 's/^- *| *$//g')"
    cb_branch="$(echo "$cb_branch" | sed -E 's/^ +| +$//g')"
    [ -n "$name" ] || continue
    clone="$root/.codebases/$name"
    wt="$dir/task/codebases/$name"
    [ -d "$clone/.git" ] || { echo "warn: .codebases/$name 없음 — workbench setup 먼저" >&2; continue; }
    [ -d "$wt" ] && { info "$name 작업 사본 이미 존재"; continue; }
    git -C "$clone" fetch origin 2>/dev/null || true
    if ! git -C "$clone" show-ref -q "refs/heads/$cb_branch"; then
      git -C "$clone" branch "$cb_branch" "origin/$cb_branch" 2>/dev/null \
        || { echo "warn: $name 에 브랜치 $cb_branch 없음 (로컬·origin 모두)" >&2; continue; }
    fi
    info "codebase $name: $cb_branch 작업 사본 복원"
    git -C "$clone" worktree add "$wt" "$cb_branch"
  done <<EOF
$(repos_block)
EOF

  info "완료. cd $dir"
}

# ── submit ────────────────────────────────────────────────────────────

submission_recovery_load() {
  local parsed="$1" line key value
  SUBMISSION_RECOVERY_CONTRACT=""; SUBMISSION_RECOVERY_ORIGIN=""
  SUBMISSION_RECOVERY_DEFAULT_REF=""; SUBMISSION_RECOVERY_BRANCH=""
  SUBMISSION_RECOVERY_TASK_ID=""; SUBMISSION_RECOVERY_ISSUE=""
  SUBMISSION_RECOVERY_HOME=""; SUBMISSION_RECOVERY_PARENT=""
  SUBMISSION_RECOVERY_CLAIM_ID=""; SUBMISSION_RECOVERY_DESCRIPTOR_DIGEST=""
  SUBMISSION_RECOVERY_SNAPSHOT=""; SUBMISSION_RECOVERY_INDEX_DIGEST=""
  SUBMISSION_RECOVERY_CLEANUP=""; SUBMISSION_RECOVERY_PR_NUMBER=""
  SUBMISSION_RECOVERY_PR_URL=""; SUBMISSION_RECOVERY_HEAD=""
  SUBMISSION_RECOVERY_STAGE=""
  while IFS= read -r line; do
    key="${line%%=*}"; value="${line#*=}"
    case "$key" in
      contract_version) SUBMISSION_RECOVERY_CONTRACT="$value" ;;
      repository_origin_url) SUBMISSION_RECOVERY_ORIGIN="$value" ;;
      default_ref) SUBMISSION_RECOVERY_DEFAULT_REF="$value" ;;
      branch) SUBMISSION_RECOVERY_BRANCH="$value" ;;
      task_id) SUBMISSION_RECOVERY_TASK_ID="$value" ;;
      issue) SUBMISSION_RECOVERY_ISSUE="$value" ;;
      home) SUBMISSION_RECOVERY_HOME="$value" ;;
      parent) SUBMISSION_RECOVERY_PARENT="$value" ;;
      claim_id) SUBMISSION_RECOVERY_CLAIM_ID="$value" ;;
      workspace_authority_descriptor_digest) SUBMISSION_RECOVERY_DESCRIPTOR_DIGEST="$value" ;;
      snapshot_revision) SUBMISSION_RECOVERY_SNAPSHOT="$value" ;;
      snapshot_index_digest) SUBMISSION_RECOVERY_INDEX_DIGEST="$value" ;;
      cleanup_revision) SUBMISSION_RECOVERY_CLEANUP="$value" ;;
      pull_request) SUBMISSION_RECOVERY_PR_NUMBER="$value" ;;
      pull_request_url) SUBMISSION_RECOVERY_PR_URL="$value" ;;
      head_revision) SUBMISSION_RECOVERY_HEAD="$value" ;;
      stage) SUBMISSION_RECOVERY_STAGE="$value" ;;
    esac
  done <<< "$parsed"
  [ "$SUBMISSION_RECOVERY_CONTRACT" = workbench-submission-recovery/v1 ] \
    && [ "$SUBMISSION_RECOVERY_BRANCH" != "" ] \
    && [ "$SUBMISSION_RECOVERY_SNAPSHOT" != "" ]
}

submission_recovery_prepare() {
  local origin="$1" default_ref="$2" branch="$3" snapshot="$4" parsed
  parsed="$(python3 "$(lifecycle_helper)" submission-recovery-prepare \
    --repository "$TASK_DIR" --repository-origin-url "$origin" \
    --default-ref "$default_ref" --branch "$branch" \
    --snapshot-revision "$snapshot")" || return 1
  submission_recovery_load "$parsed"
}

submission_recovery_advance() {
  local branch="$1" stage="$2"; shift 2
  local parsed
  parsed="$(python3 "$(lifecycle_helper)" submission-recovery-advance \
    --repository "$TASK_DIR" --branch "$branch" --stage "$stage" "$@")" \
    || return 1
  submission_recovery_load "$parsed"
}

submission_recovery_validate() {
  local origin="$1" default_ref="$2" branch="$3" head="$4" index_file="${5:-}"
  local parsed args=(submission-recovery-validate --repository "$TASK_DIR" \
    --repository-origin-url "$origin" --default-ref "$default_ref" \
    --branch "$branch" --current-head "$head")
  [ -z "$index_file" ] || args+=(--index-file "$index_file")
  parsed="$(python3 "$(lifecycle_helper)" "${args[@]}")" || return 1
  submission_recovery_load "$parsed"
}

submission_recovery_retire() {
  local repository="$1" branch="$2" claim_id="$3"
  python3 "$(lifecycle_helper)" submission-recovery-retire \
    --repository "$repository" --branch "$branch" --claim-id "$claim_id" >/dev/null
}

submission_lifecycle_reduce() {
  local root="$1" home="$2" issue="$3" claim_id="$4" branch="$5" descriptor_digest="$6"
  local markers parsed line key value home_arg="${home:--}"
  markers="$(mktemp "${TMPDIR:-/tmp}/workbench-submission-markers.XXXXXX")"
  lifecycle_markers_for_issue "$root" "$home" "$issue" > "$markers" \
    || { rm -f "$markers"; return 1; }
  parsed="$(python3 "$(lifecycle_helper)" lifecycle-reduce --markers-file "$markers" \
    --branch "$branch" --claim-id "$claim_id" --issue "$issue" --home "$home_arg" \
    --descriptor-digest "$descriptor_digest")" \
    || { rm -f "$markers"; return 1; }
  rm -f "$markers"
  SUBMISSION_LIFECYCLE_PHASE=""; SUBMISSION_LIFECYCLE_PR=""
  SUBMISSION_LIFECYCLE_HEAD=""; SUBMISSION_LIFECYCLE_TERMINAL_EVENT=""
  SUBMISSION_LIFECYCLE_TERMINAL_REVISION=""
  while IFS= read -r line; do
    key="${line%%=*}"; value="${line#*=}"
    case "$key" in
      phase) SUBMISSION_LIFECYCLE_PHASE="$value" ;;
      pull_request) SUBMISSION_LIFECYCLE_PR="$value" ;;
      head_revision) SUBMISSION_LIFECYCLE_HEAD="$value" ;;
      terminal_event) SUBMISSION_LIFECYCLE_TERMINAL_EVENT="$value" ;;
      terminal_revision) SUBMISSION_LIFECYCLE_TERMINAL_REVISION="$value" ;;
    esac
  done <<< "$parsed"
  [ -n "$SUBMISSION_LIFECYCLE_PHASE" ]
}

submission_recovery_guard() {
  local branch root origin descriptor default_ref default_branch head
  SUBMISSION_RECOVERY_ACTIVE=false
  branch="$(git -C "$TASK_DIR" branch --show-current)"; [ -n "$branch" ] || return 1
  descriptor="$(index_get workspace_authority_descriptor_digest)"
  root="$(wb_root)"
  observe_workspace_authority "$root" "$descriptor" || return 1
  origin="$(git -C "$TASK_DIR" remote get-url origin 2>/dev/null)" || return 1
  default_ref="$AUTHORITY_DEFAULT_REF"; default_branch="${default_ref#refs/heads/}"
  [ "refs/heads/$default_branch" = "$default_ref" ] || return 1
  head="$(git -C "$TASK_DIR" rev-parse HEAD)" || return 1
  submission_recovery_validate "$origin" "$default_ref" "$branch" "$head" \
    "$TASK_DIR/task/index.md" || return 1
  [ "$SUBMISSION_RECOVERY_STAGE" = restored ] || return 1
  [ "$SUBMISSION_RECOVERY_DESCRIPTOR_DIGEST" = "$descriptor" ] || return 1
  submission_pr_observe "$branch" "$head" "$default_branch" \
    "$SUBMISSION_RECOVERY_PR_URL" || return 1
  [ "$SUBMISSION_PR_NUMBER" = "$SUBMISSION_RECOVERY_PR_NUMBER" ] || return 1
  submission_lifecycle_reduce "$root" "$SUBMISSION_RECOVERY_HOME" \
    "$SUBMISSION_RECOVERY_ISSUE" "$SUBMISSION_RECOVERY_CLAIM_ID" "$branch" \
    "$SUBMISSION_RECOVERY_DESCRIPTOR_DIGEST" || return 1
  case "$SUBMISSION_LIFECYCLE_PHASE" in
    submitted|submitted-verified|terminal)
      [ "$SUBMISSION_LIFECYCLE_PR" = "$SUBMISSION_RECOVERY_PR_NUMBER" ] \
        && [ "$SUBMISSION_LIFECYCLE_HEAD" = "$SUBMISSION_RECOVERY_HEAD" ] \
        || return 1
      ;;
    *) return 1 ;;
  esac
  SUBMISSION_RECOVERY_ACTIVE=true
}

submission_restore_task() {
  local root="$1" branch="$2" head="$3" origin="$4" default_ref="$5"
  submission_recovery_validate "$origin" "$default_ref" "$branch" "$head" || return 1
  [ "$SUBMISSION_RECOVERY_STAGE" = submitted ] \
    || [ "$SUBMISSION_RECOVERY_STAGE" = restored ] || return 1
  submission_pr_observe "$branch" "$head" "${default_ref#refs/heads/}" \
    "$SUBMISSION_RECOVERY_PR_URL" || return 1
  [ "$SUBMISSION_PR_NUMBER" = "$SUBMISSION_RECOVERY_PR_NUMBER" ] || return 1
  submission_lifecycle_reduce "$root" "$SUBMISSION_RECOVERY_HOME" \
    "$SUBMISSION_RECOVERY_ISSUE" "$SUBMISSION_RECOVERY_CLAIM_ID" "$branch" \
    "$SUBMISSION_RECOVERY_DESCRIPTOR_DIGEST" || return 1
  case "$SUBMISSION_LIFECYCLE_PHASE" in submitted|submitted-verified) ;; *) return 1 ;; esac
  [ "$SUBMISSION_LIFECYCLE_PR" = "$SUBMISSION_RECOVERY_PR_NUMBER" ] \
    && [ "$SUBMISSION_LIFECYCLE_HEAD" = "$SUBMISSION_RECOVERY_HEAD" ] || return 1
  if [ "$SUBMISSION_RECOVERY_STAGE" = submitted ]; then
    python3 "$(lifecycle_helper)" submission-recovery-restore \
      --repository "$TASK_DIR" --branch "$branch" >/dev/null || return 1
    submission_recovery_advance "$branch" restored || return 1
  fi
  python3 "$(lifecycle_helper)" submission-recovery-codebases \
    --repository "$TASK_DIR" --branch "$branch" --direction restore >/dev/null || return 1
  submission_recovery_validate "$origin" "$default_ref" "$branch" "$head" \
    "$TASK_DIR/task/index.md" || return 1
}

submission_bind_increment() {
  local pr_number="$1" pr_url="$2" revision="$3" dir file count=0 selected=""
  local owner kind owner_context acceptance_authority required external state acceptance_ref
  dir="$(deliverable_dir)"
  for file in "$dir"/*.record; do
    [ -f "$file" ] || continue
    [ "$(record_get "$file" kind)" = workbench-increment ] || continue
    count=$((count + 1)); selected="$file"
  done
  [ "$count" -le 1 ] || return 1
  [ "$count" -eq 1 ] || return 0
  file="$selected"; owner="$(record_get "$file" owner)"; kind="$(record_get "$file" kind)"
  owner_context="$(record_get "$file" owner_context_ref)"
  acceptance_authority="$(record_get "$file" acceptance_authority_ref)"
  required="$(record_get "$file" required)"; external="$(record_get "$file" external_ref)"
  state="$(record_get "$file" state)"; acceptance_ref="$(record_get "$file" acceptance_ref)"
  case "$state" in
    declared)
      [ -z "$external$(record_get "$file" revision)$acceptance_ref" ] || return 1
      write_deliverable_record "$file" "$(record_get "$file" deliverable_id)" "$owner" "$kind" \
        "$owner_context" "$acceptance_authority" "$required" "$pr_url" "$revision" submitted
      ;;
    submitted|accepted)
      [ "$external" = "$pr_url" ] \
        && [ "$(record_get "$file" revision)" = "$revision" ] || return 1
      ;;
    *) return 1 ;;
  esac
}

submission_index_snapshot() {
  local branch="$1" output="$2" commit
  commit="$(git -C "$TASK_DIR" rev-parse HEAD)" || return 1
  if ! git -C "$TASK_DIR" show "$commit:task/index.md" > "$output" 2>/dev/null; then
    [ "$(git -C "$TASK_DIR" rev-list --parents -n 1 HEAD | wc -w | tr -d ' ')" = 2 ] \
      || return 1
    commit="$(git -C "$TASK_DIR" rev-parse HEAD^)" || return 1
    git -C "$TASK_DIR" show "$commit:task/index.md" > "$output" 2>/dev/null || return 1
  fi
  python3 "$(lifecycle_helper)" task-index --file "$output" --branch "$branch" \
    --format json >/dev/null || return 1
  printf '%s\n' "$commit"
  return 0
}

submission_load_identity() {
  local file="$1" branch="$2" parsed line key value
  parsed="$(python3 "$(lifecycle_helper)" task-index --file "$file" --branch "$branch" \
    --format shell)" || return 1
  SUBMISSION_TASK_ID=""; SUBMISSION_ISSUE=""; SUBMISSION_HOME=""; SUBMISSION_PARENT=""
  SUBMISSION_CLAIM_ID=""; SUBMISSION_TASK_CONTRACT=""; SUBMISSION_DESCRIPTOR_DIGEST=""
  while IFS= read -r line; do
    key="${line%%=*}"; value="${line#*=}"
    case "$key" in
      id) SUBMISSION_TASK_ID="$value" ;; issue) SUBMISSION_ISSUE="$value" ;;
      home) SUBMISSION_HOME="$value" ;; parent) SUBMISSION_PARENT="$value" ;;
      claim_id) SUBMISSION_CLAIM_ID="$value" ;; task_contract) SUBMISSION_TASK_CONTRACT="$value" ;;
      workspace_authority_descriptor_digest) SUBMISSION_DESCRIPTOR_DIGEST="$value" ;;
    esac
  done <<< "$parsed"
  [ -n "$SUBMISSION_TASK_ID" ] && [ -n "$SUBMISSION_ISSUE" ] \
    && [ -n "$SUBMISSION_CLAIM_ID" ] && [ -n "$SUBMISSION_TASK_CONTRACT" ]
}

submission_pr_observe() {
  local branch="$1" expected_head="$2" base_ref="$3" expected_url="${4:-}"
  local adapter origin observation parsed state
  adapter="${WORKBENCH_TRUSTED_HOSTING_ADAPTER:-}"
  [ -n "$adapter" ] && [ -x "$adapter" ] || return 1
  origin="$(git -C "$TASK_DIR" remote get-url origin 2>/dev/null)" || return 1
  observation="$(mktemp "${TMPDIR:-/tmp}/workbench-submission-observation.XXXXXX")"
  if ! (cd "$TASK_DIR" && "$adapter" submission --repository "$TASK_DIR" \
    --head-branch "$branch" --head-revision "$expected_head" --default-ref "$base_ref" \
    --format json) \
    > "$observation" 2>/dev/null; then rm -f "$observation"; return 1; fi
  parsed="$(python3 "$(lifecycle_helper)" submission --observation-file "$observation" \
    --repository-origin-url "$origin" --head-branch "$branch" \
    --head-revision "$expected_head" --base-ref "$base_ref")" \
    || { rm -f "$observation"; return 1; }
  rm -f "$observation"
  state="$(printf '%s\n' "$parsed" | sed -n 's/^state=//p')"
  [ "$state" != absent ] || return 10
  [ "$state" = exact ] || return 1
  SUBMISSION_PR_NUMBER="$(printf '%s\n' "$parsed" | sed -n 's/^number=//p')"
  SUBMISSION_PR_URL="$(printf '%s\n' "$parsed" | sed -n 's/^url=//p')"
  SUBMISSION_PR_HEAD="$(printf '%s\n' "$parsed" | sed -n 's/^head_revision=//p')"
  [ -z "$expected_url" ] || [ "$SUBMISSION_PR_URL" = "$expected_url" ] || return 1
  [ -n "$SUBMISSION_PR_NUMBER" ] && [ -n "$SUBMISSION_PR_URL" ] \
    && [ "$SUBMISSION_PR_HEAD" = "$expected_head" ]
}

submission_lifecycle_state() {
  local root="$1" home="$2" issue="$3" claim_id="$4" branch="$5" pr="$6"
  local revision="$7" task_contract="$8" descriptor_digest="$9"
  [ "$task_contract" = workbench-task/v2 ] || return 1
  submission_lifecycle_reduce "$root" "$home" "$issue" "$claim_id" "$branch" \
    "$descriptor_digest" || return 1
  case "$SUBMISSION_LIFECYCLE_PHASE" in
    submitted|submitted-verified)
      [ "$SUBMISSION_LIFECYCLE_PR" = "$pr" ] \
        && [ "$SUBMISSION_LIFECYCLE_HEAD" = "$revision" ]
      ;;
    active|verified) return 10 ;;
    *) return 1 ;;
  esac
}

submission_lifecycle_reconcile() {
  local root="$1" home="$2" issue="$3" claim_id="$4" branch="$5" pr="$6"
  local revision="$7" task_contract="$8" descriptor_digest="$9" state_rc
  if submission_lifecycle_state "$root" "$home" "$issue" "$claim_id" "$branch" "$pr" \
    "$revision" "$task_contract" "$descriptor_digest"; then return 0
  else state_rc=$?; fi
  if [ "$state_rc" -eq 10 ]; then
    lifecycle_emit "$root" "$home" "$issue" task-submitted "$claim_id" "$branch" "$pr" \
      "$revision" "" "$task_contract" "$descriptor_digest" "" || return 1
    submission_lifecycle_state "$root" "$home" "$issue" "$claim_id" "$branch" "$pr" \
      "$revision" "$task_contract" "$descriptor_digest"
    return $?
  fi
  return "$state_rc"
}

cmd_submit() {
  local title="" body_file=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --title)     title="$2"; shift 2 ;;
      --body-file) body_file="$2"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  # 산문은 입력으로만 받는다 — 이 스크립트는 PR 내용을 짓지 않는다
  [ -n "$title" ] || die "--title 필요 (PR 제목은 판단 레이어가 작성한다)"
  [ -n "$body_file" ] && [ -f "$body_file" ] || die "--body-file 필요 (PR 본문은 판단 레이어가 작성한다)"
  require_task_worktree

  local root branch id issue home claim_id task_contract descriptor_digest snapshot snapshot_commit
  local tracked_task=false recovered_task=false pending_restore=false dirty current
  root="$(wb_root)"
  branch="$(git -C "$TASK_DIR" rev-parse --abbrev-ref HEAD)"
  if [ -f "$TASK_DIR/task/index.md" ]; then
    if git -C "$TASK_DIR" ls-files --error-unmatch task/index.md >/dev/null 2>&1; then
      tracked_task=true
    else
      if submission_recovery_guard >/dev/null 2>&1; then
        recovered_task=true
      else
        pending_restore=true
      fi
    fi
    if [ "$pending_restore" = false ]; then
      submission_load_identity "$TASK_DIR/task/index.md" "$branch" \
        || die "invalid task identity for submission"
      id="$SUBMISSION_TASK_ID"; issue="$SUBMISSION_ISSUE"; home="$SUBMISSION_HOME"
      claim_id="$SUBMISSION_CLAIM_ID"; task_contract="$SUBMISSION_TASK_CONTRACT"
      descriptor_digest="$SUBMISSION_DESCRIPTOR_DIGEST"
      if [ "$recovered_task" = true ]; then
        snapshot_commit="$SUBMISSION_RECOVERY_SNAPSHOT"
      else
        snapshot_commit="$(git -C "$TASK_DIR" rev-parse HEAD)"
      fi
    fi
  fi
  if [ ! -f "$TASK_DIR/task/index.md" ] || [ "$pending_restore" = true ]; then
    snapshot="$(mktemp "${TMPDIR:-/tmp}/workbench-submission-index.XXXXXX")"
    if snapshot_commit="$(submission_index_snapshot "$branch" "$snapshot")"; then
      submission_load_identity "$snapshot" "$branch" \
        || { rm -f "$snapshot"; die "invalid historical task identity for submission"; }
      id="$SUBMISSION_TASK_ID"; issue="$SUBMISSION_ISSUE"; home="$SUBMISSION_HOME"
      claim_id="$SUBMISSION_CLAIM_ID"; task_contract="$SUBMISSION_TASK_CONTRACT"
      descriptor_digest="$SUBMISSION_DESCRIPTOR_DIGEST"
      rm -f "$snapshot"
    else
      rm -f "$snapshot"
      local parsed
      parsed="$(branch_home_issue "$branch")" || die "task/index.md 없이 issue/home 복원 실패: $branch"
      IFS='|' read -r home _ issue <<< "$parsed"
      id="$issue"; [ -n "$home" ] && id="$home#$issue"
      claim_id="$(lifecycle_claim_for_branch "$root" "$home" "$issue" "$branch" 2>/dev/null || true)"
      [ -n "$claim_id" ] || claim_id="$branch"
      task_contract=workbench-task/v1; descriptor_digest=""
    fi
  fi
  [ -n "$claim_id" ] || claim_id="$branch"

  if [ "$task_contract" != workbench-task/v2 ]; then
    [ -z "$(git -C "$TASK_DIR" status --porcelain)" ] \
      || die "커밋 안 된 변경 있음 — 정리(커밋 또는 폐기) 후 재시도"
    if [ -f "$TASK_DIR/task/index.md" ]; then
      cmd_check
      info "cleanup: task/ 추적 파일 제거"
      git -C "$TASK_DIR" rm -r -q task
      git -C "$TASK_DIR" commit -q -m "task($id): cleanup"
    else
      info "task/ 이미 cleanup됨 — 건너뜀"
    fi
    local mref base_branch pr_url pr_number revision
    mref="$(main_ref "$TASK_DIR")"; base_branch="${mref#origin/}"
    if git -C "$TASK_DIR" diff "$mref...HEAD" --name-only | grep -q '^task/'; then
      die "diff에 task/ 잔존 — cleanup 상태를 확인할 것"
    fi
    git -C "$TASK_DIR" diff --quiet "$mref...HEAD" \
      && die "protected base 대비 변경 없음 — 제출할 증분이 없다"
    info "push: $branch"
    git -C "$TASK_DIR" push -u origin "$branch"
    revision="$(git -C "$TASK_DIR" rev-parse HEAD)"
    info "PR 생성 (squash 머지 전제)"
    pr_url="$(cd "$TASK_DIR" && gh pr create --base "$base_branch" --head "$branch" \
      --title "$title" --body-file "$body_file")" || return 1
    pr_number="$(pr_number_from_url "$pr_url")"
    printf '%s\n' "$pr_url"
    lifecycle_emit_optional "$root" "$home" "$issue" task-submitted "$claim_id" "$branch" "$pr_number"
    return 0
  fi

  printf '%s' "$descriptor_digest" | grep -Eq '^sha256:[0-9a-f]{64}$' \
    || { echo "error: missing submitted task authority identity" >&2; return 1; }
  observe_workspace_authority "$root" "$descriptor_digest"
  local origin default_ref default_branch mref revision pr_url pr_number
  origin="$(git -C "$TASK_DIR" remote get-url origin)"
  [ "$origin" = "$AUTHORITY_ORIGIN_URL" ] || die "submission authority origin mismatch"
  default_ref="$AUTHORITY_DEFAULT_REF"; default_branch="${default_ref#refs/heads/}"
  [ "refs/heads/$default_branch" = "$default_ref" ] \
    || die "submission authority default ref is invalid"
  mref="origin/$default_branch"
  git -C "$TASK_DIR" rev-parse --verify --quiet "$mref" >/dev/null 2>&1 \
    || die "submission authority tracking ref is unavailable: $mref"

  if [ "$recovered_task" = true ]; then
    dirty="$(git -C "$TASK_DIR" status --porcelain | grep -v '^?? task/$' || true)"
    [ -z "$dirty" ] || die "submitted task recovery has unrelated worktree changes"
  else
    submission_recovery_prepare "$origin" "$default_ref" "$branch" "$snapshot_commit" \
      || die "submission recovery preparation failed"
    current="$(git -C "$TASK_DIR" rev-parse HEAD)"
    if [ "$current" = "$snapshot_commit" ] && [ ! -f "$TASK_DIR/task/index.md" ]; then
      dirty="$(git -C "$TASK_DIR" status --porcelain)"
      [ -n "$dirty" ] \
        && [ -z "$(printf '%s\n' "$dirty" | grep -Ev '^D  task/' || true)" ] \
        || die "interrupted submission cleanup is not exact"
      git -C "$TASK_DIR" restore --staged --worktree -- task \
        || die "interrupted submission cleanup could not be rolled back"
      python3 "$(lifecycle_helper)" submission-recovery-codebases \
        --repository "$TASK_DIR" --branch "$branch" --direction restore >/dev/null \
        || die "interrupted submission codebases could not be restored"
      tracked_task=true
    fi
    if [ "$tracked_task" = true ]; then
      [ -z "$(git -C "$TASK_DIR" status --porcelain)" ] \
        || die "커밋 안 된 변경 있음 — 정리(커밋 또는 폐기) 후 재시도"
      cmd_check
      [ "${WORKBENCH_TEST_FAIL_SUBMISSION_STAGE:-}" != prepared ] \
        || { echo "error: simulated failure after submission preparation" >&2; return 1; }
      python3 "$(lifecycle_helper)" submission-recovery-codebases \
        --repository "$TASK_DIR" --branch "$branch" --direction park >/dev/null \
        || die "submission codebases parking failed"
      info "cleanup: task/ 추적 파일 제거"
      git -C "$TASK_DIR" rm -r -q task
      [ "${WORKBENCH_TEST_FAIL_SUBMISSION_STAGE:-}" != cleanup-staged ] \
        || { echo "error: simulated failure after staged submission cleanup" >&2; return 1; }
      git -C "$TASK_DIR" commit -q -m "task($id): cleanup"
      revision="$(git -C "$TASK_DIR" rev-parse HEAD)"
      submission_recovery_advance "$branch" cleanup-committed \
        --cleanup-revision "$revision" || die "submission cleanup recovery binding failed"
    else
      revision="$current"
      submission_recovery_advance "$branch" cleanup-committed \
        --cleanup-revision "$revision" || die "historical submission cleanup is invalid"
      if [ "$pending_restore" = true ]; then
        dirty="$(git -C "$TASK_DIR" status --porcelain | grep -v '^?? task/$' || true)"
        [ -z "$dirty" ] || die "pending submission restoration has unrelated changes"
      else
        [ -z "$(git -C "$TASK_DIR" status --porcelain)" ] \
          || die "post-cleanup submission worktree is occupied"
      fi
    fi
    [ "${WORKBENCH_TEST_FAIL_SUBMISSION_STAGE:-}" != cleanup-committed ] \
      || { echo "error: simulated failure after submission cleanup commit" >&2; return 1; }
  fi

  revision="$(git -C "$TASK_DIR" rev-parse HEAD)"
  submission_recovery_validate "$origin" "$default_ref" "$branch" "$revision" \
    || die "submission recovery validation failed"
  if git -C "$TASK_DIR" diff "$mref...HEAD" --name-only | grep -q '^task/'; then
    die "diff에 task/ 잔존 — cleanup 상태를 확인할 것"
  fi
  git -C "$TASK_DIR" diff --quiet "$mref...HEAD" \
    && die "protected base 대비 변경 없음 — 제출할 증분이 없다"
  info "push: $branch"
  git -C "$TASK_DIR" push -u origin "$branch"

  SUBMISSION_PR_URL=""; SUBMISSION_PR_NUMBER=""; SUBMISSION_PR_HEAD=""
  local observe_rc created_url
  if submission_pr_observe "$branch" "$revision" "$default_branch"; then
    info "기존 PR 검증: $SUBMISSION_PR_URL"
  else
    observe_rc=$?
    [ "$observe_rc" -eq 10 ] \
      || { echo "error: submission PR mapping unavailable or ambiguous" >&2; return 1; }
    info "PR 생성 (squash 머지 전제)"
    if ! created_url="$(cd "$TASK_DIR" && gh pr create --base "$default_branch" --head "$branch" \
      --title "$title" --body-file "$body_file")"; then return 1; fi
    submission_pr_observe "$branch" "$revision" "$default_branch" "$created_url" \
      || { echo "error: submission PR identity mismatch" >&2; return 1; }
  fi
  pr_url="$SUBMISSION_PR_URL"; pr_number="$SUBMISSION_PR_NUMBER"
  submission_recovery_advance "$branch" pr-observed \
    --pull-request "$pr_number" --pull-request-url "$pr_url" --head-revision "$revision" \
    || { echo "error: submission PR recovery binding failed" >&2; return 1; }
  [ "${WORKBENCH_TEST_FAIL_SUBMISSION_STAGE:-}" != pr-observed ] \
    || { echo "error: simulated failure after submission PR observation" >&2; return 1; }
  printf '%s\n' "$pr_url"
  submission_lifecycle_reconcile "$root" "$home" "$issue" "$claim_id" "$branch" \
    "$pr_number" "$revision" "$task_contract" "$descriptor_digest" \
    || { echo "error: lifecycle-write-failed: task-submitted" >&2; return 1; }
  submission_recovery_advance "$branch" submitted \
    || { echo "error: submission lifecycle recovery binding failed" >&2; return 1; }
  [ "${WORKBENCH_TEST_FAIL_SUBMISSION_STAGE:-}" != submitted ] \
    || { echo "error: simulated failure after submission lifecycle" >&2; return 1; }
  submission_restore_task "$root" "$branch" "$revision" "$origin" "$default_ref" \
    || { echo "error: authenticated task restoration failed" >&2; return 1; }
  submission_bind_increment "$pr_number" "$pr_url" "$revision" \
    || { echo "error: workbench increment submission binding failed" >&2; return 1; }
  [ "${WORKBENCH_TEST_FAIL_SUBMISSION_STAGE:-}" != restored ] \
    || { echo "error: simulated failure after task restoration" >&2; return 1; }
}

# ── commit subject policy ─────────────────────────────────────────────

# Phase 1 default: match current workbench behavior. The policy functions are
# intentionally grouped so a later profile/persona config can replace the source
# without changing cmd_commit and cmd_check call sites.
COMMIT_TYPES='feat|fix|docs|refactor|chore|test|build|ci|perf|style|revert'

commit_subject_policy_name() {
  printf '%s\n' conventional
}

commit_subject_policy_hint() {
  printf '형식: <type>(scope)?!?: <설명>   허용 type: %s   예: feat: add X, fix(task): handle Y, docs!: rewrite Z' "$COMMIT_TYPES"
}

# 배관 자신이 만드는 커밋(스캐폴드·cleanup·add-repo)은 subject policy 면제.
is_plumbing_subject() {
  case "$1" in
    'task('*'): 스캐폴드'|'task('*'): cleanup'|'task: add-repo '*) return 0 ;;
    *) return 1 ;;
  esac
}

is_valid_commit_subject() {
  printf '%s' "$1" | grep -qE "^($COMMIT_TYPES)(\([^)]+\))?!?: .+"
}

require_valid_commit_subject() {
  local subject="$1"
  is_valid_commit_subject "$subject" || die "commit subject policy ($(commit_subject_policy_name)) 위반: '$subject'
       $(commit_subject_policy_hint)"
}

report_invalid_commit_subject() {
  local sha="$1" subject="$2"
  echo "✗ commit subject policy ($(commit_subject_policy_name)): 커밋 ${sha:0:8} ($subject) — $(commit_subject_policy_hint)" >&2
}

# ── commit ────────────────────────────────────────────────────────────

# 에이전트의 유일 커밋 경로. log append + commit + push 를 원자화한다.
# 커밋 메시지는 사용자 컨벤션(conventional)대로, op·action·path 는 log 메타.
cmd_commit() {
  local op="" action="" path="" nopush="" msgs=()
  # 포지셔널: op action [path] — 옵션(-m, --no-push) 전까지
  while [ $# -gt 0 ]; do
    case "$1" in
      -m)
        [ $# -ge 2 ] || die "-m 값 필요"
        msgs+=("$2")
        shift 2
        ;;
      --no-push)
        nopush=1
        shift
        ;;
      -*)
        die "unknown option: $1"
        ;;
      *)
        if [ -z "$op" ]; then
          op="$1"
        elif [ -z "$action" ]; then
          action="$1"
        elif [ -z "$path" ]; then
          path="$1"
        else
          die "인자 과다: $1 (op action [path] 만 포지셔널)"
        fi
        shift
        ;;
    esac
  done

  case "$op" in
    plan|research|decide|lesson|code|review) : ;;
    "") die "op 필요 (plan|research|decide|lesson|code|review)" ;;
    *)  die "잘못된 op: $op (plan|research|decide|lesson|code|review)" ;;
  esac
  case "$action" in
    create|update|delete) : ;;
    "") die "action 필요 (create|update|delete)" ;;
    *)  die "잘못된 action: $action (create|update|delete)" ;;
  esac
  [ "${#msgs[@]}" -gt 0 ] || die "-m \"<subject>\" 필요 (산문은 판단 레이어가 쓴다)"

  require_task_worktree
  local id; id="$(index_get id)"
  [ -n "$id" ] || die "task/index.md 에서 id 를 읽을 수 없음"

  local subject="${msgs[0]}"
  require_valid_commit_subject "$subject"
  local ts; ts="$(date '+%Y-%m-%d %H:%M:%S')"
  local logpath="${path:--}"

  {
    printf '\n## [%s] %s · %s %s | %s\n' "$ts" "$op" "$action" "$logpath" "$subject"
    local i
    for ((i=1; i<${#msgs[@]}; i++)); do
      printf '\n%s\n' "${msgs[$i]}"
    done
  } >> "$TASK_DIR/task/log.md"

  if [ -n "$path" ]; then
    git -C "$TASK_DIR" add "$path" "$TASK_DIR/task/log.md"
  else
    git -C "$TASK_DIR" add -A
  fi

  local csubj="$subject"
  case "$subject" in *"(#$id)"*) : ;; *) csubj="$subject (#$id)" ;; esac
  local gitargs=(-C "$TASK_DIR" commit -m "$csubj")
  local i
  for ((i=1; i<${#msgs[@]}; i++)); do
    gitargs+=(-m "${msgs[$i]}")
  done
  git "${gitargs[@]}"

  if [ -z "$nopush" ]; then
    local branch; branch="$(git -C "$TASK_DIR" rev-parse --abbrev-ref HEAD)"
    git -C "$TASK_DIR" push -u origin "$branch"
  fi
}

# ── check ─────────────────────────────────────────────────────────────

ref_exists() { # ref_exists <base>
  local base="$1" genre
  for genre in decisions lessons runbooks; do
    compgen -G "$TASK_DIR/task/docs/$genre/$base.md" >/dev/null && return 0
    compgen -G "$TASK_DIR/task/docs/$genre/$base*.md" >/dev/null && return 0
    compgen -G "$TASK_DIR/docs/$genre/$base.md" >/dev/null && return 0
    compgen -G "$TASK_DIR/docs/$genre/$base*.md" >/dev/null && return 0
  done
  return 1
}

# 기계적 불변식 검사. read-only. 정상이면 무음(0), 위반 시 출력(1).
cmd_check() {
  require_task_worktree
  local branch fail=0
  branch="$(git -C "$TASK_DIR" rev-parse --abbrev-ref HEAD)"

  # 1) log 우회 + subject policy: <base>..HEAD 의 비플럼빙 커밋을 순회한다.
  #    base는 origin/main(신선) — 로컬 main이 낡으면 main의 머지 커밋이 끼어
  #    false-positive가 났다.
  local sha subj files cbase
  cbase="$(main_ref "$TASK_DIR")"
  while IFS= read -r sha; do
    [ -n "$sha" ] || continue
    subj="$(git -C "$TASK_DIR" log -1 --format='%s' "$sha")"
    is_plumbing_subject "$subj" && continue
    if ! is_valid_commit_subject "$subj"; then
      report_invalid_commit_subject "$sha" "$subj"
      fail=1
    fi
    files="$(git -C "$TASK_DIR" show --name-only --format='' "$sha")"
    printf '%s\n' "$files" | grep -qx 'task/log.md' && continue
    echo "✗ log 우회: 커밋 ${sha:0:8} ($subj) 가 task/log.md 미갱신 — workbench task commit 사용" >&2
    fail=1
  done < <(git -C "$TASK_DIR" rev-list "$cbase..$branch" 2>/dev/null)

  # 2) status 신선도: status.md 갱신 이후 커밋 수 > 0.
  local sc cas
  sc="$(git -C "$TASK_DIR" log -1 --format=%H "$branch" -- task/status.md 2>/dev/null || true)"
  if [ -n "$sc" ]; then
    cas="$(git -C "$TASK_DIR" rev-list --count "$sc..$branch" 2>/dev/null || echo 0)"
    if [ "$cas" -gt 0 ]; then
      echo "✗ status 낡음: status.md 갱신 이후 커밋 $cas 개 — status.md 덮어쓸 것" >&2
      fail=1
    fi
  fi

  # 3) push 상태: 미push 커밋(ahead) 또는 origin tracking ref 없음.
  if git -C "$TASK_DIR" remote get-url origin >/dev/null 2>&1; then
    local ahead
    if git -C "$TASK_DIR" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
      ahead="$(git -C "$TASK_DIR" rev-list --count "origin/$branch..$branch" 2>/dev/null || echo 0)"
      if [ "$ahead" -gt 0 ]; then
        echo "✗ 미push: ahead $ahead — git push 또는 workbench task commit 사용" >&2
        fail=1
      fi
    else
      echo "✗ 미push: origin/$branch 없음 — git push -u origin $branch 또는 workbench task commit 사용" >&2
      fail=1
    fi
  fi

  # 4) index frontmatter: 필수 키 비어있지 않음.
  local k
  for k in id issue slug branch; do
    if [ -z "$(index_get "$k")" ]; then
      echo "✗ index frontmatter: '$k' 비어있음" >&2
      fail=1
    fi
  done

  # 5) 깨진 [[ref]]: task-local 또는 root docs harvest 장르에 없으면 경고.
  local f ref base
  while IFS= read -r f; do
    while IFS= read -r ref; do
      base="${ref#[[}"; base="${base%]]}"
      ref_exists "$base" || echo "⚠ 깨진 ref: [[$base]] in ${f#$TASK_DIR/}" >&2
    done < <(
      awk 'BEGIN { fenced=0 } /^```/ { fenced=!fenced; next } !fenced { print }' "$f" \
        | sed -E 's/`[^`]*`//g' \
        | grep -oE '\[\[[^]]+\]\]' || true
    )
  done < <(find "$TASK_DIR/task/docs" -name '*.md' 2>/dev/null)

  return "$fail"
}

