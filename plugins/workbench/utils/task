writer_marker_matches() {
  local wt="$1" origin="$2" gitdir marker
  gitdir="$(git -C "$wt" rev-parse --git-dir 2>/dev/null)" || return 1
  case "$gitdir" in /*) ;; *) gitdir="$wt/$gitdir" ;; esac
  marker="$gitdir/workbench-writer-owner.json"; [ -f "$marker" ] || return 1
  python3 - "$marker" "$WRITER_OPERATION_ID" "$WRITER_CLAIM_ID" "$CURRENT_CLAIM_ID" \
    "task/codebases/$WRITER_OWNER" "$WRITER_CODEBASE_BRANCH" "$origin" <<'PY'
import json, sys
value = json.load(open(sys.argv[1], encoding="utf-8"))
expected = {
    "contract_version": "workbench-writer-worktree-owner/v1",
    "operation_id": sys.argv[2], "claim_id": sys.argv[3], "task_claim_id": sys.argv[4],
    "expected_path": sys.argv[5], "branch": sys.argv[6], "codebase_origin_url": sys.argv[7],
}
raise SystemExit(0 if value == expected and list(value) == list(expected) else 1)
PY
}

writer_worktree_structure_matches_final() {
  local clone_common worktree_common actual_branch actual_origin
  [ -d "$WRITER_WORKTREE" ] || return 1
  actual_branch="$(git -C "$WRITER_WORKTREE" symbolic-ref --short HEAD 2>/dev/null)" \
    || return 1
  [ "$actual_branch" = "$WRITER_CODEBASE_BRANCH" ] || return 1
  actual_origin="$(git -C "$WRITER_WORKTREE" remote get-url origin 2>/dev/null)" || return 1
  [ "$actual_origin" = "$WRITER_CODEBASE_ORIGIN" ] || return 1
  clone_common="$(git -C "$WRITER_CLONE" rev-parse --git-common-dir)" || return 1
  worktree_common="$(git -C "$WRITER_WORKTREE" rev-parse --git-common-dir)" || return 1
  clone_common="$(cd "$WRITER_CLONE" && cd "$clone_common" && pwd -P)" || return 1
  worktree_common="$(cd "$WRITER_WORKTREE" && cd "$worktree_common" && pwd -P)" || return 1
  [ "$clone_common" = "$worktree_common" ]
}

writer_row_dir() { printf '%s/writer-rows\n' "$(task_state_dir)"; }

write_writer_row_final() {
  local file="$1" action="$2" intent="$3" manifest="$4" authorization="$5" tmp
  tmp="$file.tmp.$$"
  {
    printf 'operation_id=%s\n' "$WRITER_OPERATION_ID"; printf 'claim_id=%s\n' "$WRITER_CLAIM_ID"
    printf 'owner=%s\n' "$WRITER_OWNER"; printf 'task_claim_id=%s\n' "$CURRENT_CLAIM_ID"
    printf 'branch=%s\n' "$WRITER_CODEBASE_BRANCH"; printf 'expected_path=task/codebases/%s\n' "$WRITER_OWNER"
    printf 'codebase_origin_url=%s\n' "$WRITER_CODEBASE_ORIGIN"
    printf 'registry_revision=%s\n' "$PROTECTED_REGISTRY_REVISION"
    printf 'registry_digest=%s\n' "$PROTECTED_REGISTRY_DIGEST"
    printf 'context_policy_set_digest=%s\n' "$WRITER_CONTEXT_DIGEST"
    printf 'action_instance_id=%s\n' "$action"; printf 'intent_digest=%s\n' "$intent"
    printf 'policy_manifest_digest=%s\n' "$manifest"; printf 'authorization_ref=%s\n' "$authorization"
  } > "$tmp" && mv "$tmp" "$file"
}

writer_row_matches_values_final() {
  local file="$1" action="$2" intent="$3" manifest="$4" authorization="$5"
  [ -f "$file" ] || return 1
  [ "$(record_get "$file" operation_id)" = "$WRITER_OPERATION_ID" ] \
    && [ "$(record_get "$file" claim_id)" = "$WRITER_CLAIM_ID" ] \
    && [ "$(record_get "$file" owner)" = "$WRITER_OWNER" ] \
    && [ "$(record_get "$file" task_claim_id)" = "$CURRENT_CLAIM_ID" ] \
    && [ "$(record_get "$file" branch)" = "$WRITER_CODEBASE_BRANCH" ] \
    && [ "$(record_get "$file" expected_path)" = "task/codebases/$WRITER_OWNER" ] \
    && [ "$(record_get "$file" codebase_origin_url)" = "$WRITER_CODEBASE_ORIGIN" ] \
    && [ "$(record_get "$file" registry_revision)" = "$WRITER_OPERATION_REGISTRY_REVISION" ] \
    && [ "$(record_get "$file" registry_digest)" = "$WRITER_OPERATION_REGISTRY_DIGEST" ] \
    && [ "$(record_get "$file" context_policy_set_digest)" = "$WRITER_CONTEXT_DIGEST" ] \
    && [ "$(record_get "$file" action_instance_id)" = "$action" ] \
    && [ "$(record_get "$file" intent_digest)" = "$intent" ] \
    && [ "$(record_get "$file" policy_manifest_digest)" = "$manifest" ] \
    && [ "$(record_get "$file" authorization_ref)" = "$authorization" ]
}

writer_row_matches_final() {
  writer_row_matches_values_final "$1" "$WRITER_OPERATION_ACTION" "$WRITER_OPERATION_INTENT" \
    "$WRITER_OPERATION_MANIFEST" "$WRITER_OPERATION_AUTHORIZATION"
}

writer_row_matches_pending_final() {
  writer_row_matches_values_final "$1" "" "" "" ""
}

writer_consumed_matches_final() {
  local ledger="$1" operation="$2" state effect_state effect_device effect_clone
  local clone_common worktree_common actual_branch actual_origin row action_file request_file reduced
  state="$(python3 "$(writer_helper)" ledger-state "$ledger" \
    --operation-id "$WRITER_OPERATION_ID" --claim-id "$WRITER_CLAIM_ID" \
    --operation-file "$operation" --format shell)" || return 1
  [ "$(printf '%s\n' "$state" | sed -n 's/^claim_state=//p')" = active ] || return 1
  effect_state="$(printf '%s\n' "$state" | sed -n 's/^effect_owner_state=//p')"
  effect_device="$(printf '%s\n' "$state" | sed -n 's/^effect_owner_device_id=//p')"
  effect_clone="$(printf '%s\n' "$state" | sed -n 's/^effect_owner_clone_id=//p')"
  [ "$effect_state" = acquired ] && [ "$effect_device" = "$WRITER_DEVICE_ID" ] \
    && [ "$effect_clone" = "$WRITER_CLONE_ID" ] || return 1
  [ -d "$WRITER_WORKTREE" ] \
    && writer_marker_matches "$WRITER_WORKTREE" "$WRITER_CODEBASE_ORIGIN" || return 1
  actual_branch="$(git -C "$WRITER_WORKTREE" symbolic-ref --short HEAD 2>/dev/null)" \
    || return 1
  [ "$actual_branch" = "$WRITER_CODEBASE_BRANCH" ] || return 1
  actual_origin="$(git -C "$WRITER_WORKTREE" remote get-url origin 2>/dev/null)" || return 1
  [ "$actual_origin" = "$WRITER_CODEBASE_ORIGIN" ] || return 1
  clone_common="$(git -C "$WRITER_CLONE" rev-parse --git-common-dir)" || return 1
  worktree_common="$(git -C "$WRITER_WORKTREE" rev-parse --git-common-dir)" || return 1
  clone_common="$(cd "$WRITER_CLONE" && cd "$clone_common" && pwd -P)" || return 1
  worktree_common="$(cd "$WRITER_WORKTREE" && cd "$worktree_common" && pwd -P)" || return 1
  [ "$clone_common" = "$worktree_common" ] || return 1
  repos_block | grep -Fxq -- "- $WRITER_OWNER | $WRITER_CODEBASE_BRANCH | work" || return 1
  row="$(writer_row_dir)/$WRITER_OWNER.record"
  writer_row_matches_final "$row" || return 1
  [ -n "$WRITER_OPERATION_ACTION" ] || return 0
  action_file="$(task_state_dir)/actions/$WRITER_OPERATION_ACTION.record"
  request_file="$(task_state_dir)/actions/$WRITER_OPERATION_ACTION.request.json"
  [ -f "$action_file" ] && [ -f "$request_file" ] || return 1
  reduced="$(python3 "$(effect_helper)" reduce-files --action-file "$action_file" \
    --request-file "$request_file" --primary-file "$row" --primary-kind generic \
    --secondary-state exact)" || return 1
  [ "$(json_string_field "$reduced" decision)" = idempotent ]
}

