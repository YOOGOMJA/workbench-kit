digest_manifest() {
  local manifest="$1" digest
  if command -v sha256sum >/dev/null 2>&1; then digest="$(sha256sum "$manifest" | awk '{print $1}')"
  elif command -v shasum >/dev/null 2>&1; then digest="$(shasum -a 256 "$manifest" | awk '{print $1}')"
  else die "SHA-256 utility not available"; fi
  printf 'sha256:%s\n' "$digest"
}

task_content_digest() {
  local manifest digest
  manifest="$(mktemp "${TMPDIR:-/tmp}/workbench-task-content.XXXXXX")"
  task_content_manifest > "$manifest"; digest="$(digest_manifest "$manifest")"
  rm -f "$manifest"; printf '%s\n' "$digest"
}

task_revision_manifest() {
  local content_revision file check_id subject_ref subject_revision evidence_file stale
  printf 'workbench-task-revision/v1\n'
  content_revision="$(task_content_digest)"; printf 'content_revision\t%s\n' "$content_revision"
  for file in "$(required_check_dir)"/*.record; do
    [ -f "$file" ] || continue
    check_id="$(record_get "$file" check_id)"; subject_ref="$(record_get "$file" subject_ref)"
    subject_revision="$(current_subject_revision "$subject_ref" || true)"
    evidence_file="$(latest_evidence_for_check "$file")"
    if [ -n "$evidence_file" ]; then
      evidence_is_stale "$evidence_file" && stale=true || stale=false
      printf 'evidence\t%s\t%s\t%s\t%s\t%s\t%s\n' "$check_id" "$subject_ref" \
        "$(value_or_null "$subject_revision")" "$(record_get "$evidence_file" evidence_id)" \
        "$(record_get "$evidence_file" result)" "$stale"
    else
      printf 'evidence\t%s\t%s\t%s\tnull\tnull\tfalse\n' "$check_id" "$subject_ref" \
        "$(value_or_null "$subject_revision")"
    fi
  done
}

task_revision_digest() {
  local manifest digest
  manifest="$(mktemp "${TMPDIR:-/tmp}/workbench-task-revision.XXXXXX")"
  task_revision_manifest > "$manifest"; digest="$(digest_manifest "$manifest")"
  rm -f "$manifest"; printf '%s\n' "$digest"
