recover_terminal_effect() {
  local requested="$1" supplied_instance="$2" terminal action_id action_file request_file status
  local latest event expected_event secondary result decision primary_digest intent target revision
  local manifest authorization_ref removal_plan reason_code reason_ref governed_action terminal_pr="-"
  terminal="$(task_state_dir)/terminal"; [ -f "$terminal" ] || return 10
  [ "$(record_get "$terminal" outcome)" = "$requested" ] || return 10
  validate_local_terminal_record || return 10
  action_id="$(record_get "$terminal" action_instance_id)"; [ -n "$action_id" ] || return 10
  [ -z "$supplied_instance" ] || [ "$supplied_instance" = "$action_id" ] || return 10
  action_file="$(task_state_dir)/actions/$action_id.record"
  request_file="$(task_state_dir)/actions/$action_id.request.json"
  [ -f "$action_file" ] && [ -f "$request_file" ] || return 10
  status="$(record_get "$action_file" status)"
  [ -n "$supplied_instance" ] || [ "$status" != consumed ] || return 10
  expected_event="task-${requested}"
  [ "$requested" = completed ] && governed_action=task.complete || governed_action=task.abandon
  if terminal_lifecycle_state "$CURRENT_ROOT" "$CURRENT_HOME" "$CURRENT_ISSUE" "$CURRENT_BRANCH" \
    "$CURRENT_CLAIM_ID" "$(index_get workspace_authority_descriptor_digest)" "$terminal"; then
    secondary=exact
  else
    local lifecycle_rc=$?
    [ "$lifecycle_rc" -eq 10 ] && secondary=missing || secondary=incompatible
  fi
  result="$(python3 "$(effect_helper)" reduce-files --action-file "$action_file" \
    --request-file "$request_file" --primary-file "$terminal" --secondary-state "$secondary")" || return 1
  decision="$(json_string_field "$result" decision)"
  [ "$decision" != blocked ] || { printf '%s\n' "$result"; return 1; }
  if [ "$decision" = idempotent ]; then terminal_outcome_report "$requested"; return 0; fi
  [ "$decision" = reconcile ] || return 10
  intent="$(record_get "$terminal" intent_digest)"; revision="$(record_get "$terminal" revision)"
  if printf '%s' "$result" | grep -Fq '"write_secondary":true'; then
    [ "${SUBMISSION_RECOVERY_ACTIVE:-false}" != true ] \
      || terminal_pr="$SUBMISSION_RECOVERY_PR_NUMBER"
    lifecycle_emit "$CURRENT_ROOT" "$CURRENT_HOME" "$CURRENT_ISSUE" "$expected_event" \
      "$CURRENT_CLAIM_ID" "$CURRENT_BRANCH" "$terminal_pr" "$revision" "$action_id" \
      workbench-task/v2 "" "$intent" \
      || return 1
  fi
  primary_digest="$(json_string_field "$result" primary_digest)"
  target="$(record_get "$action_file" target_ref)"
  consume_governed_action "$governed_action" "$target" "$revision" "$action_id" "$intent" \
    "$primary_digest" || return 1
  manifest="$(record_get "$terminal" policy_manifest_digest)"
  authorization_ref="$(record_get "$terminal" authorization_ref)"
  removal_plan="$(record_get "$terminal" removal_plan_digest)"
  reason_code="$(record_get "$terminal" reason_code)"; reason_ref="$(record_get "$terminal" reason_ref)"
  VERIFY_BLOCKER_COUNT=0; VERIFY_BLOCKER_CODES=(); VERIFY_BLOCKER_REFS=()
  print_outcome_json "$requested" true "$action_id" "$intent" "$manifest" "$authorization_ref" \
    "$revision" "$removal_plan" "$reason_code" "$reason_ref"
  return 0
}

cmd_deliverable() {
  local sub="${1:-}"; [ $# -gt 0 ] && shift || true
  case "$sub" in
    declare)
      local id="" owner="" kind="" owner_context_ref="" acceptance_authority_ref=""
      local required=true external_ref="" revision="" state=declared format=""
      while [ $# -gt 0 ]; do
        case "$1" in
          --id) id="$2"; shift 2 ;; --owner) owner="$2"; shift 2 ;;
          --kind) kind="$2"; shift 2 ;; --required) required="$2"; shift 2 ;;
          --owner-context-ref) owner_context_ref="$2"; shift 2 ;;
          --acceptance-authority-ref) acceptance_authority_ref="$2"; shift 2 ;;
          --external-ref) external_ref="$2"; shift 2 ;; --revision) revision="$2"; shift 2 ;;
          --format) format="$2"; shift 2 ;;
          *) die "unknown option: $1" ;;
        esac
      done
      require_v2_task
      require_mutable_task task.deliverable.declare || return 1
      [ "$format" = json ] || die "unsupported format: ${format:-none}"
      validate_record_id deliverable_id "$id"
      require_single_line owner "$owner"; require_single_line kind "$kind"
      case "$required" in true|false) ;; *) die "required must be true or false" ;; esac
      [ -z "$external_ref" ] || require_single_line external_ref "$external_ref"
      [ -z "$revision" ] || require_single_line revision "$revision"
      case "$kind" in
        codebase-pr|workbench-increment)
          [ -z "$owner_context_ref$acceptance_authority_ref" ] \
            || die "kernel-owned deliverable rejects owner bindings"
          protected_registry_entry "$(wb_root)" "$owner" \
            "$(index_get workspace_authority_descriptor_digest)" \
            || die "protected-codebase-registry-unavailable: $owner"
          ;;
        *:*)
          [ -n "$owner_context_ref" ] && [ -n "$acceptance_authority_ref" ] \
            || die "acceptance-authority-mismatch"
          validate_namespaced_ref "$owner_context_ref"; validate_namespaced_ref "$acceptance_authority_ref"
          local context_state="$(task_state_dir)/policy-context/state.record"
          local context_registration="$(task_state_dir)/policy-context/registration.json"
          [ -f "$context_state" ] && [ "$(record_get "$context_state" sealed)" = true ] \
            && [ -f "$context_registration" ] || die "acceptance-authority-mismatch"
          python3 "$(contract_helper)" registration-owner "$context_registration" \
            --workspace-root "$TASK_DIR" --owner-context-ref "$owner_context_ref" \
            --acceptance-authority-ref "$acceptance_authority_ref" >/dev/null 2>&1 \
            || die "acceptance-authority-mismatch"
          ;;
        *) die "unsupported deliverable kind: $kind" ;;
      esac
      local dir file
      dir="$(deliverable_dir)"; mkdir -p "$dir"; file="$dir/$id.record"
      if [ -f "$file" ]; then
        [ "$(record_get "$file" owner)" = "$owner" ] \
          && [ "$(record_get "$file" kind)" = "$kind" ] \
          && [ "$(record_get "$file" owner_context_ref)" = "$owner_context_ref" ] \
          && [ "$(record_get "$file" acceptance_authority_ref)" = "$acceptance_authority_ref" ] \
          && [ "$(record_get "$file" required)" = "$required" ] \
          && [ "$(record_get "$file" external_ref)" = "$external_ref" ] \
          && [ "$(record_get "$file" revision)" = "$revision" ] \
          && [ "$(record_get "$file" state)" = declared ] \
          || die "conflicting deliverable_id: $id"
        print_deliverable_mutation_json false "$file"
        return 0
      fi
      write_deliverable_record "$file" "$id" "$owner" "$kind" "$owner_context_ref" \
        "$acceptance_authority_ref" "$required" "$external_ref" "$revision" "$state"
      print_deliverable_mutation_json true "$file"
      ;;
    accept)
      local id="" owner_acceptance_file="" instance_id="" authorization_file="" format=""
      while [ $# -gt 0 ]; do
        case "$1" in
          --id) id="$2"; shift 2 ;; --owner-acceptance-file) owner_acceptance_file="$2"; shift 2 ;;
          --action-instance-id) instance_id="$2"; shift 2 ;; --authorization-file) authorization_file="$2"; shift 2 ;;
          --format) format="$2"; shift 2 ;; *) die "unknown option: $1" ;;
        esac
      done
      require_v2_task
      require_mutable_task task.deliverable.accept || return 1
      [ "$format" = json ] || die "unsupported format: ${format:-none}"
      validate_record_id deliverable_id "$id"
      local file owner kind owner_context_ref acceptance_authority_ref required external_ref revision state
      local acceptance_ref acceptance_id acceptance_file
      file="$(deliverable_dir)/$id.record"; [ -f "$file" ] || die "unknown deliverable_id: $id"
      owner="$(record_get "$file" owner)"; kind="$(record_get "$file" kind)"
      owner_context_ref="$(record_get "$file" owner_context_ref)"
      acceptance_authority_ref="$(record_get "$file" acceptance_authority_ref)"
      required="$(record_get "$file" required)"; external_ref="$(record_get "$file" external_ref)"
      revision="$(record_get "$file" revision)"; state="$(record_get "$file" state)"
      acceptance_ref="$(record_get "$file" acceptance_ref)"
      case "$kind" in
        codebase-pr|workbench-increment)
          [ -z "$owner_acceptance_file$instance_id$authorization_file" ] \
            || die "kernel-owned deliverable acceptance does not accept owner authorization inputs"
          if [ -n "$acceptance_ref" ]; then
            acceptance_id="${acceptance_ref#workbench:acceptance/}"
            acceptance_file="$(acceptance_dir)/$acceptance_id.record"
            acceptance_receipt_matches "$file" "$acceptance_file" \
              || die "acceptance-authority-mismatch: $id"
            probe_kernel_deliverable "$file" || die "external-not-accepted: $id"
            [ "$(record_get "$acceptance_file" subject_authority_digest)" = "$PROBE_SUBJECT_DIGEST" ] \
              || die "acceptance-authority-mismatch: $id"
            print_deliverable_acceptance_json false "$file" "$acceptance_file"; return 0
          fi
          [ "$state" = submitted ] || die "deliverable-not-submitted: $id"
          local attempt_dir attempt_file attempt_created attempt_subject
          attempt_dir="$(acceptance_attempt_dir)"; mkdir -p "$attempt_dir" "$(acceptance_dir)"
          attempt_file="$attempt_dir/$id.record"
          if [ -f "$attempt_file" ] && acceptance_attempt_matches "$attempt_file" \
            "$id" "$owner" "$kind" "$external_ref" "$revision"; then
            acceptance_id="$(record_get "$attempt_file" acceptance_id)"
            attempt_created="$(record_get "$attempt_file" created_at)"
          else
            acceptance_id="$(mint_acceptance_id "$id")"; attempt_created="$(utc_now)"
            write_acceptance_attempt "$attempt_file" "$acceptance_id" "$id" "$owner" "$kind" \
              "$external_ref" "$revision" "" "$attempt_created" ""
          fi
          [ "${WORKBENCH_TEST_FAIL_AFTER_ACCEPTANCE_ATTEMPT:-0}" != 1 ] \
            || { echo "error: simulated crash after acceptance attempt" >&2; return 1; }
          probe_kernel_deliverable "$file" || die "external-not-accepted: $id"
          attempt_subject="$(record_get "$attempt_file" subject_authority_digest)"
          acceptance_file="$(acceptance_dir)/$acceptance_id.record"
          if [ -n "$attempt_subject" ] && [ "$attempt_subject" != "$PROBE_SUBJECT_DIGEST" ]; then
            [ ! -e "$acceptance_file" ] || die "acceptance-authority-mismatch: $id"
            acceptance_id="$(mint_acceptance_id "$id")"; attempt_created="$(utc_now)"
          fi
          write_acceptance_attempt "$attempt_file" "$acceptance_id" "$id" "$owner" "$kind" \
            "$external_ref" "$revision" "$PROBE_SUBJECT_DIGEST" "$attempt_created" "$PROBE_OBSERVED_AT"
          [ "${WORKBENCH_TEST_FAIL_AFTER_ACCEPTANCE_PROBE:-0}" != 1 ] \
            || { echo "error: simulated crash after acceptance probe" >&2; return 1; }
          acceptance_ref="workbench:acceptance/$acceptance_id"
          acceptance_file="$(acceptance_dir)/$acceptance_id.record"
          if [ -e "$acceptance_file" ]; then
            acceptance_receipt_matches "$file" "$acceptance_file" \
              && [ "$(record_get "$acceptance_file" acceptance_id)" = "$acceptance_id" ] \
              && [ "$(record_get "$acceptance_file" authority_type)" = kernel-probe ] \
              && [ "$(record_get "$acceptance_file" subject_authority_digest)" = "$PROBE_SUBJECT_DIGEST" ] \
              || die "acceptance-authority-mismatch: $id"
          else
            write_acceptance_record "$acceptance_file" "$acceptance_id" "$id" "$owner" "$kind" "" "" "$revision" \
              kernel-probe workbench-probe/github-pr/v1 "$external_ref" "$PROBE_DIGEST" \
              "$PROBE_SUBJECT_DIGEST" "" "" "" "" "" "$PROBE_OBSERVED_AT"
          fi
          [ "${WORKBENCH_TEST_FAIL_AFTER_ACCEPTANCE_PRIMARY:-0}" != 1 ] \
            || { echo "error: simulated crash after acceptance primary" >&2; return 1; }
          write_deliverable_record "$file" "$id" "$owner" "$kind" "" "" "$required" "$external_ref" "$revision" \
            accepted "$acceptance_ref" "" ""
          print_deliverable_acceptance_json true "$file" "$acceptance_file"
          ;;
        *)
          local recovery_rc
          if recover_pack_acceptance "$file" "$id" "$instance_id"; then return 0
          else recovery_rc=$?; fi
          [ "$recovery_rc" = 10 ] || return "$recovery_rc"
          [ -n "$owner_acceptance_file" ] && [ -f "$owner_acceptance_file" ] \
            || die "pack-owned deliverable requires --owner-acceptance-file"
          [ "$state" = submitted ] || die "deliverable-not-submitted: $id"
          [ -n "$revision" ] || die "pack-owned deliverable requires revision"
          local context_state="$(task_state_dir)/policy-context/state.record"
          local context_registration="$(task_state_dir)/policy-context/registration.json"
          [ -f "$context_state" ] && [ "$(record_get "$context_state" sealed)" = true ] \
            && [ -f "$context_registration" ] || die "acceptance-authority-mismatch"
          python3 "$(contract_helper)" registration-owner "$context_registration" \
            --workspace-root "$TASK_DIR" --owner-context-ref "$owner_context_ref" \
            --acceptance-authority-ref "$acceptance_authority_ref" >/dev/null 2>&1 \
            || die "acceptance-authority-mismatch"
          read_owner_acceptance "$owner_acceptance_file"
          [ "$OWNER_ACCEPTANCE_DELIVERABLE_ID" = "$id" ] \
            && [ "$OWNER_ACCEPTANCE_OWNER" = "$owner" ] \
            && [ "$OWNER_ACCEPTANCE_KIND" = "$kind" ] \
            && [ "$OWNER_ACCEPTANCE_OWNER_CONTEXT_REF" = "$owner_context_ref" ] \
            && [ "$OWNER_ACCEPTANCE_AUTHORITY_REF" = "$acceptance_authority_ref" ] \
            && [ "$OWNER_ACCEPTANCE_REVISION" = "$revision" ] \
            || die "acceptance-authority-mismatch"
          acceptance_id="$OWNER_ACCEPTANCE_ID"; validate_record_id acceptance_id "$acceptance_id"
          acceptance_ref="workbench:acceptance/$acceptance_id"
          acceptance_file="$(acceptance_dir)/$acceptance_id.record"
          if [ -n "$(record_get "$file" acceptance_ref)" ]; then
            [ "$(record_get "$file" acceptance_ref)" = "$acceptance_ref" ] \
              && acceptance_receipt_matches "$file" "$acceptance_file" \
              && [ "$(record_get "$acceptance_file" authority_digest)" = "$OWNER_ACCEPTANCE_DIGEST" ] \
              || die "acceptance-authority-mismatch"
            print_deliverable_acceptance_json false "$file" "$acceptance_file"; return 0
          fi
          [ ! -e "$acceptance_file" ] || die "conflicting acceptance_id: $acceptance_id"
          current_task_identity
          local action_revision target action_file auth_actor auth_at payload_file governed_manifest
          local governed_authorization_ref primary_digest
          action_revision="$(deliverable_record_digest "$file")"; target="workbench:deliverable/$id"
          payload_file="$(mktemp "${TMPDIR:-/tmp}/workbench-accept-intent.XXXXXX")"
          python3 "$(intent_helper)" build-payload \
            --contract workbench-deliverable-accept-intent/v1 \
            --field "deliverable_id=$id" --field "record_revision=$action_revision" \
            --field mode=owner-assertion --field "acceptance_id=$acceptance_id" \
            --field "deliverable_revision=$revision" --field "owner_context_ref=$owner_context_ref" \
            --field "acceptance_authority_ref=$acceptance_authority_ref" \
            --field authority_contract=workbench-owner-acceptance/v1 \
            --field "subject_authority_digest=$OWNER_ACCEPTANCE_DIGEST" \
            --field "actor=$OWNER_ACCEPTANCE_ACTOR" --field "accepted_at=$OWNER_ACCEPTANCE_AT" \
            > "$payload_file" || { rm -f "$payload_file"; die "invalid acceptance intent"; }
          GOVERNED_REQUIRE_EXPLICIT_AUTHORIZATION=1 \
            resolve_governed_action task.deliverable.accept "$target" "$action_revision" \
              "$instance_id" "$authorization_file" workbench-deliverable-accept-intent/v1 "$payload_file"
          rm -f "$payload_file"
          unset GOVERNED_REQUIRE_EXPLICIT_AUTHORIZATION
          case "$GOVERNED_POLICY_RC" in
            0) ;;
            3|4) printf '%s\n' "$GOVERNED_POLICY_OUTPUT"; return "$GOVERNED_POLICY_RC" ;;
            *) return "$GOVERNED_POLICY_RC" ;;
          esac
          action_file="$(task_state_dir)/actions/$GOVERNED_ACTION_INSTANCE_ID.record"
          auth_actor="$(record_get "$action_file" authorization_actor)"
          auth_at="$(record_get "$action_file" authorization_at)"
          governed_manifest="$(record_get "$action_file" policy_manifest_digest)"
          governed_authorization_ref="$(record_get "$action_file" authorization_ref)"
          [ "$auth_actor" = "$OWNER_ACCEPTANCE_ACTOR" ] && [ "$auth_at" = "$OWNER_ACCEPTANCE_AT" ] \
            || die "acceptance-authority-mismatch"
          mkdir -p "$(acceptance_dir)"
          write_acceptance_record "$acceptance_file" "$acceptance_id" "$id" "$owner" "$kind" \
            "$owner_context_ref" "$acceptance_authority_ref" "$revision" owner-authorization \
            workbench-owner-acceptance/v1 "$acceptance_authority_ref" "$OWNER_ACCEPTANCE_DIGEST" \
            "$OWNER_ACCEPTANCE_DIGEST" "$OWNER_ACCEPTANCE_ACTOR" "$GOVERNED_ACTION_INSTANCE_ID" \
            "$GOVERNED_INTENT_DIGEST" "$governed_manifest" "$governed_authorization_ref" \
            "$OWNER_ACCEPTANCE_AT"
          [ "${WORKBENCH_TEST_FAIL_AFTER_ACCEPTANCE_PRIMARY:-0}" != 1 ] \
            || { echo "error: simulated crash after acceptance primary" >&2; return 1; }
          write_deliverable_record "$file" "$id" "$owner" "$kind" "$owner_context_ref" \
            "$acceptance_authority_ref" "$required" "$external_ref" "$revision" accepted \
            "$acceptance_ref"
          primary_digest="$(digest_manifest "$acceptance_file")"
          if ! consume_governed_action task.deliverable.accept "$target" "$action_revision" \
            "$GOVERNED_ACTION_INSTANCE_ID" "$GOVERNED_INTENT_DIGEST" "$primary_digest"; then
            return 1
          fi
          print_deliverable_acceptance_json true "$file" "$acceptance_file"
          ;;
      esac
      ;;
    acceptance)
      [ "${1:-}" = list ] || die "usage: workbench task deliverable acceptance list --format json"
      shift
      local acceptance_format="" acceptance_file first_acceptance=1
      while [ $# -gt 0 ]; do case "$1" in --format) acceptance_format="$2"; shift 2 ;; *) die "unknown option: $1" ;; esac; done
      [ "$acceptance_format" = json ] || die "unsupported format: ${acceptance_format:-none}"
      require_task_worktree
      printf '{"contract_version":"workbench-acceptances/v1","acceptances":['
      for acceptance_file in "$(acceptance_dir)"/*.record; do
        [ -f "$acceptance_file" ] || continue
        [ "$first_acceptance" = 1 ] || printf ','; first_acceptance=0
        print_acceptance_json "$acceptance_file"
      done
      printf ']}\n'
      ;;
    update)
      local id="" external_ref="" revision="" state="" required="" reason_code="" reason_ref=""
      local instance_id="" authorization_file="" authorization_ref="" format=""
      local set_external="" set_revision="" set_state="" set_required=""
      while [ $# -gt 0 ]; do
        case "$1" in
          --id) id="$2"; shift 2 ;;
          --external-ref) external_ref="$2"; set_external=1; shift 2 ;;
          --revision) revision="$2"; set_revision=1; shift 2 ;;
          --state) state="$2"; set_state=1; shift 2 ;;
          --required) required="$2"; set_required=1; shift 2 ;;
          --reason-code) reason_code="$2"; shift 2 ;;
          --reason-ref) reason_ref="$2"; shift 2 ;;
          --action-instance-id) instance_id="$2"; shift 2 ;;
          --authorization-file) authorization_file="$2"; shift 2 ;;
          --format) format="$2"; shift 2 ;;
          *) die "unknown option: $1" ;;
        esac
      done
      require_v2_task
      require_mutable_task task.deliverable.update || return 1
      validate_record_id deliverable_id "$id"
      [ "$format" = json ] || die "unsupported format: ${format:-none}"
      [ -n "$set_external$set_revision$set_state$set_required" ] || die "deliverable update requires a changed field"
      if [ -n "$set_state" ] && [ "$state" = accepted ]; then
        echo "error: accepted state is created only by deliverable accept" >&2
        return 2
      fi
      local file owner kind owner_context_ref acceptance_authority_ref
      local old_required old_external old_revision old_state old_acceptance_ref
      local old_governance_action old_reason_code old_reason_ref old_action_instance old_authorization_ref
      local old_governance_intent old_governance_manifest
      local governance_action="" effect_count=0 reset_governance=false changed=false action_revision target backup
      file="$(deliverable_dir)/$id.record"; [ -f "$file" ] || die "unknown deliverable_id: $id"
      owner="$(record_get "$file" owner)"; kind="$(record_get "$file" kind)"
      owner_context_ref="$(record_get "$file" owner_context_ref)"
      acceptance_authority_ref="$(record_get "$file" acceptance_authority_ref)"
      old_required="$(record_get "$file" required)"; old_external="$(record_get "$file" external_ref)"
      old_revision="$(record_get "$file" revision)"; old_state="$(record_get "$file" state)"
      old_acceptance_ref="$(record_get "$file" acceptance_ref)"
      old_governance_action="$(record_get "$file" governance_action)"
      old_reason_code="$(record_get "$file" reason_code)"; old_reason_ref="$(record_get "$file" reason_ref)"
      old_action_instance="$(record_get "$file" governance_action_instance_id)"
      old_governance_intent="$(record_get "$file" governance_intent_digest)"
      old_governance_manifest="$(record_get "$file" governance_policy_manifest_digest)"
      old_authorization_ref="$(record_get "$file" authorization_ref)"
      local recovery_rc
      if recover_governed_deliverable "$file" "$instance_id"; then return 0
      else recovery_rc=$?; fi
      [ "$recovery_rc" = 10 ] || return "$recovery_rc"
      [ -n "$set_external" ] || external_ref="$old_external"
      [ -n "$set_revision" ] || revision="$old_revision"
      [ -n "$set_state" ] || state="$old_state"
      [ -n "$set_required" ] || required="$old_required"
      case "$required" in true|false) ;; *) die "required must be true or false" ;; esac
      case "$state" in declared|submitted|accepted|waived|rejected) ;; *) die "invalid deliverable state: $state" ;; esac

      if [ -n "$set_required" ] && [ "$required" = false ] \
        && { [ "$old_required" = true ] || [ "$old_governance_action" = task.deliverable.weaken ]; }; then
        governance_action=task.deliverable.weaken; effect_count=$((effect_count + 1))
      fi
      if [ -n "$set_state" ] && [ "$state" = waived ]; then
        governance_action=task.deliverable.waive; effect_count=$((effect_count + 1))
      fi
      if [ -n "$set_state" ] && [ "$state" = rejected ]; then
        governance_action=task.deliverable.reject; effect_count=$((effect_count + 1))
      fi
      if [ "$effect_count" -gt 1 ]; then
        echo "error: deliverable update permits only one governed effect" >&2; return 2
      fi

      if [ "$effect_count" -eq 1 ]; then
        [ -n "$reason_code" ] || { echo "error: governed deliverable update requires --reason-code" >&2; return 2; }
        require_single_line reason_code "$reason_code"; [ -z "$reason_ref" ] || require_single_line reason_ref "$reason_ref"
        case "$governance_action" in
          task.deliverable.weaken)
            if [ -n "$set_external$set_revision$set_state" ]; then
              echo "error: deliverable weaken cannot combine with another update" >&2; return 2
            fi
            ;;
          task.deliverable.waive|task.deliverable.reject)
            if [ -n "$set_external$set_revision$set_required" ]; then
              echo "error: governed deliverable state cannot combine with another update" >&2; return 2
            fi
            ;;
        esac
        if [ "$old_governance_action" = "$governance_action" ] \
          && [ "$old_required" = "$required" ] && [ "$old_state" = "$state" ]; then
          if [ "$old_reason_code" = "$reason_code" ] && [ "$old_reason_ref" = "$reason_ref" ]; then
            print_deliverable_mutation_json false "$file"; return 0
          fi
          die "conflicting governed deliverable result: $id"
        fi
        current_task_identity; action_revision="$(deliverable_record_digest "$file")"
        target="workbench:deliverable/$id"
        local transition="${governance_action##*.}" payload_file
        payload_file="$(mktemp "${TMPDIR:-/tmp}/workbench-deliverable-intent.XXXXXX")"
        python3 "$(intent_helper)" build-payload \
          --contract workbench-deliverable-transition-intent/v1 \
          --field "deliverable_id=$id" --field "record_revision=$action_revision" \
          --field "transition=$transition" --field "from_required=$old_required" \
          --field "to_required=$required" --field "from_state=$old_state" --field "to_state=$state" \
          --field "reason_code=$reason_code" --field "reason_ref=$(value_or_null "$reason_ref")" \
          > "$payload_file" || { rm -f "$payload_file"; die "invalid deliverable transition intent"; }
        resolve_governed_action "$governance_action" "$target" "$action_revision" "$instance_id" \
          "$authorization_file" workbench-deliverable-transition-intent/v1 "$payload_file"
        rm -f "$payload_file"
        case "$GOVERNED_POLICY_RC" in
          0) ;;
          3|4) printf '%s\n' "$GOVERNED_POLICY_OUTPUT"; return "$GOVERNED_POLICY_RC" ;;
          *) return "$GOVERNED_POLICY_RC" ;;
        esac
        authorization_ref="$(json_string_field "$GOVERNED_POLICY_OUTPUT" authorization_ref)"
        local governed_action_file="$(task_state_dir)/actions/$GOVERNED_ACTION_INSTANCE_ID.record"
        local governed_manifest="$(record_get "$governed_action_file" policy_manifest_digest)"
        case "$governance_action" in task.deliverable.waive|task.deliverable.reject) old_acceptance_ref="" ;; esac
        write_deliverable_record "$file" "$id" "$owner" "$kind" "$owner_context_ref" \
          "$acceptance_authority_ref" "$required" "$external_ref" "$revision" "$state" \
          "$old_acceptance_ref" "$governance_action" "$reason_code" "$reason_ref" \
          "$GOVERNED_ACTION_INSTANCE_ID" "$GOVERNED_INTENT_DIGEST" "$governed_manifest" \
          "$authorization_ref"
        local primary_digest="$(digest_manifest "$file")"
        if ! consume_governed_action "$governance_action" "$target" "$action_revision" \
          "$GOVERNED_ACTION_INSTANCE_ID" "$GOVERNED_INTENT_DIGEST" "$primary_digest"; then
          return 1
        fi
        print_deliverable_mutation_json true "$file"; return 0
      fi

      if [ -n "$reason_code$reason_ref$instance_id$authorization_file" ]; then
        echo "error: reason and authorization flags require a governed deliverable effect" >&2; return 2
      fi
      if [ -n "$set_revision" ] && [ "$revision" != "$old_revision" ]; then
        case "$old_state" in
          accepted|waived|rejected)
            case "$state" in
              declared|submitted) ;;
              *) echo "error: changing a terminal deliverable revision requires declared or submitted state" >&2; return 2 ;;
            esac
            ;;
        esac
      fi
      case "$state" in submitted|accepted) [ -n "$revision" ] || die "$state deliverable requires revision" ;; esac
      [ -z "$external_ref" ] || require_single_line external_ref "$external_ref"
      [ -z "$revision" ] || require_single_line revision "$revision"
      if [ -n "$set_required" ] && [ "$required" = true ] && [ "$old_required" = false ]; then
        case "$state" in declared|submitted) reset_governance=true ;; *) echo "error: required can be restored only while declared or submitted" >&2; return 2 ;; esac
      fi
      if [ -n "$set_state" ]; then case "$state" in declared|submitted) reset_governance=true ;; esac; fi
      [ "$external_ref" = "$old_external" ] || changed=true
      [ "$revision" = "$old_revision" ] || changed=true
      [ "$state" = "$old_state" ] || changed=true
      [ "$required" = "$old_required" ] || changed=true
      if [ "$changed" = false ]; then print_deliverable_mutation_json false "$file"; return 0; fi
      governance_action="$old_governance_action"; reason_code="$old_reason_code"; reason_ref="$old_reason_ref"
      instance_id="$old_action_instance"; authorization_ref="$old_authorization_ref"
      if [ "$reset_governance" = true ]; then
        old_acceptance_ref=""; governance_action=""; reason_code=""; reason_ref=""; instance_id=""
        old_governance_intent=""; old_governance_manifest=""; authorization_ref=""
      fi
      write_deliverable_record "$file" "$id" "$owner" "$kind" "$owner_context_ref" \
        "$acceptance_authority_ref" "$required" "$external_ref" "$revision" "$state" \
        "$old_acceptance_ref" "$governance_action" "$reason_code" "$reason_ref" "$instance_id" \
        "$old_governance_intent" "$old_governance_manifest" "$authorization_ref"
      print_deliverable_mutation_json true "$file"
      ;;
    list)
      local format="" dir file first=1
      while [ $# -gt 0 ]; do case "$1" in --format) format="$2"; shift 2 ;; *) die "unknown option: $1" ;; esac; done
      [ "$format" = json ] || die "unsupported format: ${format:-none}"
      require_task_worktree; dir="$(deliverable_dir)"
      printf '{"contract_version":"workbench-deliverables/v1","task_contract":"%s","deliverables":[' "$(index_get task_contract)"
      for file in "$dir"/*.record; do
        [ -f "$file" ] || continue
        [ "$first" = 1 ] || printf ','; first=0; print_deliverable_json "$file"
      done
      printf ']}\n'
      ;;
    *) die "usage: workbench task deliverable declare|update|accept|acceptance|list ..." ;;
  esac
}

write_required_check_record() {
  local file="$1" check_id="$2" owner="$3" deliverable_id="$4" subject_ref="$5" state="$6"
  local governance_action="${7:-}" reason_code="${8:-}" reason_ref="${9:-}"
  local action_instance_id="${10:-}" intent_digest="${11:-}"
  local policy_manifest_digest="${12:-}" authorization_ref="${13:-}" tmp
  tmp="$file.tmp.$$"
  {
    printf 'check_id=%s\n' "$check_id"; printf 'owner=%s\n' "$owner"
    printf 'deliverable_id=%s\n' "$deliverable_id"; printf 'subject_ref=%s\n' "$subject_ref"
    printf 'state=%s\n' "$state"; printf 'governance_action=%s\n' "$governance_action"
    printf 'reason_code=%s\n' "$reason_code"; printf 'reason_ref=%s\n' "$reason_ref"
    printf 'action_instance_id=%s\n' "$action_instance_id"
    printf 'intent_digest=%s\n' "$intent_digest"
    printf 'policy_manifest_digest=%s\n' "$policy_manifest_digest"
    printf 'authorization_ref=%s\n' "$authorization_ref"
  } > "$tmp" && mv "$tmp" "$file"
}

print_required_check_json() {
  local file="$1" check_id owner deliverable_id subject_ref state governance_action reason_code reason_ref
  local action_instance_id intent_digest policy_manifest_digest authorization_ref
  check_id="$(record_get "$file" check_id)"; owner="$(record_get "$file" owner)"
  deliverable_id="$(record_get "$file" deliverable_id)"; subject_ref="$(record_get "$file" subject_ref)"
  state="$(record_get "$file" state)"; governance_action="$(record_get "$file" governance_action)"
  reason_code="$(record_get "$file" reason_code)"; reason_ref="$(record_get "$file" reason_ref)"
  action_instance_id="$(record_get "$file" action_instance_id)"
  intent_digest="$(record_get "$file" intent_digest)"
  policy_manifest_digest="$(record_get "$file" policy_manifest_digest)"
  authorization_ref="$(record_get "$file" authorization_ref)"
  printf '{"check_id":"%s","owner":"%s","deliverable_id":' "$(json_escape "$check_id")" "$(json_escape "$owner")"
  json_nullable "$deliverable_id"; printf ',"subject_ref":"%s","state":"%s","governance_action":' \
    "$(json_escape "$subject_ref")" "$state"
  json_nullable "$governance_action"; printf ',"reason_code":'; json_nullable "$reason_code"
  printf ',"reason_ref":'; json_nullable "$reason_ref"; printf ',"action_instance_id":'
  json_nullable "$action_instance_id"; printf ',"intent_digest":'; json_nullable "$intent_digest"
  printf ',"policy_manifest_digest":'; json_nullable "$policy_manifest_digest"
  printf ',"authorization_ref":'
  json_nullable "$authorization_ref"; printf '}'
}

print_required_check_content_row() {
  local file="$1"
  printf 'required_check\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$(record_get "$file" check_id)" "$(record_get "$file" owner)" "$(record_get "$file" subject_ref)" \
    "$(record_get "$file" state)" "$(value_or_null "$(record_get "$file" reason_code)")" \
    "$(value_or_null "$(record_get "$file" reason_ref)")" \
    "$(value_or_null "$(record_get "$file" action_instance_id)")" \
    "$(value_or_null "$(record_get "$file" intent_digest)")" \
    "$(value_or_null "$(record_get "$file" policy_manifest_digest)")" \
    "$(value_or_null "$(record_get "$file" authorization_ref)")"
}

required_check_record_digest() {
  local file="$1" manifest digest
  manifest="$(mktemp "${TMPDIR:-/tmp}/workbench-required-check-record.XXXXXX")"
  { printf 'workbench-required-check-record/v1\n'; print_required_check_content_row "$file"; } > "$manifest"
  digest="$(digest_manifest "$manifest")"; rm -f "$manifest"; printf '%s\n' "$digest"
}

print_required_check_mutation_json() {
  local changed="$1" file="$2"
  printf '{"contract_version":"workbench-required-checks/v1","task_contract":"workbench-task/v2","changed":%s,"required_check":' "$changed"
  print_required_check_json "$file"; printf '}\n'
}

cmd_required_check() {
  local sub="${1:-}"; [ $# -gt 0 ] && shift || true
  case "$sub" in
    declare)
      local id="" owner="" deliverable_id="" subject_ref format="" dir file deliverable_file
      while [ $# -gt 0 ]; do
        case "$1" in --id) id="$2"; shift 2 ;; --owner) owner="$2"; shift 2 ;;
          --deliverable-id) deliverable_id="$2"; shift 2 ;; --format) format="$2"; shift 2 ;;
          *) die "unknown option: $1" ;; esac
      done
      require_v2_task
      require_mutable_task task.required-check.declare || return 1
      [ "$format" = json ] || die "unsupported format: ${format:-none}"
      validate_record_id check_id "$id"; require_single_line owner "$owner"
      current_task_identity
      if [ -n "$deliverable_id" ]; then
        validate_record_id deliverable_id "$deliverable_id"
        deliverable_file="$(deliverable_dir)/$deliverable_id.record"
        [ -f "$deliverable_file" ] || die "unknown deliverable_id: $deliverable_id"
        [ "$(record_get "$deliverable_file" owner)" = "$owner" ] \
          || die "required-check owner must match deliverable owner"
        subject_ref="workbench:deliverable/$deliverable_id"
      else
        subject_ref="workbench:task/$CURRENT_CLAIM_ID"
      fi
      dir="$(required_check_dir)"; mkdir -p "$dir"; file="$dir/$id.record"
      if [ -f "$file" ]; then
        [ "$(record_get "$file" owner)" = "$owner" ] \
          && [ "$(record_get "$file" deliverable_id)" = "$deliverable_id" ] \
          && [ "$(record_get "$file" subject_ref)" = "$subject_ref" ] \
          && [ "$(record_get "$file" state)" = required ] \
          || die "conflicting check_id: $id"
        print_required_check_mutation_json false "$file"; return 0
      fi
      write_required_check_record "$file" "$id" "$owner" "$deliverable_id" "$subject_ref" required
      print_required_check_mutation_json true "$file"
      ;;
    list)
      local format="" dir file first=1
      while [ $# -gt 0 ]; do case "$1" in --format) format="$2"; shift 2 ;; *) die "unknown option: $1" ;; esac; done
      [ "$format" = json ] || die "unsupported format: ${format:-none}"; require_task_worktree
      dir="$(required_check_dir)"
      printf '{"contract_version":"workbench-required-checks/v1","task_contract":"%s","required_checks":[' "$(index_get task_contract)"
      for file in "$dir"/*.record; do [ -f "$file" ] || continue; [ "$first" = 1 ] || printf ','; first=0; print_required_check_json "$file"; done
      printf ']}\n'
      ;;
    waive)
      local id="" reason_code="" reason_ref="" instance_id="" authorization_file="" format=""
      local file state governance_action old_reason old_reason_ref revision target authorization_ref backup
      while [ $# -gt 0 ]; do
        case "$1" in
          --id) id="$2"; shift 2 ;; --reason-code) reason_code="$2"; shift 2 ;;
          --reason-ref) reason_ref="$2"; shift 2 ;; --action-instance-id) instance_id="$2"; shift 2 ;;
          --authorization-file) authorization_file="$2"; shift 2 ;; --format) format="$2"; shift 2 ;;
          *) die "unknown option: $1" ;;
        esac
      done
      require_v2_task
      require_mutable_task task.required-check.waive || return 1
      [ "$format" = json ] || die "unsupported format: ${format:-none}"
      validate_record_id check_id "$id"
      file="$(required_check_dir)/$id.record"; [ -f "$file" ] || die "unknown check_id: $id"
      local recovery_rc
      if recover_required_check_waiver "$file" "$instance_id"; then return 0
      else recovery_rc=$?; fi
      [ "$recovery_rc" = 10 ] || return "$recovery_rc"
      [ -n "$reason_code" ] || { echo "error: required-check waiver requires --reason-code" >&2; return 2; }
      require_single_line reason_code "$reason_code"; [ -z "$reason_ref" ] || require_single_line reason_ref "$reason_ref"
      state="$(record_get "$file" state)"; governance_action="$(record_get "$file" governance_action)"
      old_reason="$(record_get "$file" reason_code)"; old_reason_ref="$(record_get "$file" reason_ref)"
      if [ "$state" = waived ]; then
        if [ "$governance_action" = task.required-check.waive ] \
          && [ "$old_reason" = "$reason_code" ] && [ "$old_reason_ref" = "$reason_ref" ]; then
          print_required_check_mutation_json false "$file"; return 0
        fi
        die "conflicting required-check waiver: $id"
      fi
      [ "$state" = required ] || die "required-check is not waivable: $id"
      current_task_identity; revision="$(required_check_record_digest "$file")"
      target="workbench:required-check/$id"
      local payload_file="$(mktemp "${TMPDIR:-/tmp}/workbench-check-intent.XXXXXX")"
      python3 "$(intent_helper)" build-payload \
        --contract workbench-required-check-waive-intent/v1 \
        --field "check_id=$id" --field "record_revision=$revision" \
        --field transition=required-to-waived --field "reason_code=$reason_code" \
        --field "reason_ref=$(value_or_null "$reason_ref")" > "$payload_file" \
        || { rm -f "$payload_file"; die "invalid required-check waiver intent"; }
      resolve_governed_action task.required-check.waive "$target" "$revision" "$instance_id" \
        "$authorization_file" workbench-required-check-waive-intent/v1 "$payload_file"
      rm -f "$payload_file"
      case "$GOVERNED_POLICY_RC" in
        0) ;;
        3|4) printf '%s\n' "$GOVERNED_POLICY_OUTPUT"; return "$GOVERNED_POLICY_RC" ;;
        *) return "$GOVERNED_POLICY_RC" ;;
      esac
      authorization_ref="$(json_string_field "$GOVERNED_POLICY_OUTPUT" authorization_ref)"
      local action_file="$(task_state_dir)/actions/$GOVERNED_ACTION_INSTANCE_ID.record"
      local manifest_digest="$(record_get "$action_file" policy_manifest_digest)"
      local owner="$(record_get "$file" owner)" deliverable_id="$(record_get "$file" deliverable_id)"
      local subject_ref="$(record_get "$file" subject_ref)"
      write_required_check_record "$file" "$id" "$owner" "$deliverable_id" "$subject_ref" waived \
        task.required-check.waive "$reason_code" "$reason_ref" "$GOVERNED_ACTION_INSTANCE_ID" \
        "$GOVERNED_INTENT_DIGEST" "$manifest_digest" "$authorization_ref"
      local primary_digest="$(digest_manifest "$file")"
      if ! consume_governed_action task.required-check.waive "$target" "$revision" \
        "$GOVERNED_ACTION_INSTANCE_ID" "$GOVERNED_INTENT_DIGEST" "$primary_digest"; then
        return 1
      fi
      print_required_check_mutation_json true "$file"
      ;;
    *) die "usage: workbench task required-check declare|waive|list ..." ;;
  esac
}

