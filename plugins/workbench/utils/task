#!/usr/bin/env bash
# task 생애주기의 배관(plumbing). 규칙과 용어는 CLAUDE.md 참고.
# 에이전트의 진입점은 스킬(/task-start 등)이며, 이 스크립트는 상태 전이만
# 한다 — 독자가 읽을 산문(PR 제목·본문 등)은 입력으로만 받는다.
#
#   workbench task start <ID> [slug] [--parent N]    task 시작 (워크트리 + 스캐폴드)
#   workbench task add-repo <name> [--ref <base>] [--role work|reference]
#   workbench task writer-operation show|cancel|handoff --operation-id ID --format json
#   workbench task resume <ID> [--parent N]          다른 기기에서 task 재구성
#   workbench task submit --title <t> --body-file <f>   task/ cleanup 커밋 + push + PR
#   workbench task done <ID> [--parent N] [--force]  워크트리·브랜치 정리 (티켓은 건드리지 않음)
#   workbench task commit <op> <action> [path] -m <subject> [-m <body>] [--no-push]
#                                          log append + commit(+#issue) + push
#   workbench task check                             기계적 불변식 검사 (read-only, 정상 무음)
#   workbench task status                            모든 task 현황 구조화 출력 (read-only)
#   workbench task tickets                           열린 workbench 이슈의 task/lifecycle 사실 출력 (read-only)
#   workbench task refs show|set ...                 opaque context/work references
#   workbench task deliverable declare|update|list   task delivery facts
#   workbench task evidence record|list              revision-bound verification facts
#   workbench task verify|complete|abandon            v2 lifecycle outcomes
#
# ID: workbench 이슈는 `42`, codebase 이슈는 `my-app#42`
set -euo pipefail
export LC_ALL=C
export PYTHONDONTWRITEBYTECODE=1

die() { echo "error: $*" >&2; exit 1; }
info() { echo "==> $*"; }

# ── 공통 ──────────────────────────────────────────────────────────────

# workbench main checkout의 절대 경로 (어느 워크트리에서 불려도 동일)
wb_root() {
  local common
  common="$(git rev-parse --git-common-dir)"
  common="$(cd "$common" && pwd)"
  dirname "$common"
}

# 분기·비교의 정본 base. 원격 HEAD는 v2 authority의 default_ref와 검증되어
# 있으므로 main이라는 이름을 가정하지 않는다. 원격이 없으면 현재 브랜치로
# 폴백한다(권한이 필요한 v2 경로는 별도로 authority 검증을 수행한다).
main_ref() {
  local dir="$1" remote_head
  remote_head="$(git -C "$dir" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  if [ -n "$remote_head" ] \
    && git -C "$dir" rev-parse --verify --quiet "$remote_head" >/dev/null 2>&1; then
    printf '%s\n' "$remote_head"
    return
  fi
  if git -C "$dir" rev-parse --verify --quiet origin/main >/dev/null 2>&1; then
    printf '%s\n' origin/main
  else
    printf '%s\n' main
  fi
}

# "repo#42" 또는 "42" → HOME_REPO, ISSUE 전역 변수 설정
parse_id() {
  local id="$1"
  case "$id" in
    *'#'*) HOME_REPO="${id%%#*}"; ISSUE="${id##*#}" ;;
    *)     HOME_REPO="";          ISSUE="$id" ;;
  esac
  echo "$ISSUE" | grep -Eq '^[0-9]+$' || die "잘못된 ID: $id (이슈 번호가 숫자가 아님)"
  if [ -n "$HOME_REPO" ]; then
    validate_home_name "$HOME_REPO" || die "잘못된 ID: $id (repo 이름이 비정규)"
  fi
}

slugify() {
  echo "$1" | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -d- -f1-4
}

validate_home_name() {
  local value="$1"
  printf '%s\n' "$value" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]*$' \
    && ! printf '%s\n' "$value" | grep -Eq '^[0-9]+$'
}

validate_slug() {
  printf '%s\n' "$1" | grep -Eq '^[a-z0-9]+(-[a-z0-9]+){0,3}$'
}

branch_to_dir() { echo "${1//\//__}"; }

utc_now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

json_escape() {
  local value="$1"
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}
  value=${value//$'\r'/\\r}
  value=${value//$'\t'/\\t}
  printf '%s' "$value"
}

json_nullable() {
  if [ -n "$1" ]; then printf '"%s"' "$(json_escape "$1")"; else printf 'null'; fi
}

workspace_schema() {
  local root="$1" marker helper
  marker="$root/.workbench/schema"
  if [ ! -e "$marker" ]; then printf '%s\n' workbench/v1; return 0; fi
  [ -f "$marker" ] || die "invalid workspace schema marker: $marker"
  helper="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)/workbench_contract.py"
  python3 "$helper" schema "$marker" \
    || die "workspace schema marker must contain exactly one supported schema ID"
}

contract_helper() {
  printf '%s/lib/workbench_contract.py\n' "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
}

intent_helper() {
  printf '%s/lib/workbench_intent.py\n' "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
}

effect_helper() {
  printf '%s/lib/workbench_effect.py\n' "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
}

writer_helper() {
  printf '%s/lib/workbench_writer.py\n' "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
}

terminal_helper() {
  printf '%s/lib/workbench_terminal.py\n' "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
}

legacy_helper() {
  printf '%s/lib/workbench_legacy.py\n' "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
}

lifecycle_helper() {
  printf '%s/lib/workbench_lifecycle.py\n' "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
}

observe_workspace_authority() {
  local root="$1" expected_digest="${2:-}" bootstrap_origin remote_lines head_ref head_oid
  local descriptor policy parsed line key value descriptor_file policy_file verification_file adapter
  bootstrap_origin="$(git -C "$root" remote get-url origin 2>/dev/null)" \
    || die "policy-authority-unavailable"
  remote_lines="$(git -C "$root" ls-remote --symref "$bootstrap_origin" HEAD 2>/dev/null)" \
    || die "policy-authority-unavailable"
  head_ref="$(printf '%s\n' "$remote_lines" | awk '$1 == "ref:" && $3 == "HEAD" { print $2 }')"
  head_oid="$(printf '%s\n' "$remote_lines" | awk '$2 == "HEAD" && $1 ~ /^[0-9a-f]+$/ { print $1 }')"
  [ -n "$head_ref" ] && [ -n "$head_oid" ] \
    || die "policy-authority-unavailable"
  printf '%s' "$head_oid" | grep -Eq '^[0-9a-f]{40}([0-9a-f]{24})?$' \
    || die "policy-authority-unavailable"
  git -C "$root" fetch --quiet --no-tags --no-write-fetch-head \
    "$bootstrap_origin" "$head_oid" >/dev/null 2>&1 \
    || die "policy-authority-unavailable"
  descriptor_file="$(mktemp "${TMPDIR:-/tmp}/workbench-authority.XXXXXX")"
  policy_file="$(mktemp "${TMPDIR:-/tmp}/workbench-policy.XXXXXX")"
  verification_file="$(mktemp "${TMPDIR:-/tmp}/workbench-hosting-authority.XXXXXX")"
  if ! git -C "$root" show "$head_oid:.workbench/authority.json" > "$descriptor_file" 2>/dev/null; then
    rm -f "$descriptor_file" "$policy_file" "$verification_file"; die "policy-authority-unavailable"
  fi
  if ! git -C "$root" show "$head_oid:.workbench/policy.conf" > "$policy_file" 2>/dev/null; then
    rm -f "$descriptor_file" "$policy_file" "$verification_file"; die "policy-source-missing"
  fi
  parsed="$(python3 "$(contract_helper)" authority-descriptor "$descriptor_file" 2>/dev/null)" \
    || { rm -f "$descriptor_file" "$policy_file" "$verification_file"; die "policy-authority-unavailable"; }
  AUTHORITY_DESCRIPTOR_DIGEST=""; AUTHORITY_IDENTITY=""; AUTHORITY_ORIGIN_URL=""
  AUTHORITY_DEFAULT_REF=""; AUTHORITY_WORKSPACE_HOME=""
  AUTHORITY_HOSTING_ADAPTER=""; AUTHORITY_HOSTING_REF=""
  while IFS= read -r line; do
    key="${line%%=*}"; value="${line#*=}"
    case "$key" in
      descriptor_digest) AUTHORITY_DESCRIPTOR_DIGEST="$value" ;;
      authority_identity) AUTHORITY_IDENTITY="$value" ;;
      origin_url) AUTHORITY_ORIGIN_URL="$value" ;;
      default_ref) AUTHORITY_DEFAULT_REF="$value" ;;
      workspace_home) AUTHORITY_WORKSPACE_HOME="$value" ;;
      hosting_adapter) AUTHORITY_HOSTING_ADAPTER="$value" ;;
      hosting_ref) AUTHORITY_HOSTING_REF="$value" ;;
    esac
  done <<< "$parsed"
  descriptor="${AUTHORITY_DESCRIPTOR_DIGEST:-}"; policy="${AUTHORITY_ORIGIN_URL:-}"
  [ -n "$descriptor" ] && [ -n "$policy" ] \
    || { rm -f "$descriptor_file" "$policy_file" "$verification_file"; die "policy-authority-unavailable"; }
  [ "$AUTHORITY_ORIGIN_URL" = "$bootstrap_origin" ] && [ "$AUTHORITY_DEFAULT_REF" = "$head_ref" ] \
    || { rm -f "$descriptor_file" "$policy_file" "$verification_file"; die "policy-authority-mismatch"; }
  [ -z "$expected_digest" ] || [ "$descriptor" = "$expected_digest" ] \
    || { rm -f "$descriptor_file" "$policy_file" "$verification_file"; die "policy-authority-mismatch"; }
  adapter="${WORKBENCH_TRUSTED_HOSTING_ADAPTER:-}"
  [ -n "$adapter" ] && [ -x "$adapter" ] \
    || { rm -f "$descriptor_file" "$policy_file" "$verification_file"; die "policy-authority-unavailable"; }
  "$adapter" authority --authority-file "$descriptor_file" --default-revision "$head_oid" \
    --format json > "$verification_file" 2>/dev/null \
    || { rm -f "$descriptor_file" "$policy_file" "$verification_file"; die "policy-authority-unavailable"; }
  python3 "$(contract_helper)" hosting-authority --authority-file "$descriptor_file" \
    --verification-file "$verification_file" --default-revision "$head_oid" >/dev/null 2>&1 \
    || { rm -f "$descriptor_file" "$policy_file" "$verification_file"; die "policy-authority-mismatch"; }
  rm -f "$descriptor_file" "$policy_file" "$verification_file"
  AUTHORITY_REVISION="$head_oid"
}

protected_registry_entry() {
  local root="$1" owner="$2" expected_digest="${3:-}" tmpdir authority registry parsed line key value
  observe_workspace_authority "$root" "$expected_digest"
  tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/workbench-protected-registry.XXXXXX")"
  authority="$tmpdir/authority.json"; registry="$tmpdir/codebases.yaml"
  git -C "$root" show "$AUTHORITY_REVISION:.workbench/authority.json" > "$authority" 2>/dev/null \
    && git -C "$root" show "$AUTHORITY_REVISION:codebases.yaml" > "$registry" 2>/dev/null \
    || { rm -rf "$tmpdir"; return 1; }
  parsed="$(python3 "$(legacy_helper)" registry-snapshot --authority-file "$authority" \
    --registry-file "$registry" --source-revision "$AUTHORITY_REVISION" \
    --owner "$owner" --format shell 2>/dev/null)" \
    || { rm -rf "$tmpdir"; return 1; }
  PROTECTED_REGISTRY_REVISION=""; PROTECTED_REGISTRY_DESCRIPTOR_DIGEST=""
  PROTECTED_REGISTRY_DIGEST=""; PROTECTED_REGISTRY_OWNER=""; PROTECTED_REGISTRY_ORIGIN=""
  while IFS= read -r line; do
    key="${line%%=*}"; value="${line#*=}"
    case "$key" in
      source_revision) PROTECTED_REGISTRY_REVISION="$value" ;;
      descriptor_digest) PROTECTED_REGISTRY_DESCRIPTOR_DIGEST="$value" ;;
      registry_digest) PROTECTED_REGISTRY_DIGEST="$value" ;;
      owner) PROTECTED_REGISTRY_OWNER="$value" ;;
      origin_url) PROTECTED_REGISTRY_ORIGIN="$value" ;;
    esac
  done <<< "$parsed"
  rm -rf "$tmpdir"
  [ "$PROTECTED_REGISTRY_REVISION" = "$AUTHORITY_REVISION" ] \
    && [ "$PROTECTED_REGISTRY_DESCRIPTOR_DIGEST" = "$AUTHORITY_DESCRIPTOR_DIGEST" ] \
    && [ "$PROTECTED_REGISTRY_OWNER" = "$owner" ] \
    && [ -n "$PROTECTED_REGISTRY_ORIGIN" ] \
    && printf '%s' "$PROTECTED_REGISTRY_DIGEST" | grep -Eq '^sha256:[0-9a-f]{64}$'
}

require_v2_task() {
  require_task_worktree
  local root schema task_contract
  root="$(wb_root)"; schema="$(workspace_schema "$root")"
  [ "$schema" = workbench/v2 ] \
    || die "v2 task mutation requires workbench/v2 (caller is $schema; migrate first)"
  [ -f "$TASK_DIR/task/index.md" ] || die "task/index.md not found"
  task_contract="$(index_get task_contract)"
  [ -n "$task_contract" ] || task_contract=workbench-task/v1
  [ "$task_contract" = workbench-task/v2 ] \
    || die "v2 task mutation requires workbench-task/v2 (task is $task_contract)"
  if ! git -C "$TASK_DIR" ls-files --error-unmatch task/index.md >/dev/null 2>&1; then
    submission_recovery_guard \
      || die "authenticated submitted task recovery is unavailable"
  fi
}

require_single_line() {
  local label="$1" value="$2"
  [ -n "$value" ] || die "$label must not be empty"
  case "$value" in *$'\n'*|*$'\r'*|*$'\t'*) die "$label must be a single line without tabs" ;; esac
}

safe_field() {
  printf '%s' "$1" | tr '[:space:]' '_'
}

actor_id() {
  local root="$1" actor
  actor="$(git -C "$root" config user.email 2>/dev/null || true)"
  [ -n "$actor" ] || actor="$(git -C "$root" config user.name 2>/dev/null || true)"
  [ -n "$actor" ] || actor="$(whoami 2>/dev/null || echo unknown)"
  safe_field "$actor"
}

lifecycle_issue_dir() {
  local root="$1" home="$2" wbname
  # home은 codebase 이슈일 때만 .codebases/<home>로 푼다. workbench 이슈는
  # 이름 규칙상 home이 비어야 정상이지만, 누군가 home에 워크벤치 자기 이름
  # (origin repo명)을 채우면 없는 .codebases/<workbench>를 찾아 emit이 실패한다.
  # 빈 값과 워크벤치 자기 이름을 모두 root로 방어적으로 해석한다.
  wbname="$(basename "$(git -C "$root" remote get-url origin 2>/dev/null || echo "$root")" .git)"
  if [ -n "$home" ] && [ "$home" != "$wbname" ]; then
    printf '%s/.codebases/%s\n' "$root" "$home"
  else
    printf '%s\n' "$root"
  fi
}

make_claim_id() {
  local branch="$1"
  printf '%s-%s-%s\n' "$(branch_to_dir "$branch")" "$(date -u +%Y%m%dT%H%M%SZ)" "$$"
}

lifecycle_emit() {
  local root="$1" home="$2" issue="$3" event="$4" claim_id="$5" branch="$6" pr="${7:--}"
  local revision="${8:-}" action_instance_id="${9:-}" task_contract_override="${10:-}"
  local authority_descriptor_digest="${11:-}"
  local intent_digest="${12:-}"
  local dir body_file home_field pr_field marker_id task_contract task_index task_dir
  dir="$(lifecycle_issue_dir "$root" "$home")"
  [ -d "$dir" ] || { echo "error: lifecycle issue repo 없음: $dir" >&2; return 1; }
  home_field="${home:--}"
  pr_field="${pr:--}"
  task_contract="$task_contract_override"
  if [ -z "$task_contract" ]; then
    task_dir="$root/.worktrees/$(branch_to_dir "$branch")"
    task_index="$task_dir/task/index.md"
    if [ -f "$task_index" ]; then
      task_contract="$(sed -n '/^---$/,/^---$/p' "$task_index" | sed -n 's/^task_contract: *//p' | head -1)"
      [ -n "$task_contract" ] || task_contract=workbench-task/v1
    elif [ "$event" = task-claimed ] || [ "$event" = task-claim-conflict ]; then
      [ "$(workspace_schema "$root")" = workbench/v2 ] && task_contract=workbench-task/v2 || task_contract=workbench-task/v1
    else
      task_contract=workbench-task/v1
    fi
  fi
  [ "$task_contract" = workbench-task/v2 ] && marker_id=workbench-task-lifecycle:v2 || marker_id=workbench-task-lifecycle:v1
  body_file="$(mktemp "${TMPDIR:-/tmp}/workbench-task-lifecycle.XXXXXX")"
  if [ "$marker_id" = workbench-task-lifecycle:v2 ]; then
    local home_json pr_json revision_json action_json intent_json
    [ -n "$home" ] && home_json="\"$(json_escape "$home")\"" || home_json=null
    if [ -n "$pr" ] && [ "$pr" != - ]; then
      printf '%s' "$pr" | grep -Eq '^[0-9]+$' || die "lifecycle pr must be numeric"
      pr_json="$pr"
    else pr_json=null; fi
    [ -n "$revision" ] && revision_json="\"$(json_escape "$revision")\"" || revision_json=null
    [ -n "$action_instance_id" ] && action_json="\"$(json_escape "$action_instance_id")\"" || action_json=null
    [ -n "$intent_digest" ] && intent_json="\"$(json_escape "$intent_digest")\"" || intent_json=null
    if [ -z "$authority_descriptor_digest" ] && [ -f "${task_index:-}" ]; then
      authority_descriptor_digest="$(sed -n '/^---$/,/^---$/p' "$task_index" \
        | sed -n 's/^workspace_authority_descriptor_digest: *//p' | head -1)"
    fi
    if [ -z "$authority_descriptor_digest" ]; then
      local prior_lifecycle
      prior_lifecycle="$(lifecycle_latest_for_branch "$root" "$home" "$issue" "$branch")"
      authority_descriptor_digest="$(lifecycle_field "$prior_lifecycle" workspace_authority_descriptor_digest)"
    fi
    printf '%s' "$authority_descriptor_digest" | grep -Eq '^sha256:[0-9a-f]{64}$' \
      || { rm -f "$body_file"; die "missing workspace authority descriptor digest"; }
    cat > "$body_file" <<EOF
<!-- workbench-task-lifecycle:v2
{"task_contract":"workbench-task/v2","event":"$(json_escape "$event")","claim_id":"$(json_escape "$claim_id")","issue":$issue,"home":$home_json,"branch":"$(json_escape "$branch")","workspace_authority_descriptor_digest":"$authority_descriptor_digest","pr":$pr_json,"revision":$revision_json,"action_instance_id":$action_json,"intent_digest":$intent_json,"actor":"$(json_escape "$(actor_id "$root")")","tool":"workbench","at":"$(utc_now)"}
-->
workbench task lifecycle: $(safe_field "$event") \`$branch\`
EOF
  else
    cat > "$body_file" <<EOF
<!-- workbench-task-lifecycle:v1 event=$(safe_field "$event") claim_id=$(safe_field "$claim_id") issue=$(safe_field "$issue") home=$(safe_field "$home_field") branch=$(safe_field "$branch") pr=$(safe_field "$pr_field") actor=$(actor_id "$root") tool=utils/task at=$(utc_now) -->
workbench task lifecycle: $(safe_field "$event") \`$branch\`
EOF
  fi
  if ! (cd "$dir" && gh issue comment "$issue" --body-file "$body_file") >/dev/null; then
    rm -f "$body_file"
    return 1
  fi
  rm -f "$body_file"
}

lifecycle_emit_optional() {
  local event="$4"
  if ! lifecycle_emit "$@"; then
    echo "warn: lifecycle event 기록 실패: $event" >&2
  fi
}

lifecycle_markers_for_issue() {
  local root="$1" home="$2" issue="$3" dir adapter origin observation
  dir="$(lifecycle_issue_dir "$root" "$home")"
  [ -d "$dir" ] || return 1
  adapter="${WORKBENCH_TRUSTED_HOSTING_ADAPTER:-}"
  [ -n "$adapter" ] && [ -x "$adapter" ] || return 1
  origin="$(git -C "$dir" remote get-url origin 2>/dev/null)" || return 1
  observation="$(mktemp "${TMPDIR:-/tmp}/workbench-lifecycle-observation.XXXXXX")"
  if ! (cd "$dir" && "$adapter" lifecycle --repository "$dir" --issue "$issue" --format json) \
    > "$observation" 2>/dev/null; then
    rm -f "$observation"; return 1
  fi
  python3 "$(lifecycle_helper)" markers --observation-file "$observation" \
    --repository-origin-url "$origin" --issue "$issue" --format jsonl
  local rc=$?; rm -f "$observation"; return "$rc"
}

lifecycle_field() {
  local line="$1" key="$2"
  case "$line" in
    \{*)
      printf '%s\n' "$line" | python3 -c '
import json, sys
value = json.load(sys.stdin).get(sys.argv[1])
if value is not None:
    print(value)
' "$key"
      ;;
    *) printf '%s\n' "$line" | tr ' ' '\n' | sed -n "s/^$key=//p" | head -1 | sed 's/-->$//' ;;
  esac
}

lifecycle_latest_for_branch() {
  local root="$1" home="$2" issue="$3" branch="$4" line latest="" markers
  markers="$(lifecycle_markers_for_issue "$root" "$home" "$issue")" || return 2
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    [ "$(lifecycle_field "$line" branch)" = "$branch" ] && latest="$line"
  done <<< "$markers"
  [ -z "$latest" ] || printf '%s\n' "$latest"
}

lifecycle_latest_for_issue() {
  local root="$1" home="$2" issue="$3" markers
  markers="$(lifecycle_markers_for_issue "$root" "$home" "$issue")" || return 2
  printf '%s\n' "$markers" | awk '{ line=$0 } END { if (line) print line }'
}

lifecycle_identity_for_branch() {
  local root="$1" home="$2" issue="$3" branch="$4" markers line contract="" claim="" descriptor=""
  local value
  LIFECYCLE_IDENTITY_CONTRACT=""; LIFECYCLE_IDENTITY_CLAIM_ID=""
  LIFECYCLE_IDENTITY_DESCRIPTOR_DIGEST=""
  markers="$(lifecycle_markers_for_issue "$root" "$home" "$issue")" || return 1
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    [ "$(lifecycle_field "$line" branch)" = "$branch" ] || continue
    value="$(lifecycle_field "$line" task_contract)"
    if [ -z "$contract" ]; then contract="$value"; else [ "$contract" = "$value" ] || return 1; fi
    value="$(lifecycle_field "$line" claim_id)"
    if [ -z "$claim" ]; then claim="$value"; else [ "$claim" = "$value" ] || return 1; fi
    [ "$(lifecycle_field "$line" issue)" = "$issue" ] \
      && [ "$(lifecycle_field "$line" home)" = "$home" ] || return 1
    if [ "$contract" = workbench-task/v2 ]; then
      value="$(lifecycle_field "$line" workspace_authority_descriptor_digest)"
      if [ -z "$descriptor" ]; then descriptor="$value"; else [ "$descriptor" = "$value" ] || return 1; fi
    fi
  done <<< "$markers"
  [ -n "$contract" ] && [ -n "$claim" ] || return 1
  [ "$contract" != workbench-task/v2 ] || [ -n "$descriptor" ] || return 1
  LIFECYCLE_IDENTITY_CONTRACT="$contract"
  LIFECYCLE_IDENTITY_CLAIM_ID="$claim"
  LIFECYCLE_IDENTITY_DESCRIPTOR_DIGEST="$descriptor"
}

lifecycle_contract_for_branch() {
  lifecycle_identity_for_branch "$@" || return 1
  printf '%s\n' "$LIFECYCLE_IDENTITY_CONTRACT"
}

terminal_lifecycle_state() {
  local root="$1" home="$2" issue="$3" branch="$4" claim="$5" descriptor="$6" terminal="$7"
  local markers line contract event current=false current_pr="" marker_pr terminal_count=0 expected
  local outcome revision action intent terminal_seen=false cleaned=false
  outcome="$(record_get "$terminal" outcome)"; expected="task-$outcome"
  revision="$(record_get "$terminal" revision)"; action="$(record_get "$terminal" action_instance_id)"
  intent="$(record_get "$terminal" intent_digest)"
  markers="$(lifecycle_markers_for_issue "$root" "$home" "$issue")" || return 1
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    [ "$(lifecycle_field "$line" branch)" = "$branch" ] || continue
    contract="$(lifecycle_field "$line" task_contract)"
    [ "$contract" = workbench-task/v2 ] \
      && [ "$(lifecycle_field "$line" claim_id)" = "$claim" ] \
      && [ "$(lifecycle_field "$line" issue)" = "$issue" ] \
      && [ "$(lifecycle_field "$line" home)" = "$home" ] \
      && [ "$(lifecycle_field "$line" workspace_authority_descriptor_digest)" = "$descriptor" ] \
      || return 1
    event="$(lifecycle_field "$line" event)"
    if [ "$terminal_seen" = true ]; then
      [ "$event" = task-cleaned ] && [ "$cleaned" = false ] || return 1
      cleaned=true; current=false; current_pr=""
      continue
    fi
    case "$event" in
      task-submitted) current=true; current_pr="$(lifecycle_field "$line" pr)" ;;
      task-active) current=false; current_pr="" ;;
      task-completed|task-abandoned)
        terminal_count=$((terminal_count + 1))
        marker_pr="$(lifecycle_field "$line" pr)"
        [ -z "$marker_pr" ] || { [ "$current" = true ] && [ "$marker_pr" = "$current_pr" ]; } \
          || return 1
        [ "$event" = "$expected" ] \
          && [ "$(lifecycle_field "$line" revision)" = "$revision" ] \
          && [ "$(lifecycle_field "$line" action_instance_id)" = "$action" ] \
          && [ "$(lifecycle_field "$line" intent_digest)" = "$intent" ] \
          || return 1
        terminal_seen=true
        ;;
      task-cleaned) return 1 ;;
    esac
  done <<< "$markers"
  [ "$terminal_count" -eq 0 ] && return 10
  [ "$terminal_count" -eq 1 ]
}

lifecycle_claim_for_branch() {
  local root="$1" home="$2" issue="$3" branch="$4" latest claim_id
  latest="$(lifecycle_latest_for_branch "$root" "$home" "$issue" "$branch")" || return 1
  claim_id="$(lifecycle_field "$latest" claim_id)"
  printf '%s\n' "${claim_id:-$branch}"
}

pr_number_from_url() {
  local pr_url="$1" pr
  pr="${pr_url##*/}"
  case "$pr" in
    ''|*[!0-9]*) printf '%s\n' '-' ;;
    *) printf '%s\n' "$pr" ;;
  esac
}

# 현재 위치가 task 워크트리인지 확인하고 TASK_DIR 설정
require_task_worktree() {
  TASK_DIR="$(git rev-parse --show-toplevel 2>/dev/null)" || die "git 저장소가 아님"
  case "$TASK_DIR" in
    */.worktrees/*) : ;;
    *) die "task 워크트리 안에서 실행해야 한다 (.worktrees/ 하위가 아님)" ;;
  esac
}

index_get() { # index_get <key> — frontmatter에서 값 읽기
  sed -n '/^---$/,/^---$/p' "$TASK_DIR/task/index.md" | sed -n "s/^$1: *//p" | head -1
}

repos_block() {
  [ -f "$TASK_DIR/task/index.md" ] || return 0
  sed -n '/<!-- repos:begin -->/,/<!-- repos:end -->/p' "$TASK_DIR/task/index.md" | grep '^- ' || true
}

repos_append() {
  local line="$1" f="$TASK_DIR/task/index.md"
  awk -v line="$line" '/<!-- repos:end -->/ { print line } { print }' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
}

task_remote_branches() {
  local root="$1" remote_set
  if remote_set="$(git -C "$root" ls-remote --heads origin 'refs/heads/task/*' 2>/dev/null)"; then
    printf '%s\n' "$remote_set" | sed 's#.*refs/heads/##'
  else
    git -C "$root" for-each-ref --format='%(refname:short)' \
      refs/remotes/origin/task/ 2>/dev/null | sed 's#^origin/##'
  fi
}

task_known_branches() {
  local root="$1"
  {
    git -C "$root" for-each-ref --format='%(refname:short)' \
      refs/heads/task/ refs/remotes/origin/task/ 2>/dev/null | sed 's#^origin/##'
    task_remote_branches "$root"
  } | sed '/^$/d' | sort -u
}

branch_home_issue() {
  # Parse a task branch into "home|parent|issue".
  # Grammar: task/[home/][parent/]<issue>-<slug>  (home non-numeric, parent numeric)
  local branch="$1" issue rest last prefix first second seg_home="" seg_parent=""
  case "$branch" in task/*) : ;; *) return 1 ;; esac
  rest="${branch#task/}"
  last="${rest##*/}"
  issue="${last%%-*}"
  echo "$issue" | grep -Eq '^[0-9]+$' || return 1
  if [ "$rest" = "$last" ]; then
    prefix=""
  else
    prefix="${rest%/$last}"
  fi
  if [ -n "$prefix" ]; then
    first="${prefix%%/*}"
    if echo "$first" | grep -Eq '^[0-9]+$'; then
      seg_parent="$first"
    else
      seg_home="$first"
      if [ "$prefix" != "$first" ]; then
        second="${prefix#*/}"; second="${second%%/*}"
        echo "$second" | grep -Eq '^[0-9]+$' && seg_parent="$second"
      fi
    fi
  fi
  printf '%s|%s|%s\n' "$seg_home" "$seg_parent" "$issue"
}

branch_matches_issue() {
  # Match on (home, issue); if a parent is given it must match too. A task ID
  # carries no parent, so same-issue tasks under different parents are
  # distinguished only when the caller supplies --parent (see find_branches).
  local branch="$1" home="$2" issue="$3" parent="${4:-}" parsed seg_home seg_parent seg_issue
  parsed="$(branch_home_issue "$branch")" || return 1
  IFS='|' read -r seg_home seg_parent seg_issue <<< "$parsed"
  [ "$seg_home" = "$home" ] && [ "$seg_issue" = "$issue" ] || return 1
  [ -z "$parent" ] || [ "$seg_parent" = "$parent" ]
}

find_branch_in_list() {
  local branches="$1" home="$2" issue="$3" branch
  while IFS= read -r branch; do
    [ -n "$branch" ] || continue
    if branch_matches_issue "$branch" "$home" "$issue"; then
      echo "$branch"
      return 0
    fi
  done <<< "$branches"
  return 1
}

# ID(+선택적 parent)에 매칭되는 모든 task 브랜치 (로컬·tracking·진짜 origin 합집합).
# 한 줄에 하나씩 출력. parent를 주면 같은 이슈의 다른 parent task와 구분된다.
find_branches() {
  local home="$1" issue="$2" parent="${3:-}" root branches branch found=1
  root="$(wb_root)"
  branches="$(task_known_branches "$root")"
  while IFS= read -r branch; do
    [ -n "$branch" ] || continue
    if branch_matches_issue "$branch" "$home" "$issue" "$parent"; then
      echo "$branch"; found=0
    fi
  done <<< "$branches"
  return $found
}

# ID를 정확히 하나의 task 브랜치로 해석. 없으면 1을 반환하고, 같은 이슈가 여러
# parent에 걸쳐 모호하면(그리고 parent로 좁혀지지 않으면) die한다.
resolve_branch() {
  local home="$1" issue="$2" parent="${3:-}" id="$4" matches
  matches="$(find_branches "$home" "$issue" "$parent")" \
    || die "task 브랜치를 찾을 수 없음: $id"
  if [ "$(printf '%s\n' "$matches" | wc -l | tr -d ' ')" -gt 1 ]; then
    die "이슈 ${home:+$home#}$issue 에 매칭되는 task가 여럿 (parent가 다름):
$matches
--parent <N> 로 구분할 것"
  fi
  printf '%s\n' "$matches"
}

# ── start ─────────────────────────────────────────────────────────────

print_task_start_json() {
  local dir="$1" changed="$2" index="$dir/task/index.md" state context_ref work_ref sealed=false
  local claim_id branch descriptor_digest owners owner first=1
  claim_id="$(sed -n '/^---$/,/^---$/p' "$index" | sed -n 's/^claim_id: *//p' | head -1)"
  branch="$(sed -n '/^---$/,/^---$/p' "$index" | sed -n 's/^branch: *//p' | head -1)"
  descriptor_digest="$(sed -n '/^---$/,/^---$/p' "$index" \
    | sed -n 's/^workspace_authority_descriptor_digest: *//p' | head -1)"
  context_ref="$(sed -n '/^---$/,/^---$/p' "$index" | sed -n 's/^context_ref: *//p' | head -1)"
  work_ref="$(sed -n '/^---$/,/^---$/p' "$index" | sed -n 's/^work_ref: *//p' | head -1)"
  state="$dir/task/.workbench/policy-context/state.record"
  [ -f "$state" ] && [ "$(record_get "$state" sealed)" = true ] && sealed=true
  owners="$(work_owners_from_index "$index" | sort -u)"
  printf '{"contract_version":"workbench-task-start/v2","task_contract":"workbench-task/v2","task_claim_id":"%s","branch":"%s","workspace_authority_descriptor_digest":"%s","context_ref":' \
    "$(json_escape "$claim_id")" "$(json_escape "$branch")" "$descriptor_digest"
  json_nullable "$context_ref"; printf ',"work_ref":'; json_nullable "$work_ref"
  printf ',"context_policy_sealed":%s,"work_owners":[' "$sealed"
  while IFS= read -r owner; do
    [ -n "$owner" ] || continue; [ "$first" = 1 ] || printf ','; first=0
    printf '"%s"' "$(json_escape "$owner")"
  done <<< "$owners"
  printf '],"changed":%s}\n' "$changed"
}

cmd_start() {
  local id="" slug="" parent="" format=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --parent) parent="$2"; shift 2 ;;
      --format) format="$2"; shift 2 ;;
      --*) die "unknown option: $1" ;;
      *) if [ -z "$id" ]; then id="$1"; else slug="$1"; fi; shift ;;
    esac
  done
  [ -n "$id" ] || die "usage: workbench task start <ID> [slug] [--parent N] [--format json]"
  parse_id "$id"

  local root new_task_contract="" authority_descriptor_digest=""; root="$(wb_root)"
  if [ "$(workspace_schema "$root")" = workbench/v2 ]; then
    new_task_contract=workbench-task/v2
    [ "$format" = json ] || die "v2 task start requires --format json"
    observe_workspace_authority "$root"
    authority_descriptor_digest="$AUTHORITY_DESCRIPTOR_DIGEST"
  else
    [ -z "$format" ] || die "v1 task start does not support --format"
  fi
  if find_branches "$HOME_REPO" "$ISSUE" "$parent" >/dev/null 2>&1; then
    die "이미 존재하는 task: $(find_branches "$HOME_REPO" "$ISSUE" "$parent" | head -1) — task resume $id 를 쓸 것"
  fi

  # 이슈 원문 조회 (가능하면) — 원본 소스 보존용
  local lookup_dir="$root" title="" body="" issue_src="workbench#$ISSUE"
  if [ -n "$HOME_REPO" ]; then
    lookup_dir="$root/.codebases/$HOME_REPO"
    issue_src="$HOME_REPO#$ISSUE"
  fi
  if [ -d "$lookup_dir" ]; then
    title="$( (cd "$lookup_dir" && gh issue view "$ISSUE" --json title -q .title) 2>/dev/null || true)"
    body="$( (cd "$lookup_dir" && gh issue view "$ISSUE" --json body -q .body) 2>/dev/null || true)"
  fi
  if [ -z "$slug" ]; then
    [ -n "$title" ] || die "이슈 제목 조회 실패 — slug를 직접 지정할 것: task start $id <slug>"
    slug="$(slugify "$title")"
  fi
  validate_slug "$slug" || die "invalid task slug: $slug"

  local branch="task/${HOME_REPO:+$HOME_REPO/}${parent:+$parent/}${ISSUE}-${slug}"
  local dir="$root/.worktrees/$(branch_to_dir "$branch")"
  local claim_id; claim_id="$(make_claim_id "$branch")"

  lifecycle_emit "$root" "$HOME_REPO" "$ISSUE" task-claimed "$claim_id" "$branch" - "" "" \
    "${new_task_contract:-workbench-task/v1}" "$authority_descriptor_digest"

  # 최신 원격 main 기준으로 분기 — 로컬 main은 다른 task 머지 뒤 낡아 있을 수
  # 있어, 그대로 쓰면 새 워크트리에 직전 증분이 빠지고 수동 rebase를 부른다.
  git -C "$root" fetch origin --quiet 2>/dev/null || info "fetch 실패(오프라인?) — 로컬 main 기준으로 분기"
  local base; base="$(main_ref "$root")"
  if [ -n "$new_task_contract" ]; then
    info "브랜치 $branch → $dir (base: $base)" >&2
    git -C "$root" worktree add -q -b "$branch" "$dir" "$base"
  else
    info "브랜치 $branch → $dir (base: $base)"
    git -C "$root" worktree add -b "$branch" "$dir" "$base"
  fi

  # task/ 스캐폴드
  mkdir -p \
    "$dir/task/docs/researches" \
    "$dir/task/docs/plans" \
    "$dir/task/docs/decisions" \
    "$dir/task/docs/lessons" \
    "$dir/task/docs/runbooks" \
    "$dir/task/codebases"

  # WHITE_PAPER.md — 이슈 원문 보존 (immutable)
  if [ -n "$title" ]; then
    cat > "$dir/task/WHITE_PAPER.md" <<EOF
# $title

> source: $issue_src (원문 보존 — 수정하지 않는다)

$body
EOF
  else
    cat > "$dir/task/WHITE_PAPER.md" <<EOF
# (이슈 제목 미조회)

> source: $issue_src (원문 보존 — 수정하지 않는다)

(이슈 본문을 여기에 붙여넣는다)
EOF
  fi

  cat > "$dir/task/index.md" <<EOF
---
id: $id
issue: $ISSUE
home: $HOME_REPO
parent: $parent
slug: $slug
branch: $branch
claim_id: $claim_id
${new_task_contract:+task_contract: $new_task_contract}
${authority_descriptor_digest:+workspace_authority_descriptor_digest: $authority_descriptor_digest}
---

# $id — $slug

(티켓 요약과 이 task의 목적을 여기에 적는다 — /task-start 가 채운다)

## Repos

<!-- repos:begin -->
<!-- repos:end -->
EOF
  cat > "$dir/task/status.md" <<EOF
# Status

상태: 시작됨 ($(date +%Y-%m-%d))

(작업을 멈출 때마다 이 파일 전체를 현재 상태로 덮어쓴다)
EOF
  cat > "$dir/task/log.md" <<EOF
# Log

## [$(date '+%Y-%m-%d %H:%M:%S')] plan · create task | task 시작

$id 에서 task 생성.
EOF

  # AGENTS.md — 정본 템플릿에서 인스턴스화 (templates/ 는 워크트리 루트)
  local agents_tmpl="$dir/templates/task-AGENTS.md"
  if [ -f "$agents_tmpl" ]; then
    cp "$agents_tmpl" "$dir/task/AGENTS.md"
  else
    cat > "$dir/task/AGENTS.md" <<'EOF'
# AGENTS.md

이 task 안에서 일하는 법. 독립 문서다(루트 AGENTS.md를 상속하지 않는다).

(templates/task-AGENTS.md 템플릿을 찾지 못했다 — 수동으로 채울 것)
EOF
  fi
  ln -s AGENTS.md "$dir/task/CLAUDE.md"

  # docs/ 장르 카탈로그 stub (harvest 장르엔 형식 명세 포인터)
  for genre in researches plans decisions lessons runbooks; do
    genre_cap="$(echo "$genre" | awk '{print toupper(substr($0,1,1)) substr($0,2)}')"
    case "$genre" in
      decisions) tmpl_hint='<!-- 새 항목 형식: templates/decision.tmpl.md (task/AGENTS.md 참조) -->' ;;
      lessons)   tmpl_hint='<!-- 새 항목 형식: templates/lesson.tmpl.md (task/AGENTS.md 참조) -->' ;;
      runbooks)  tmpl_hint='<!-- 새 항목 형식: templates/runbook.tmpl.md (task/AGENTS.md 참조) -->' ;;
      *)         tmpl_hint='' ;;
    esac
    cat > "$dir/task/docs/$genre/index.md" <<EOF
# $genre_cap
$tmpl_hint

(카탈로그 — 항목 추가 시 갱신)
EOF
  done
  cat > "$dir/task/docs/index.md" <<EOF
# Docs

(카탈로그 — 항목 추가 시 갱신)

## 장르

- [researches/](researches/index.md)
- [plans/](plans/index.md)
- [decisions/](decisions/index.md)
- [lessons/](lessons/index.md)
- [runbooks/](runbooks/index.md)
EOF

  git -C "$dir" add task && git -C "$dir" commit -q -m "task($id): 스캐폴드"

  # codebase 이슈면 홈 repo 작업 사본 자동 추가
  if [ -n "$HOME_REPO" ] && [ -z "$new_task_contract" ]; then
    (cd "$dir" && cmd_add_repo "$HOME_REPO")
  fi

  if [ -n "$new_task_contract" ]; then info "push: $branch" >&2; else info "push: $branch"; fi
  if { [ -n "$new_task_contract" ] && git -C "$dir" push -q -u origin "$branch"; } \
    || { [ -z "$new_task_contract" ] && git -C "$dir" push -u origin "$branch"; }; then
    lifecycle_emit_optional "$root" "$HOME_REPO" "$ISSUE" task-active "$claim_id" "$branch"
  else
    lifecycle_emit "$root" "$HOME_REPO" "$ISSUE" task-claim-conflict "$claim_id" "$branch"
    die "task branch push 실패: $branch"
  fi

  if [ -n "$new_task_contract" ]; then
    info "완료. cd $dir" >&2
    print_task_start_json "$dir" true
  else
    info "완료. cd $dir"
  fi
}

# ── add-repo ──────────────────────────────────────────────────────────

cmd_add_repo_v1() {
  local name="" ref="" role="work"
  while [ $# -gt 0 ]; do
    case "$1" in
      --ref)  ref="$2"; shift 2 ;;
      --role) role="$2"; shift 2 ;;
      *) name="$1"; shift ;;
    esac
  done
  [ -n "$name" ] || die "usage: workbench task add-repo <name> [--ref <base>] [--role work|reference]"
  validate_home_name "$name" || die "invalid codebase home: $name"
  require_task_worktree
  [ -f "$TASK_DIR/task/index.md" ] || die "task/index.md 없음"

  local root clone issue parent slug
  root="$(wb_root)"
  clone="$root/.codebases/$name"
  [ -d "$clone/.git" ] || die ".codebases/$name 없음 — codebases.yaml에 추가 후 workbench setup 실행"

  if repos_block | grep -q "^- $name |"; then
    info "$name 은 이미 등록됨"; return 0
  fi

  issue="$(index_get issue)"; parent="$(index_get parent)"; slug="$(index_get slug)"
  validate_slug "$slug" || die "invalid task slug: $slug"
  local cb_branch="task/${parent:+$parent/}${issue}-${slug}"
  local wt="$TASK_DIR/task/codebases/$name"
  [ -n "$ref" ] || ref="$(git -C "$clone" symbolic-ref --short HEAD)"

  info "codebase $name: $cb_branch (base: $ref) → task/codebases/$name"
  if git -C "$clone" show-ref -q "refs/heads/$cb_branch"; then
    git -C "$clone" worktree add "$wt" "$cb_branch"
  else
    git -C "$clone" worktree add -b "$cb_branch" "$wt" "$ref"
  fi

  repos_append "- $name | $cb_branch | $role"
  git -C "$TASK_DIR" add task/index.md
  git -C "$TASK_DIR" commit -q -m "task: add-repo $name ($role)"
}

WRITER_COORDINATION_REF=refs/heads/workbench-coordination/writer-claims
WRITER_CONTEXT_UNION_FILE=""
WRITER_CONTEXT_UNION_ROOT=""

canonical_workspace_origin_url() {
  local root="$1" url
  url="$(git -C "$root" remote get-url origin 2>/dev/null)" || return 1
  [ -n "$url" ] || return 1
  printf '%s\n' "$url"
}

writer_claim_dir() { printf '%s/writer-claims\n' "$(task_state_dir)"; }

mint_writer_claim_id() {
  printf 'wc_%s_%s_%s\n' "$(date -u +%Y%m%dT%H%M%SZ)" "$$" "${RANDOM:-0}"
}

write_writer_claim_record() {
  local file="$1" claim_id="$2" owner="$3" task_claim_id="$4" branch="$5" context_digest="$6"
  local status="$7" action_instance_id="${8:-}" coordination_revision="${9:-}" tmp
  tmp="$file.tmp.$$"
  {
    printf 'claim_id=%s\n' "$claim_id"; printf 'owner=%s\n' "$owner"
    printf 'task_claim_id=%s\n' "$task_claim_id"; printf 'branch=%s\n' "$branch"
    printf 'context_policy_set_digest=%s\n' "$context_digest"; printf 'status=%s\n' "$status"
    printf 'action_instance_id=%s\n' "$action_instance_id"
    printf 'coordination_revision=%s\n' "$coordination_revision"
  } > "$tmp" && mv "$tmp" "$file"
}

writer_remote_oid() {
  local origin_url="$1" rows count oid
  rows="$(git ls-remote --refs "$origin_url" "$WRITER_COORDINATION_REF" 2>/dev/null)" || return 1
  count="$(printf '%s\n' "$rows" | sed '/^$/d' | wc -l | tr -d ' ')"
  [ "$count" -le 1 ] || return 1
  [ "$count" -eq 1 ] || return 0
  oid="${rows%%[[:space:]]*}"
  printf '%s' "$oid" | grep -Eq '^[0-9a-f]{40}([0-9a-f]{24})?$' || return 1
  printf '%s\n' "$oid"
}

writer_coordination_common_dir() {
  local root="$1" common
  common="$(git -C "$root" rev-parse --git-common-dir)" || return 1
  common="$(cd "$root" && cd "$common" && pwd -P)" || return 1
  printf '%s\n' "$common"
}

writer_coordination_anchor_file() {
  local common
  common="$(writer_coordination_common_dir "$1")" || return 1
  printf '%s/workbench-v2/writer-coordination-anchor\n' "$common"
}

writer_record_coordination_anchor() {
  local root="$1" oid="$2" common
  common="$(writer_coordination_common_dir "$root")" || return 1
  python3 "$(writer_helper)" coordination-anchor-write --common-dir "$common" \
    --repository "$root" --oid "$oid" >/dev/null 2>&1
}

writer_read_coordination_anchor() {
  local common
  common="$(writer_coordination_common_dir "$1")" || return 1
  python3 "$(writer_helper)" coordination-anchor-read --common-dir "$common" \
    2>/dev/null
}

writer_history_anchor_args() {
  local root="$1" operation parsed anchor
  WRITER_HISTORY_ANCHOR_ARGS=()
  WRITER_HISTORY_ANCHOR_COUNT=0
  anchor="$(writer_read_coordination_anchor "$root")" || return 1
  if [ -n "$anchor" ]; then
    WRITER_HISTORY_ANCHOR_ARGS+=(--anchor "$anchor")
    WRITER_HISTORY_ANCHOR_COUNT=$((WRITER_HISTORY_ANCHOR_COUNT + 1))
  fi
  while IFS= read -r operation; do
    [ -f "$operation" ] || continue
    parsed="$(python3 "$(writer_helper)" operation "$operation" --format shell)" || return 1
    anchor="$(printf '%s\n' "$parsed" | sed -n 's/^coordination_oid=//p')"
    if [ -n "$anchor" ]; then
      WRITER_HISTORY_ANCHOR_ARGS+=(--anchor "$anchor")
      WRITER_HISTORY_ANCHOR_COUNT=$((WRITER_HISTORY_ANCHOR_COUNT + 1))
    fi
  done < <(find "$root/.worktrees" \
    -path '*/task/.workbench/writer-operations/*.json' -type f 2>/dev/null | sort)
}

writer_load_remote_ledger() {
  local root="$1" origin_url="$2" output="$3" oid
  writer_history_anchor_args "$root" || return 1
  oid="$(writer_remote_oid "$origin_url")" || return 1
  if [ -z "$oid" ]; then
    [ "$WRITER_HISTORY_ANCHOR_COUNT" -eq 0 ] || return 1
    printf 'workbench-writer-claims/v1\n' > "$output"
    WRITER_OBSERVED_OID=""
    return 0
  fi
  git -C "$root" fetch --no-write-fetch-head --quiet --no-tags "$origin_url" "$oid" \
    >/dev/null 2>&1 || return 1
  if [ "$WRITER_HISTORY_ANCHOR_COUNT" -gt 0 ]; then
    python3 "$(writer_helper)" coordination-history --repository "$root" \
      --tip "$oid" --output "$output" "${WRITER_HISTORY_ANCHOR_ARGS[@]}" \
      >/dev/null 2>&1 || return 1
  else
    python3 "$(writer_helper)" coordination-history --repository "$root" \
      --tip "$oid" --output "$output" >/dev/null 2>&1 || return 1
  fi
  writer_record_coordination_anchor "$root" "$oid" || return 1
  WRITER_OBSERVED_OID="$oid"
}

writer_create_coordination_commit() {
  local root="$1" ledger="$2" parent="$3" blob tree commit
  blob="$(git -C "$root" hash-object -w "$ledger")" || return 1
  tree="$(printf '100644 blob %s\twriter-claims.tsv\n' "$blob" | git -C "$root" mktree)" || return 1
  if [ -n "$parent" ]; then
    commit="$(printf 'workbench: append writer claim event\n' | git -C "$root" commit-tree "$tree" -p "$parent")" || return 1
  else
    commit="$(printf 'workbench: initialize writer claim ledger\n' | git -C "$root" commit-tree "$tree")" || return 1
  fi
  printf '%s\n' "$commit"
}

writer_push_cas() {
  local root="$1" origin_url="$2" observed="$3" commit="$4"
  if [ -n "$observed" ]; then
    git -C "$root" push --quiet --force-with-lease="$WRITER_COORDINATION_REF:$observed" \
      "$origin_url" "$commit:$WRITER_COORDINATION_REF" >/dev/null 2>&1
  else
    git -C "$root" push --quiet --force-with-lease="$WRITER_COORDINATION_REF:" \
      "$origin_url" "$commit:$WRITER_COORDINATION_REF" >/dev/null 2>&1
  fi
}

writer_load_claim_state() {
  local ledger="$1" record="$2" helper output line key value
  helper="$(cleanup_contract_helper)"
  output="$(python3 "$helper" writer-ledger-state "$ledger" \
    --claim-id "$(record_get "$record" claim_id)" --owner "$(record_get "$record" owner)" \
    --task-claim-id "$(record_get "$record" task_claim_id)" --branch "$(record_get "$record" branch)" \
    --context-policy-set-digest "$(record_get "$record" context_policy_set_digest)")" || return 1
  WRITER_CLAIM_STATE=""; WRITER_CONFLICT_REVISION=""; WRITER_CONFLICT_COUNT=0
  WRITER_CONFLICT_CLAIMS=(); WRITER_CONFLICT_TASKS=(); WRITER_CONFLICT_BRANCHES=(); WRITER_CONFLICT_DIGESTS=()
  while IFS= read -r line; do
    case "$line" in
      claim_state=*) WRITER_CLAIM_STATE="${line#claim_state=}" ;;
      conflict_revision=*) WRITER_CONFLICT_REVISION="${line#conflict_revision=}" ;;
      conflict=*)
        IFS=$'\t' read -r value key WRITER_CONFLICT_BRANCHES[$WRITER_CONFLICT_COUNT] \
          WRITER_CONFLICT_DIGESTS[$WRITER_CONFLICT_COUNT] <<< "${line#conflict=}"
        WRITER_CONFLICT_CLAIMS[$WRITER_CONFLICT_COUNT]="$value"
        WRITER_CONFLICT_TASKS[$WRITER_CONFLICT_COUNT]="$key"
        WRITER_CONFLICT_COUNT=$((WRITER_CONFLICT_COUNT + 1))
        ;;
    esac
  done <<< "$output"
  [ -n "$WRITER_CLAIM_STATE" ] && [ -n "$WRITER_CONFLICT_REVISION" ]
}

print_writer_claim_json() {
  local changed="$1" coordination_revision="$2" action_instance_id="$3" blocker="${4:-}" i
  printf '{"contract_version":"workbench-writer-claim/v1","task_contract":"workbench-task/v2","owner":"%s","claim_id":' \
    "$(json_escape "$WRITER_OWNER")"
  json_nullable "$WRITER_CLAIM_ID"; printf ',"task_claim_id":"%s","role":"%s","conflicts":[' \
    "$(json_escape "$WRITER_TASK_CLAIM_ID")" "$WRITER_ROLE"
  for ((i=0; i<WRITER_CONFLICT_COUNT; i++)); do
    [ "$i" -eq 0 ] || printf ','
    printf '{"claim_id":"%s","task_claim_id":"%s","branch":"%s","context_policy_set_digest":"%s"}' \
      "$(json_escape "${WRITER_CONFLICT_CLAIMS[$i]}")" "$(json_escape "${WRITER_CONFLICT_TASKS[$i]}")" \
      "$(json_escape "${WRITER_CONFLICT_BRANCHES[$i]}")" "${WRITER_CONFLICT_DIGESTS[$i]}"
  done
  printf '],"changed":%s,"coordination_ref":"%s","coordination_revision":' "$changed" "$WRITER_COORDINATION_REF"
  json_nullable "$coordination_revision"; printf ',"action_instance_id":'; json_nullable "$action_instance_id"
  printf ',"blockers":['
  if [ -n "$blocker" ]; then printf '{"code":"%s","ref":"%s"}' "$blocker" "$WRITER_COORDINATION_REF"; fi
  printf ']}\n'
}

writer_append_release() {
  local root="$1" origin_url="$2" claim_id="$3" attempt ledger next commit observed helper claim_data state
  helper="$(cleanup_contract_helper)"
  for ((attempt=1; attempt<=8; attempt++)); do
    ledger="$(mktemp "${TMPDIR:-/tmp}/workbench-writer-ledger.XXXXXX")"
    next="$(mktemp "${TMPDIR:-/tmp}/workbench-writer-next.XXXXXX")"
    if ! writer_load_remote_ledger "$root" "$origin_url" "$ledger"; then rm -f "$ledger" "$next"; return 1; fi
    observed="$WRITER_OBSERVED_OID"
    if ! claim_data="$(python3 "$helper" writer-ledger-claim "$ledger" --claim-id "$claim_id")"; then
      rm -f "$ledger" "$next"; return 1
    fi
    state="$(printf '%s\n' "$claim_data" | sed -n 's/^state=//p')"
    if [ "$state" = released ]; then
      WRITER_COORDINATION_REVISION="$observed"; rm -f "$ledger" "$next"; return 0
    fi
    if ! python3 "$helper" writer-ledger-append "$ledger" --output "$next" \
      --state released --claim-id "$claim_id"; then rm -f "$ledger" "$next"; return 1; fi
    commit="$(writer_create_coordination_commit "$root" "$next" "$observed")" \
      || { rm -f "$ledger" "$next"; return 1; }
    if writer_push_cas "$root" "$origin_url" "$observed" "$commit"; then
      rm -f "$ledger" "$next"
      ledger="$(mktemp "${TMPDIR:-/tmp}/workbench-writer-ledger.XXXXXX")"
      if writer_load_remote_ledger "$root" "$origin_url" "$ledger" \
        && claim_data="$(python3 "$helper" writer-ledger-claim "$ledger" --claim-id "$claim_id")" \
        && [ "$(printf '%s\n' "$claim_data" | sed -n 's/^state=//p')" = released ]; then
        WRITER_COORDINATION_REVISION="$WRITER_OBSERVED_OID"; rm -f "$ledger"; return 0
      fi
      rm -f "$ledger"; return 1
    fi
    rm -f "$ledger" "$next"
  done
  return 1
}

writer_local_attach() {
  local clone="$1" wt="$2" cb_branch="$3" ref="$4"
  if git -C "$clone" show-ref -q "refs/heads/$cb_branch"; then
    git -C "$clone" worktree add "$wt" "$cb_branch"
  else
    git -C "$clone" worktree add -b "$cb_branch" "$wt" "$ref"
  fi
}

cmd_add_repo_v2_work() {
  local name="$1" ref="$2" instance_id="$3" authorization_file="$4"
  local root clone issue parent slug cb_branch wt record state context_state context_digest origin_url
  local attempt ledger next observed latest_oid commit current_instance="$instance_id" current_auth="$authorization_file"
  local last_revision="" action_id="" coordination_revision="" helper
  helper="$(cleanup_contract_helper)"; root="$(wb_root)"; clone="$root/.codebases/$name"
  [ -d "$clone/.git" ] || die ".codebases/$name 없음 — codebases.yaml에 추가 후 workbench setup 실행"
  current_task_identity; WRITER_OWNER="$name"; WRITER_ROLE=work; WRITER_TASK_CLAIM_ID="$CURRENT_CLAIM_ID"
  context_state="$(task_state_dir)/policy-context/state.record"
  if [ ! -f "$context_state" ] || [ "$(record_get "$context_state" sealed)" != true ]; then
    printf '{"contract_version":"workbench-error/v1","operation":"task.add-repo","blockers":[{"code":"policy-context-unsealed","ref":"workbench:task/%s"}]}\n' \
      "$(json_escape "$CURRENT_CLAIM_ID")"
    return 1
  fi
  context_digest="$(record_get "$context_state" digest)"
  printf '%s' "$context_digest" | grep -Eq '^sha256:[0-9a-f]{64}$' || return 1
  issue="$(index_get issue)"; parent="$(index_get parent)"; slug="$(index_get slug)"
  cb_branch="task/${parent:+$parent/}${issue}-${slug}"; wt="$TASK_DIR/task/codebases/$name"
  [ -n "$ref" ] || ref="$(git -C "$clone" symbolic-ref --short HEAD)"
  mkdir -p "$(writer_claim_dir)"; record="$(writer_claim_dir)/$name.record"

  if [ -f "$record" ]; then
    state="$(record_get "$record" status)"
    WRITER_CLAIM_ID="$(record_get "$record" claim_id)"
    if [ "$state" = release-pending ]; then
      origin_url="$(canonical_workspace_origin_url "$root")" || { print_writer_claim_json false "" "" writer-lock-unavailable; return 1; }
      if ! writer_append_release "$root" "$origin_url" "$WRITER_CLAIM_ID"; then
        print_writer_claim_json false "" "" writer-lock-unavailable; return 1
      fi
      write_writer_claim_record "$record" "$WRITER_CLAIM_ID" "$name" "$CURRENT_CLAIM_ID" "$CURRENT_BRANCH" \
        "$context_digest" released "$(record_get "$record" action_instance_id)" "$WRITER_COORDINATION_REVISION"
      state=released
    fi
    if [ "$state" = active ] && repos_block | grep -q "^- $name |" && [ -d "$wt" ]; then
      origin_url="$(canonical_workspace_origin_url "$root")" || { print_writer_claim_json false "" "" writer-lock-unavailable; return 1; }
      ledger="$(mktemp "${TMPDIR:-/tmp}/workbench-writer-ledger.XXXXXX")"
      if writer_load_remote_ledger "$root" "$origin_url" "$ledger" && writer_load_claim_state "$ledger" "$record" \
        && [ "$WRITER_CLAIM_STATE" = active ]; then
        coordination_revision="$WRITER_OBSERVED_OID"; action_id="$(record_get "$record" action_instance_id)"
        rm -f "$ledger"; print_writer_claim_json false "$coordination_revision" "$action_id"; return 0
      fi
      rm -f "$ledger"; print_writer_claim_json false "" "" writer-lock-unavailable; return 1
    fi
  fi
  if [ ! -f "$record" ] || [ "$(record_get "$record" status)" = released ]; then
    WRITER_CLAIM_ID="$(mint_writer_claim_id)"
    write_writer_claim_record "$record" "$WRITER_CLAIM_ID" "$name" "$CURRENT_CLAIM_ID" "$CURRENT_BRANCH" \
      "$context_digest" pending
  else
    WRITER_CLAIM_ID="$(record_get "$record" claim_id)"
  fi
  origin_url="$(canonical_workspace_origin_url "$root")" \
    || { print_writer_claim_json false "" "" writer-lock-unavailable; return 1; }

  for ((attempt=1; attempt<=8; attempt++)); do
    ledger="$(mktemp "${TMPDIR:-/tmp}/workbench-writer-ledger.XXXXXX")"
    next="$(mktemp "${TMPDIR:-/tmp}/workbench-writer-next.XXXXXX")"
    if ! writer_load_remote_ledger "$root" "$origin_url" "$ledger" \
      || ! writer_load_claim_state "$ledger" "$record"; then
      rm -f "$ledger" "$next"; print_writer_claim_json false "" "$action_id" writer-lock-unavailable; return 1
    fi
    observed="$WRITER_OBSERVED_OID"
    if [ "$WRITER_CLAIM_STATE" = released ]; then
      write_writer_claim_record "$record" "$WRITER_CLAIM_ID" "$name" "$CURRENT_CLAIM_ID" "$CURRENT_BRANCH" \
        "$context_digest" released "$action_id" "$observed"
      rm -f "$ledger" "$next"; return 1
    fi
    action_id=""
    if [ "$WRITER_CONFLICT_COUNT" -gt 0 ]; then
      if [ -n "$last_revision" ] && [ "$last_revision" != "$WRITER_CONFLICT_REVISION" ]; then
        current_instance=""; current_auth=""
      fi
      resolve_governed_action task.concurrent-write "workbench:codebase/$name" "$WRITER_CONFLICT_REVISION" \
        "$current_instance" "$current_auth"
      case "$GOVERNED_POLICY_RC" in
        0) action_id="$GOVERNED_ACTION_INSTANCE_ID" ;;
        3|4) rm -f "$ledger" "$next"; printf '%s\n' "$GOVERNED_POLICY_OUTPUT"; return "$GOVERNED_POLICY_RC" ;;
        *) rm -f "$ledger" "$next"; return "$GOVERNED_POLICY_RC" ;;
      esac
    fi
    last_revision="$WRITER_CONFLICT_REVISION"
    latest_oid="$(writer_remote_oid "$origin_url")" \
      || { rm -f "$ledger" "$next"; print_writer_claim_json false "" "$action_id" writer-lock-unavailable; return 1; }
    if [ "$latest_oid" != "$observed" ]; then rm -f "$ledger" "$next"; continue; fi
    if [ "$WRITER_CLAIM_STATE" = absent ]; then
      if ! python3 "$helper" writer-ledger-append "$ledger" --output "$next" --state active \
        --claim-id "$WRITER_CLAIM_ID" --owner "$name" --task-claim-id "$CURRENT_CLAIM_ID" \
        --branch "$CURRENT_BRANCH" --context-policy-set-digest "$context_digest"; then
        rm -f "$ledger" "$next"; print_writer_claim_json false "" "$action_id" writer-lock-unavailable; return 1
      fi
      commit="$(writer_create_coordination_commit "$root" "$next" "$observed")" \
        || { rm -f "$ledger" "$next"; print_writer_claim_json false "" "$action_id" writer-lock-unavailable; return 1; }
      if ! writer_push_cas "$root" "$origin_url" "$observed" "$commit"; then rm -f "$ledger" "$next"; continue; fi
    fi
    rm -f "$ledger" "$next"
    ledger="$(mktemp "${TMPDIR:-/tmp}/workbench-writer-ledger.XXXXXX")"
    if ! writer_load_remote_ledger "$root" "$origin_url" "$ledger" \
      || ! writer_load_claim_state "$ledger" "$record" || [ "$WRITER_CLAIM_STATE" != active ]; then
      rm -f "$ledger"; print_writer_claim_json false "" "$action_id" writer-lock-unavailable; return 1
    fi
    coordination_revision="$WRITER_OBSERVED_OID"; rm -f "$ledger"
    if ! writer_local_attach "$clone" "$wt" "$cb_branch" "$ref" >/dev/null 2>&1; then
      write_writer_claim_record "$record" "$WRITER_CLAIM_ID" "$name" "$CURRENT_CLAIM_ID" "$CURRENT_BRANCH" \
        "$context_digest" release-pending "$action_id" "$coordination_revision"
      if writer_append_release "$root" "$origin_url" "$WRITER_CLAIM_ID"; then
        write_writer_claim_record "$record" "$WRITER_CLAIM_ID" "$name" "$CURRENT_CLAIM_ID" "$CURRENT_BRANCH" \
          "$context_digest" released "$action_id" "$WRITER_COORDINATION_REVISION"
      fi
      print_writer_claim_json false "${WRITER_COORDINATION_REVISION:-$coordination_revision}" "$action_id" writer-lock-unavailable
      return 1
    fi
    repos_append "- $name | $cb_branch | work"
    write_writer_claim_record "$record" "$WRITER_CLAIM_ID" "$name" "$CURRENT_CLAIM_ID" "$CURRENT_BRANCH" \
      "$context_digest" active "$action_id" "$coordination_revision"
    if [ -n "$action_id" ]; then
      if ! consume_governed_action task.concurrent-write "workbench:codebase/$name" "$WRITER_CONFLICT_REVISION" "$action_id"; then
        git -C "$clone" worktree remove --force "$wt" >/dev/null 2>&1 || true
        writer_append_release "$root" "$origin_url" "$WRITER_CLAIM_ID" || true
        print_writer_claim_json false "$coordination_revision" "$action_id" writer-lock-unavailable; return 1
      fi
    fi
    git -C "$TASK_DIR" add task/index.md "task/.workbench/writer-claims/$name.record" task/.workbench/actions 2>/dev/null || \
      git -C "$TASK_DIR" add task/index.md "task/.workbench/writer-claims/$name.record"
    git -C "$TASK_DIR" commit -q -m "task: add-repo $name (work)"
    print_writer_claim_json true "$coordination_revision" "$action_id"; return 0
  done
  print_writer_claim_json false "" "$action_id" writer-lock-unavailable; return 1
}

# Final v2 writer engine. The older claim-record implementation above remains only as a
# migration reader until existing workbenches have no provisional records left.
writer_json_query() {
  local json="$1" path="$2"
  printf '%s\n' "$json" | python3 -c '
import json, sys
value = json.load(sys.stdin)
for part in sys.argv[1].split("."):
    value = value[int(part)] if isinstance(value, list) else value[part]
if value is None:
    print("")
elif isinstance(value, bool):
    print(str(value).lower())
elif isinstance(value, (dict, list)):
    print(json.dumps(value, separators=(",", ":")))
else:
    print(value)
' "$path"
}

mint_writer_operation_id() { printf 'wop_%s_%s_%s\n' "$(date -u +%Y%m%dT%H%M%SZ)" "$$" "${RANDOM:-0}"; }

writer_runtime_identity() {
  local root="$1" common dir seed tmp
  common="$(git -C "$root" rev-parse --git-common-dir)"
  common="$(cd "$root" && cd "$common" && pwd)"; dir="$common/workbench-v2"
  mkdir -p "$dir"
  if [ ! -f "$dir/device-id" ]; then
    seed="$(hostname 2>/dev/null || printf local)@$common"
    tmp="$dir/device-id.tmp.$$.$RANDOM"
    printf 'device:local/%s\n' "$(printf '%s' "$seed" | shasum -a 256 | awk '{print substr($1,1,24)}')" \
      > "$tmp"
    ln "$tmp" "$dir/device-id" 2>/dev/null || true
    rm -f "$tmp"
  fi
  if [ ! -f "$dir/clone-id" ]; then
    tmp="$dir/clone-id.tmp.$$.$RANDOM"
    python3 -c 'import uuid; print(uuid.uuid4())' > "$tmp"
    ln "$tmp" "$dir/clone-id" 2>/dev/null || true
    rm -f "$tmp"
  fi
  WRITER_DEVICE_ID="$(cat "$dir/device-id")"; WRITER_CLONE_ID="$(cat "$dir/clone-id")"
  require_single_line device_id "$WRITER_DEVICE_ID"; require_single_line clone_id "$WRITER_CLONE_ID"
}

writer_operation_update() {
  local file="$1"; shift
  local tmp="$file.tmp.$$"
  python3 "$(writer_helper)" operation-update "$file" --output "$tmp" "$@" \
    && mv "$tmp" "$file"
}

writer_load_operation_final() {
  local file="$1" output line key value
  output="$(python3 "$(writer_helper)" operation "$file" --format shell)" || return 1
  WRITER_OPERATION_ID=""; WRITER_CLAIM_ID=""; WRITER_OPERATION_STAGE=""
  WRITER_OPERATION_TASK_CLAIM_ID=""; WRITER_OPERATION_EXPECTED_PATH=""
  WRITER_OPERATION_ACTION=""; WRITER_OPERATION_INTENT=""; WRITER_OPERATION_MANIFEST=""
  WRITER_OPERATION_AUTHORIZATION=""; WRITER_OPERATION_COORDINATION_OID=""
  WRITER_OPERATION_EFFECT_OWNER_STATE=""
  WRITER_OPERATION_WORKTREE_OWNERSHIP=""; WRITER_OPERATION_RECORD_OWNERSHIP=""
  WRITER_OPERATION_WORKTREE_SET_DIGEST=""
  WRITER_OPERATION_REGISTRY_REVISION=""; WRITER_OPERATION_REGISTRY_DIGEST=""
  WRITER_OWNER=""; WRITER_CODEBASE_BRANCH=""; WRITER_CODEBASE_ORIGIN=""
  WRITER_CONTEXT_DIGEST=""; WRITER_DEVICE_ID=""; WRITER_CLONE_ID=""
  while IFS= read -r line; do
    key="${line%%=*}"; value="${line#*=}"
    case "$key" in
      operation_id) WRITER_OPERATION_ID="$value" ;; claim_id) WRITER_CLAIM_ID="$value" ;;
      task_claim_id) WRITER_OPERATION_TASK_CLAIM_ID="$value" ;;
      owner) WRITER_OWNER="$value" ;; branch) WRITER_CODEBASE_BRANCH="$value" ;;
      expected_path) WRITER_OPERATION_EXPECTED_PATH="$value" ;;
      codebase_origin_url) WRITER_CODEBASE_ORIGIN="$value" ;;
      registry_revision) WRITER_OPERATION_REGISTRY_REVISION="$value" ;;
      registry_digest) WRITER_OPERATION_REGISTRY_DIGEST="$value" ;;
      context_policy_set_digest) WRITER_CONTEXT_DIGEST="$value" ;;
      device_id) WRITER_DEVICE_ID="$value" ;; clone_id) WRITER_CLONE_ID="$value" ;;
      stage) WRITER_OPERATION_STAGE="$value" ;; action_instance_id) WRITER_OPERATION_ACTION="$value" ;;
      intent_digest) WRITER_OPERATION_INTENT="$value" ;; policy_manifest) WRITER_OPERATION_POLICY_JSON="$value" ;;
      authorization_ref) WRITER_OPERATION_AUTHORIZATION="$value" ;;
      effect_owner_state) WRITER_OPERATION_EFFECT_OWNER_STATE="$value" ;;
      coordination_oid) WRITER_OPERATION_COORDINATION_OID="$value" ;;
      worktree_ownership) WRITER_OPERATION_WORKTREE_OWNERSHIP="$value" ;;
      repo_record_ownership) WRITER_OPERATION_RECORD_OWNERSHIP="$value" ;;
      worktree_set_digest) WRITER_OPERATION_WORKTREE_SET_DIGEST="$value" ;;
    esac
  done <<< "$output"
  if [ -n "${WRITER_OPERATION_POLICY_JSON:-}" ]; then
    WRITER_OPERATION_MANIFEST="$(printf '%s\n' "$WRITER_OPERATION_POLICY_JSON" | \
      python3 -c 'import json,sys; print(json.load(sys.stdin)["digest"])')"
  fi
  [ -n "$WRITER_OPERATION_ID" ] && [ -n "$WRITER_CLAIM_ID" ] && [ -n "$WRITER_OPERATION_STAGE" ]
}

writer_find_operation_for_owner() {
  local owner="$1" file found="" parsed stage
  for file in "$(writer_operation_dir)"/*.json; do
    [ -f "$file" ] || continue
    parsed="$(python3 "$(writer_helper)" operation "$file" --format shell)" || return 2
    [ "$(printf '%s\n' "$parsed" | sed -n 's/^owner=//p')" = "$owner" ] || continue
    stage="$(printf '%s\n' "$parsed" | sed -n 's/^stage=//p')"
    case "$stage" in cancelled|released) continue ;; esac
    [ -z "$found" ] || return 2
    found="$file"
  done
  [ -z "$found" ] || printf '%s\n' "$found"
}

writer_conflict_final() {
  local ledger="$1" operation="$2" inventory output legacy_util root
  inventory="$(mktemp "${TMPDIR:-/tmp}/workbench-legacy-inventory.XXXXXX")"
  legacy_util="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/legacy-inventory"
  root="$(wb_root)"
  (cd "$root" && "$legacy_util" show --format json) > "$inventory" 2>/dev/null \
    || { rm -f "$inventory"; return 1; }
  output="$(python3 "$(writer_helper)" conflict --ledger-file "$ledger" \
    --operation-file "$operation" --legacy-inventory-file "$inventory")" \
    || { rm -f "$inventory"; return 1; }
  rm -f "$inventory"
  WRITER_CONFLICT_REVISION="$(writer_json_query "$output" revision)"
  WRITER_CONFLICTS_JSON="$(writer_json_query "$output" conflicts)"
  WRITER_CONFLICT_COUNT="$(printf '%s\n' "$WRITER_CONFLICTS_JSON" | python3 -c 'import json,sys; print(len(json.load(sys.stdin)))')"
}

writer_conflict_has_legacy() {
  printf '%s\n' "${WRITER_CONFLICTS_JSON:-[]}" | python3 -c '
import json, sys
raise SystemExit(0 if any(item.get("source") == "legacy-v1" for item in json.load(sys.stdin)) else 1)
'
}

writer_context_union_cleanup() {
  [ -z "${WRITER_CONTEXT_UNION_ROOT:-}" ] || rm -rf "$WRITER_CONTEXT_UNION_ROOT"
  WRITER_CONTEXT_UNION_FILE=""; WRITER_CONTEXT_UNION_ROOT=""
}

writer_remote_task_oid() {
  local origin="$1" branch="$2" ref rows count oid advertised
  ref="refs/heads/$branch"
  git check-ref-format "$ref" >/dev/null 2>&1 || return 1
  rows="$(git ls-remote --heads "$origin" "$ref" 2>/dev/null)" || return 1
  count="$(printf '%s\n' "$rows" | sed '/^$/d' | wc -l | tr -d ' ')"
  [ "$count" -eq 1 ] || return 1
  IFS=$'\t' read -r oid advertised <<EOF
$rows
EOF
  [ "$advertised" = "$ref" ] \
    && printf '%s' "$oid" | grep -Eq '^[0-9a-f]{40}([0-9a-f]{24})?$' \
    || return 1
  printf '%s\n' "$oid"
}

writer_materialize_context_snapshot() {
  local root="$1" revision="$2" destination="$3"
  command -v tar >/dev/null 2>&1 || return 1
  mkdir -p "$destination"
  git -C "$root" archive --format=tar "$revision" 2>/dev/null \
    | tar -xf - -C "$destination" >/dev/null 2>&1
}

writer_prepare_context_union() {
  local root="$1" output source claim task_claim branch digest origin descriptor oid revision revisions
  local index snapshot parsed line key value task_contract parsed_claim parsed_descriptor found count=0
  local state registration
  writer_context_union_cleanup
  WRITER_CONTEXT_UNION_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/workbench-context-union.XXXXXX")" \
    || return 1
  output="$WRITER_CONTEXT_UNION_ROOT/manifest"
  origin="$(canonical_workspace_origin_url "$root")" \
    || { writer_context_union_cleanup; return 1; }
  descriptor="$(index_get workspace_authority_descriptor_digest)"
  printf '%s' "$descriptor" | grep -Eq '^sha256:[0-9a-f]{64}$' \
    || { writer_context_union_cleanup; return 1; }
  printf 'workbench-concurrent-context-union/v1\n' > "$output"
  while IFS=$'\t' read -r source claim task_claim branch digest; do
    [ "$source" = ledger-v2 ] || continue
    oid="$(writer_remote_task_oid "$origin" "$branch")" \
      || { writer_context_union_cleanup; return 1; }
    git -C "$root" fetch --quiet --no-tags --no-write-fetch-head "$origin" "$oid" \
      >/dev/null 2>&1 || { writer_context_union_cleanup; return 1; }
    [ "$(git -C "$root" cat-file -t "$oid" 2>/dev/null)" = commit ] \
      || { writer_context_union_cleanup; return 1; }
    revisions="$(git -C "$root" rev-list --first-parent "$oid" 2>/dev/null)" \
      || { writer_context_union_cleanup; return 1; }
    [ -n "$revisions" ] || { writer_context_union_cleanup; return 1; }
    found=""
    while IFS= read -r revision; do
      [ -n "$revision" ] || continue
      git -C "$root" cat-file -e "$revision:task/index.md" 2>/dev/null || continue
      index="$WRITER_CONTEXT_UNION_ROOT/index-$count.md"
      git -C "$root" show "$revision:task/index.md" > "$index" 2>/dev/null \
        || { writer_context_union_cleanup; return 1; }
      parsed="$(python3 "$(lifecycle_helper)" task-index --file "$index" \
        --branch "$branch" --format shell 2>/dev/null)" \
        || { writer_context_union_cleanup; return 1; }
      task_contract=""; parsed_claim=""; parsed_descriptor=""
      while IFS= read -r line; do
        key="${line%%=*}"; value="${line#*=}"
        case "$key" in
          task_contract) task_contract="$value" ;;
          claim_id) parsed_claim="$value" ;;
          workspace_authority_descriptor_digest) parsed_descriptor="$value" ;;
        esac
      done <<< "$parsed"
      [ "$task_contract" = workbench-task/v2 ] \
        && [ "$parsed_claim" = "$task_claim" ] \
        && [ "$parsed_descriptor" = "$descriptor" ] \
        || { writer_context_union_cleanup; return 1; }
      snapshot="$WRITER_CONTEXT_UNION_ROOT/snapshot-$count"
      writer_materialize_context_snapshot "$root" "$revision" "$snapshot" \
        || { writer_context_union_cleanup; return 1; }
      state="$snapshot/task/.workbench/policy-context/state.record"
      registration="$snapshot/task/.workbench/policy-context/registration.json"
      [ -f "$state" ] && [ -f "$registration" ] \
        || { writer_context_union_cleanup; return 1; }
      python3 "$(contract_helper)" context-snapshot --registration-file "$registration" \
        --state-file "$state" --workspace-root "$snapshot" --task-claim-id "$task_claim" \
        --context-digest "$digest" >/dev/null 2>&1 \
        || { writer_context_union_cleanup; return 1; }
      found="$snapshot"
      break
    done <<< "$revisions"
    [ -n "$found" ] || { writer_context_union_cleanup; return 1; }
    state="$found/task/.workbench/policy-context/state.record"
    registration="$found/task/.workbench/policy-context/registration.json"
    printf 'context\t%s\t%s\t%s\t%s\n' "$task_claim" "$digest" "$found" "$registration" >> "$output"
    count=$((count + 1))
  done < <(printf '%s\n' "${WRITER_CONFLICTS_JSON:-[]}" | python3 -c '
import json, sys
for item in json.load(sys.stdin):
    if item.get("source") == "ledger-v2":
        print("{}\t{}\t{}\t{}\t{}".format(
            item["source"], item["claim_id"], item["task_claim_id"],
            item["branch"], item["context_policy_set_digest"],
        ))
')
  WRITER_CONTEXT_UNION_FILE="$output"
}

writer_publish_ledger() {
  local root="$1" origin="$2" observed="$3" next="$4" commit root_commit empty
  if [ -z "$observed" ]; then
    empty="$(mktemp "${TMPDIR:-/tmp}/workbench-writer-root.XXXXXX")" || return 1
    printf 'workbench-writer-claims/v1\n' > "$empty"
    root_commit="$(writer_create_coordination_commit "$root" "$empty" "")" \
      || { rm -f "$empty"; return 1; }
    rm -f "$empty"
    writer_push_cas "$root" "$origin" "" "$root_commit" || return 1
    writer_record_coordination_anchor "$root" "$root_commit" || return 1
    [ "${WORKBENCH_TEST_FAIL_AFTER_WRITER_ROOT:-0}" != 1 ] || return 9
    observed="$root_commit"
  fi
  commit="$(writer_create_coordination_commit "$root" "$next" "$observed")" || return 1
  writer_push_cas "$root" "$origin" "$observed" "$commit" || return 1
  writer_record_coordination_anchor "$root" "$commit"
}

writer_append_active_final() {
  local root="$1" origin="$2" operation="$3" attempt ledger next state observed
  for ((attempt=1; attempt<=8; attempt++)); do
    ledger="$(mktemp "${TMPDIR:-/tmp}/workbench-writer-ledger.XXXXXX")"
    next="$(mktemp "${TMPDIR:-/tmp}/workbench-writer-next.XXXXXX")"
    writer_load_remote_ledger "$root" "$origin" "$ledger" \
      || { rm -f "$ledger" "$next"; return 1; }
    observed="$WRITER_OBSERVED_OID"
    state="$(python3 "$(writer_helper)" ledger-state "$ledger" --operation-id "$WRITER_OPERATION_ID" \
      --claim-id "$WRITER_CLAIM_ID" --operation-file "$operation" --format shell | \
      sed -n 's/^claim_state=//p')" \
      || { rm -f "$ledger" "$next"; return 1; }
    if [ "$state" = active ]; then
      WRITER_COORDINATION_REVISION="$observed"; rm -f "$ledger" "$next"; return 0
    fi
    [ "$state" = absent ] || { rm -f "$ledger" "$next"; return 1; }
    python3 "$(writer_helper)" ledger-append-claim "$ledger" --output "$next" \
      --state active --operation-file "$operation" \
      || { rm -f "$ledger" "$next"; return 1; }
    if writer_publish_ledger "$root" "$origin" "$observed" "$next"; then
      rm -f "$ledger" "$next"
      ledger="$(mktemp "${TMPDIR:-/tmp}/workbench-writer-ledger.XXXXXX")"
      if writer_load_remote_ledger "$root" "$origin" "$ledger"; then
        state="$(python3 "$(writer_helper)" ledger-state "$ledger" --operation-id "$WRITER_OPERATION_ID" \
          --claim-id "$WRITER_CLAIM_ID" --operation-file "$operation" --format shell | \
          sed -n 's/^claim_state=//p')"
        WRITER_COORDINATION_REVISION="$WRITER_OBSERVED_OID"; rm -f "$ledger"
        [ "$state" = active ] && return 0
      else rm -f "$ledger"; fi
      return 1
    else
      state=$?
    fi
    rm -f "$ledger" "$next"
    [ "$state" -ne 9 ] || return 9
    return 3
  done
  return 1
}

mint_writer_event_id() {
  python3 -c 'import time,random; print("event_{:020d}_{:05d}".format(time.time_ns(), random.randrange(100000)))'
}

writer_effect_owner_cas() {
  local root="$1" origin="$2" desired="$3" requested_event="${4:-}"
  local operation="${5:-${WRITER_OPERATION_FILE:-}}"
  local attempt ledger next observed state device clone event reduced
  for ((attempt=1; attempt<=8; attempt++)); do
    ledger="$(mktemp "${TMPDIR:-/tmp}/workbench-writer-ledger.XXXXXX")"
    next="$(mktemp "${TMPDIR:-/tmp}/workbench-writer-next.XXXXXX")"
    writer_load_remote_ledger "$root" "$origin" "$ledger" \
      || { rm -f "$ledger" "$next"; return 1; }
    observed="$WRITER_OBSERVED_OID"
    if [ -n "$operation" ]; then
      reduced="$(python3 "$(writer_helper)" ledger-state "$ledger" \
        --operation-id "$WRITER_OPERATION_ID" --claim-id "$WRITER_CLAIM_ID" \
        --operation-file "$operation" --format shell)" \
        || { rm -f "$ledger" "$next"; return 1; }
    else
      reduced="$(python3 "$(writer_helper)" ledger-state "$ledger" \
        --operation-id "$WRITER_OPERATION_ID" --claim-id "$WRITER_CLAIM_ID" --format shell)" \
        || { rm -f "$ledger" "$next"; return 1; }
    fi
    state="$(printf '%s\n' "$reduced" | sed -n 's/^effect_owner_state=//p')"
    device="$(printf '%s\n' "$reduced" | sed -n 's/^effect_owner_device_id=//p')"
    clone="$(printf '%s\n' "$reduced" | sed -n 's/^effect_owner_clone_id=//p')"
    if [ "$desired" = acquired ] && [ "$state" = acquired ]; then
      [ "$device" = "$WRITER_DEVICE_ID" ] && [ "$clone" = "$WRITER_CLONE_ID" ] \
        || { rm -f "$ledger" "$next"; return 2; }
      WRITER_COORDINATION_REVISION="$observed"; rm -f "$ledger" "$next"; return 0
    fi
    if [ "$desired" = released ] && [ "$state" = released ]; then
      WRITER_COORDINATION_REVISION="$observed"; rm -f "$ledger" "$next"; return 0
    fi
    if [ "$desired" = acquired ]; then
      [ -z "$state" ] || [ "$state" = released ] || { rm -f "$ledger" "$next"; return 2; }
    else
      [ "$state" = acquired ] && [ "$device" = "$WRITER_DEVICE_ID" ] && [ "$clone" = "$WRITER_CLONE_ID" ] \
        || { rm -f "$ledger" "$next"; return 2; }
    fi
    event="${requested_event:-$(mint_writer_event_id)}"
    python3 "$(writer_helper)" ledger-append-effect "$ledger" --output "$next" \
      --event-id "$event" --operation-id "$WRITER_OPERATION_ID" --claim-id "$WRITER_CLAIM_ID" \
      --device-id "$WRITER_DEVICE_ID" --clone-id "$WRITER_CLONE_ID" --state "$desired" \
      || { rm -f "$ledger" "$next"; return 1; }
    if writer_publish_ledger "$root" "$origin" "$observed" "$next"; then
      rm -f "$ledger" "$next"; WRITER_COORDINATION_REVISION="$(writer_remote_oid "$origin")"; return 0
    fi
    rm -f "$ledger" "$next"
  done
  return 1
}

writer_append_release_final() {
  local root="$1" origin="$2" operation="${3:-${WRITER_OPERATION_FILE:-}}"
  local attempt ledger next observed state
  for ((attempt=1; attempt<=8; attempt++)); do
    ledger="$(mktemp "${TMPDIR:-/tmp}/workbench-writer-ledger.XXXXXX")"
    next="$(mktemp "${TMPDIR:-/tmp}/workbench-writer-next.XXXXXX")"
    writer_load_remote_ledger "$root" "$origin" "$ledger" || { rm -f "$ledger" "$next"; return 1; }
    observed="$WRITER_OBSERVED_OID"
    if [ -n "$operation" ]; then
      state="$(python3 "$(writer_helper)" ledger-state "$ledger" --operation-id "$WRITER_OPERATION_ID" \
        --claim-id "$WRITER_CLAIM_ID" --operation-file "$operation" --format shell | \
        sed -n 's/^claim_state=//p')"
    else
      state="$(python3 "$(writer_helper)" ledger-state "$ledger" --operation-id "$WRITER_OPERATION_ID" \
        --claim-id "$WRITER_CLAIM_ID" --format shell | sed -n 's/^claim_state=//p')"
    fi
    [ "$state" != released ] || { WRITER_COORDINATION_REVISION="$observed"; rm -f "$ledger" "$next"; return 0; }
    [ "$state" = active ] || { rm -f "$ledger" "$next"; return 1; }
    python3 "$(writer_helper)" ledger-append-claim "$ledger" --output "$next" --state released \
      --operation-id "$WRITER_OPERATION_ID" --claim-id "$WRITER_CLAIM_ID" \
      || { rm -f "$ledger" "$next"; return 1; }
    if writer_publish_ledger "$root" "$origin" "$observed" "$next"; then
      rm -f "$ledger" "$next"; WRITER_COORDINATION_REVISION="$(writer_remote_oid "$origin")"; return 0
    fi
    rm -f "$ledger" "$next"
  done
  return 1
}

writer_worktree_snapshot_digest() {
