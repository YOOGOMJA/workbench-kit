    state="$(record_get "$file" state)"
    printf '{"candidate_id":"%s","kind":"%s","source_ref":"%s","state":"%s","disposition":' \
      "$(json_escape "$(record_get "$file" candidate_id)")" "$(record_get "$file" kind)" \
      "$(json_escape "$(record_get "$file" source_ref)")" "$state"
    if [ "$state" = disposed ]; then
      printf '{"decision":"%s","target_ref":' "$(record_get "$file" decision)"; json_nullable "$(record_get "$file" target_ref)"
      printf ',"reason_code":"%s","reason_ref":' "$(json_escape "$(record_get "$file" reason_code)")"
